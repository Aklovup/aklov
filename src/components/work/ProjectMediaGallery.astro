---
import type { CollectionEntry } from 'astro:content';
import ProjectMedia from './ProjectMedia.astro';

interface Props { project: CollectionEntry<'projects'>; }
const { project: { data } } = Astro.props;
const media = [...data.media].sort((a, b) => a.order - b.order);
const available = media.filter((item) => item.url);
const pending = media.filter((item) => !item.url);
const preview = available.length ? undefined : pending.find((item) => item.placeholder);
const number = String(data.order).padStart(2, '0');
---

<section class="media-gallery" aria-labelledby="project-media-title">
  <div class="gallery-label">
    <h3 id="project-media-title">Project media</h3>
    <span>{String(available.length).padStart(2, '0')} / {String(media.length).padStart(2, '0')}</span>
  </div>
  {preview && <ProjectMedia cover={preview} number={number} title={data.title} presentation="detail" showCaption={false} />}
  {available.map((item) => (
    <div class="media-item">
      <ProjectMedia cover={item} number={number} title={data.title} presentation="detail" />

    </div>
  ))}
  {!!pending.length && <p class="media-status">Media pending.</p>}
  {!!pending.length && pending.some((item) => item.placeholder) && (
    <ol class="pending-media">
      {pending.map((item) => (
        <li>
          <span class="pending-type">{item.type === 'image' ? 'Image' : item.type.toUpperCase()}</span>
          <span>{item.caption || item.alt}</span>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  .gallery-label { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding-bottom: 18px; border-bottom: 1px solid var(--line); margin-bottom: 24px; }
  h3 { margin: 0; font-family: var(--display); font-size: 32px; font-weight: 400; line-height: 1.1; letter-spacing: -.02em; }
  .gallery-label > span { color: var(--gold-dark); font-size: 11px; font-variant-numeric: tabular-nums; }
  .media-item + .media-item { margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--line); }
  .media-status { margin: 20px 0 0; color: var(--body); font-size: 12px; line-height: 1.7; }
  .pending-media { list-style: none; margin: 16px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .pending-media li { display: grid; grid-template-columns: 46px minmax(0, 1fr); gap: 14px; padding-block: 16px; border-bottom: 1px solid var(--line); color: var(--body); font-size: 12px; line-height: 1.75; }
  .pending-type { color: var(--gold-dark); font-size: 10px; letter-spacing: .8px; text-transform: uppercase; }
</style>
