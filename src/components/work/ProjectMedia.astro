---
import type { CollectionEntry } from 'astro:content';
import { mediaPreview } from '../../lib/media';

interface Props {
  cover: CollectionEntry<'projects'>['data']['cover'];
  number: string;
  title: string;
  presentation?: 'card' | 'detail';
  showCaption?: boolean;
  bounded?: boolean;
}
const { cover, number, title, presentation = 'card', showCaption = true, bounded = false } = Astro.props;
const boundedImage = presentation === 'detail' && bounded && cover.type === 'image' && !!cover.url;
const preview = mediaPreview(cover.url);
const poster = cover.poster || (cover.type === 'gif' ? preview?.src : undefined);
const sizes = presentation === 'card' ? '(max-width: 640px) calc(100vw - 40px), 55vw' : '(max-width: 1000px) calc(100vw - 80px), 45vw';
const label = cover.type === 'gif' ? 'GIF preview' : cover.type === 'video' ? 'Video preview' : 'Image preview';
---

<figure class:list={['project-media', { 'detail-presentation': presentation === 'detail', 'card-presentation': presentation === 'card', 'bounded-presentation': boundedImage }]} data-media-id={cover.id} data-media-type={cover.type} style={presentation === 'detail' ? `--media-ratio: ${cover.width} / ${cover.height}` : undefined}>
  {cover.url ? (
    cover.type === 'gif' ? (
      <div class="gif-preview" data-gif-preview data-src={cover.url} data-alt={cover.alt} data-width={cover.width} data-height={cover.height}>
        <img data-gif-poster={poster ? '' : undefined} data-playing-gif={poster ? undefined : ''} src={poster || cover.url} srcset={poster === preview?.src ? preview?.srcset : undefined} sizes={sizes} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
        <button class="gif-toggle" type="button" data-gif-toggle aria-pressed="false" hidden>Play GIF</button>
        <span class="gif-status" data-gif-status role="status" aria-live="polite"></span>
        <noscript><a href={cover.url} target="_blank" rel="noopener noreferrer">Open GIF (new tab)</a></noscript>
      </div>
    ) : cover.type === 'video' ? (
      <video
        controls
        playsinline
        preload="none"
        poster={cover.poster}
        width={cover.width}
        height={cover.height}
        aria-label={cover.alt}
      >
        <source src={cover.url} />
        <a href={cover.url}>View video: {title}</a>
      </video>
    ) : boundedImage ? (
      <div class="bounded-image">
        <div class="image-preview" data-crop-preview>
          <img src={preview?.src || cover.url} srcset={preview?.srcset} sizes={sizes} alt={cover.alt} width={cover.width} height={cover.height} loading="lazy" decoding="async" />
        </div>
        <a class="full-page-link" href={cover.url} target="_blank" rel="noopener noreferrer" data-full-page-image data-image-alt={cover.alt} data-image-title={cover.caption || title} data-image-width={cover.width} data-image-height={cover.height} aria-haspopup="dialog" aria-label={`View full page: ${cover.caption || title}`} hidden>View full page</a>
      </div>
    ) : (
      <img
        src={preview?.src || cover.url}
        srcset={preview?.srcset}
        sizes={sizes}
        alt={cover.alt}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
      />
    )
  ) : (
    <div class="media-placeholder" role="img" aria-label={`Media placeholder for ${title}; ${label.toLowerCase()} pending.`}>
      <div class="placeholder-top"><span>{label}</span><span>Media placeholder</span></div>
      <span class="placeholder-number" aria-hidden="true">{number}</span>
      <div class="placeholder-bottom"><span>{cover.id}</span><span>Preview pending</span></div>
    </div>
  )}
  {showCaption && cover.caption && <figcaption>{cover.caption}</figcaption>}
</figure>

<script>
  const setState = (preview: HTMLElement, playing: boolean) => {
    const button = preview.querySelector<HTMLButtonElement>('[data-gif-toggle]')!;
    button.textContent = playing ? 'Pause GIF' : 'Play GIF';
    button.setAttribute('aria-pressed', String(playing));
  };
  const pause = async (preview: HTMLElement) => {
    const image = preview.querySelector<HTMLImageElement>('[data-playing-gif]');
    if (!image || preview.dataset.pausing) return;
    preview.dataset.pausing = 'true';
    try {
      await image.decode();
      if (!image.isConnected) return;
      const canvas = document.createElement('canvas');
      canvas.dataset.gifStill = '';
      canvas.width = image.naturalWidth;
      canvas.height = image.naturalHeight;
      canvas.setAttribute('role', 'img');
      canvas.setAttribute('aria-label', image.alt);
      const context = canvas.getContext('2d');
      if (!context) return;
      context.drawImage(image, 0, 0);
      preview.querySelector('[data-gif-still]')?.remove();
      image.replaceWith(canvas);
      setState(preview, false);
    } finally {
      delete preview.dataset.pausing;
    }
  };
  const initialize = (root: ParentNode) => root.querySelectorAll<HTMLElement>('[data-gif-preview]').forEach((preview) => {
    preview.querySelector<HTMLButtonElement>('[data-gif-toggle]')!.hidden = false;
    void pause(preview).catch(() => {});
  });
  initialize(document);
  if (!document.documentElement.hasAttribute('data-gif-controls-ready')) {
    document.documentElement.setAttribute('data-gif-controls-ready', '');
    document.addEventListener('aklov:project-open', (event) => initialize((event as CustomEvent<{ root: ParentNode }>).detail.root));
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (event) => {
      if (event.matches) document.querySelectorAll<HTMLElement>('[data-gif-preview]').forEach((preview) => void pause(preview).catch(() => {}));
    });
    document.addEventListener('click', async (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-gif-toggle]') : null;
      const preview = button?.closest<HTMLElement>('[data-gif-preview]');
      if (!button || !preview || preview.dataset.pausing || preview.dataset.gifLoading) return;
      if (preview.querySelector('[data-playing-gif]')) {
        void pause(preview).catch(() => {});
      } else {
        const image = document.createElement('img');
        image.dataset.playingGif = '';
        image.dataset.userPlay = '';
        image.src = preview.dataset.src!;
        image.alt = preview.dataset.alt!;
        image.width = Number(preview.dataset.width);
        image.height = Number(preview.dataset.height);
        image.decoding = 'async';
        preview.dataset.gifLoading = 'true';
        button.disabled = true;
        const status = preview.querySelector<HTMLElement>('[data-gif-status]')!;
        status.textContent = 'Loading GIF…';
        try {
          await image.decode();
          if (!preview.isConnected) return;
          preview.querySelector('[data-gif-still]')?.remove();
          preview.querySelector('[data-gif-poster]')?.remove();
          preview.prepend(image);
          setState(preview, true);
          status.textContent = '';
        } catch {
          setState(preview, false);
          status.textContent = "GIF couldn't load. Try Play again.";
        } finally {
          button.disabled = false;
          delete preview.dataset.gifLoading;
        }
      }
    });
  }
</script>

<style>
  .project-media { margin: 0; }
  .project-media img,
  .project-media video,
  .media-placeholder,
  .gif-preview { display: block; width: 100%; aspect-ratio: 8 / 5; }
  .project-media img,
  .project-media video { height: auto; object-fit: contain; background: var(--charcoal); }
  .detail-presentation img,
  .detail-presentation video,
  .detail-presentation .media-placeholder,
  .detail-presentation .gif-preview { aspect-ratio: var(--media-ratio); }
  .detail-presentation img, .detail-presentation video { max-height: 75dvh; }
  .detail-presentation:not(.bounded-presentation) > img { max-height: none; }
  .image-preview { display: block; height: clamp(240px, 32vw, 420px); overflow: hidden; background: var(--charcoal); }
  .image-preview img { display: block; width: 100%; height: auto; max-height: none; object-fit: contain; object-position: center top; }
  .full-page-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; color: var(--charcoal); font-size: 12px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .full-page-link[hidden] { display: none; }
  .full-page-link:focus-visible { outline-color: var(--charcoal); }
  @media (hover: hover) { .full-page-link:hover { color: var(--gold-dark); } }
  .gif-preview { position: relative; overflow: hidden; background: var(--charcoal); color: var(--ivory); }
  .gif-preview :global(img), .gif-preview :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; max-height: none; object-fit: contain; }
  .card-presentation > img,
  .card-presentation > video,
  .card-presentation .gif-preview :global(img),
  .card-presentation .gif-preview :global(canvas) { object-fit: cover; object-position: center top; }
  :global(html[data-gif-controls-ready]) .gif-preview :global(img[data-playing-gif]:not([data-user-play])) { visibility: hidden; }
  .gif-preview [hidden] { display: none !important; }
  .gif-fallback { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--display); font-size: 32px; }
  .gif-status { position: absolute; left: 16px; bottom: 16px; max-width: 55%; padding: 4px 8px; background: var(--charcoal); color: var(--ivory); font: 12px/1.5 var(--sans); }
  .gif-status:empty { display: none; }
  .gif-toggle:disabled { cursor: wait; }
  .gif-toggle { position: absolute; z-index: 1; bottom: 16px; right: 16px; min-height: 44px; padding: 0 18px; border: 1px solid var(--gold); border-radius: 99px; background: var(--charcoal); color: var(--ivory); font: 600 12px var(--sans); cursor: pointer; }
  .media-placeholder {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: clamp(18px, 2.2vw, 36px);
    background: var(--charcoal);
    color: var(--ivory);
  }
  .media-placeholder::before {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid var(--line-dark);
    pointer-events: none;
  }
  .placeholder-top,
  .placeholder-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 10px;
    line-height: 1.6;
  }
  .placeholder-top { color: var(--gold); letter-spacing: 1.2px; text-transform: uppercase; }
  .placeholder-bottom { color: var(--on-dark); }
  .placeholder-bottom span:first-child { overflow-wrap: anywhere; }
  .placeholder-bottom span:last-child { flex-shrink: 0; }
  .placeholder-number {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: transparent;
    -webkit-text-stroke: 1px var(--gold);
    font-family: var(--display);
    font-size: clamp(90px, 14vw, 240px);
    line-height: .8;
    letter-spacing: -.05em;
  }
  figcaption { margin-top: 12px; color: var(--body); font-size: 12px; line-height: 1.6; }
  @media (max-width: 640px) {
    .placeholder-top, .placeholder-bottom { font-size: 9px; gap: 10px; }
    .placeholder-top { letter-spacing: .8px; }
    .placeholder-number { font-size: clamp(100px, 30vw, 170px); }
  }
</style>
