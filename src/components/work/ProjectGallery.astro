---
import type { CollectionEntry } from 'astro:content';
import { projectCategories } from '../../data/projectCategories';
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';

interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
const filters = [
  { id: 'all', label: 'All Projects' },
  ...projectCategories,
];
const countFor = (id: string) => projects.filter(({ data }) =>
  id === 'all' || data.primaryCategory === id || data.additionalCategories.includes(id as typeof data.primaryCategory)
).length;
---

<section class="gallery" id="projects" aria-label="Portfolio projects" data-project-gallery>
  <div class="wrap">
    <div class="gallery-heading">
      <p class="kicker mono">Project index</p>
      <p class="result-count" role="status" aria-live="polite" aria-atomic="true" data-result-count>
        {projects.length} projects · All Projects
      </p>
    </div>
    <div class="filters" role="group" aria-label="Filter projects by category" hidden data-filters>
      {filters.map((filter) => (
        <button
          type="button"
          data-filter={filter.id}
          data-label={filter.label}
          aria-pressed={filter.id === 'all' ? 'true' : 'false'}
          aria-controls="project-grid"
        >
          <span>{filter.label}</span>
          <span class="filter-count" aria-hidden="true">{String(countFor(filter.id)).padStart(2, '0')}</span>
        </button>
      ))}
    </div>
    <noscript><p class="no-script">All projects are shown. Enable JavaScript to filter by category.</p></noscript>
    <div class="project-grid" id="project-grid" data-project-grid>
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
    <p class="empty-state" hidden data-empty-state>No projects in this category yet.</p>
  </div>
</section>
<ProjectDialog projects={projects} />

<script>
  import { filterFromUrl, matchesFilter, urlForFilter } from '../../scripts/projectFilter';
  import type { ProjectFilter } from '../../data/projectCategories';

  const gallery = document.querySelector<HTMLElement>('[data-project-gallery]');
  if (gallery) {
    const filters = gallery.querySelector<HTMLElement>('[data-filters]')!;
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...gallery.querySelectorAll<HTMLElement>('[data-project]')];
    const result = gallery.querySelector<HTMLElement>('[data-result-count]')!;
    const emptyState = gallery.querySelector<HTMLElement>('[data-empty-state]')!;

    const applyFilter = (filter: ProjectFilter) => {
      let visible = 0;
      for (const card of cards) {
        card.hidden = !matchesFilter((card.dataset.categories ?? '').split(' '), filter);
        if (!card.hidden) card.dataset.layout = String(visible++ % 4);
      }
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.filter === filter));
      }
      const label = buttons.find((button) => button.dataset.filter === filter)!.dataset.label;
      result.textContent = `${visible} ${visible === 1 ? 'project' : 'projects'} · ${label}`;
      emptyState.hidden = visible !== 0;
    };

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter as ProjectFilter;
        const current = new URL(window.location.href);
        const next = urlForFilter(current, filter);
        if (next.href !== current.href) history.pushState(null, '', next);
        applyFilter(filter);
      });
    }
    window.addEventListener('popstate', () => applyFilter(filterFromUrl(new URL(window.location.href))));
    applyFilter(filterFromUrl(new URL(window.location.href)));
    filters.hidden = false;
  }
</script>

<style>
  .gallery { padding-block: clamp(40px, 5vw, 72px) clamp(64px, 8vw, 120px); }
  .gallery-heading { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 14px; margin-bottom: 24px; }
  .gallery-heading p { margin: 0; }
  .result-count { color: var(--body); font-size: 12px; line-height: 1.6; }
  .filters { display: flex; flex-wrap: wrap; gap: 0 28px; padding-block: 4px 16px; border-block: 1px solid var(--charcoal); margin-bottom: clamp(32px, 4vw, 58px); }
  .filters[hidden], .empty-state[hidden] { display: none; }
  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 10px 0 6px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--body);
    font: 500 12px/1.5 var(--sans);
    text-align: left;
    cursor: pointer;
    transition: color .2s ease, border-color .2s ease;
  }
  .filters button[aria-pressed='true'] { color: var(--charcoal); border-bottom-color: var(--charcoal); }
  .filters button:focus-visible { outline-color: var(--charcoal); outline-offset: 3px; }
  .filter-count { color: var(--gold-dark); font-size: 10px; font-variant-numeric: tabular-nums; }
  .project-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(44px, 6vw, 90px) clamp(24px, 4vw, 64px); align-items: start; }
  .project-grid > :global(.project-card) { grid-column: span 6; }
  .project-grid > :global(.project-card[data-layout='0']),
  .project-grid > :global(.project-card[data-layout='3']) { grid-column: span 7; }
  .project-grid > :global(.project-card[data-layout='1']),
  .project-grid > :global(.project-card[data-layout='2']) { grid-column: span 5; }
  .no-script, .empty-state { padding-block: 24px; color: var(--body); font-size: 14px; line-height: 1.8; }
  @media (hover: hover) { .filters button:hover { color: var(--gold-dark); border-bottom-color: var(--gold-dark); } }
  @media (max-width: 1000px) {
    .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .project-grid > :global(.project-card[data-layout]) { grid-column: span 1; }
    .filters { gap: 0 24px; }
  }
  @media (max-width: 640px) {
    .gallery-heading { align-items: flex-start; flex-direction: column; gap: 10px; }
    .filters { display: grid; grid-template-columns: 1fr 1fr; gap: 0 18px; padding-bottom: 8px; }
    .filters button { justify-content: space-between; min-height: 64px; padding-block: 10px; border-bottom-width: 1px; font-size: 11px; }
    .filter-count { flex-shrink: 0; }
    .filters button[aria-pressed='true'] { font-weight: 700; }
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
