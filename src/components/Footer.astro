---
const { contactHref = '/#contact' } = Astro.props;
---

<footer class="footer">
  <div class="wrap">
    <div class="foot-main">
      <a class="foot-brand" href="/" aria-label="Aklov home">aklov<i>.</i></a>

      <div class="st">Websites and business systems, thoughtfully built.</div>

      <nav class="foot-links" aria-label="Footer navigation">
        <a href="/">Home</a>
        <a href="/solutions/">Solutions</a>
        <a href="/work/">Work</a>
        <a href="/about/">About</a>
        <a href={contactHref}>Contact</a>
      </nav>
    </div>

    <div class="foot-bottom">
      <span>© {new Date().getFullYear()} Aklov. All rights reserved.</span>
      <span>Built around the way business works.</span>
    </div>
  </div>

  <div class="giant" aria-hidden="true">aklov<i>.</i></div>
</footer>

<style>
  .footer {
    overflow: hidden;
    background: var(--charcoal);
    color: var(--on-dark);
  }

  .foot-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 30px;
    align-items: center;
    padding-block: 34px;
    border-bottom: 1px solid var(--line-dark);
    font-size: 11px;
  }

  .foot-main .st {
    color: var(--ivory);
    font-family: var(--display);
    font-size: 22px;
    text-align: center;
  }

  .foot-links {
    display: flex;
    justify-content: flex-end;
    gap: 24px;
  }

  .foot-brand {
    color: var(--ivory);
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -1.5px;
  }

  .foot-brand i,
  .giant i {
    font-style: normal;
    color: var(--gold);
  }

  .giant {
    height: .62em;
    margin: 0 0 0 -.03em;
    padding-top: .1em;
    overflow: hidden;
    color: var(--ivory);
    font-family: var(--display);
    font-size: clamp(150px, 36vw, 640px);
    font-weight: 400;
    line-height: .72;
    letter-spacing: -.06em;
    white-space: nowrap;
    user-select: none;
  }

  .foot-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 16px;
    border-top: 1px solid var(--line-dark);
    color: var(--on-dark-dim);
    font-size: 9px;
    letter-spacing: .5px;
  }

  @media (hover: hover) {
    .foot-links a { transition: color .2s ease; }
    .foot-links a:hover { color: var(--gold); }
  }

  @media (max-width: 1000px) {
    .foot-main { grid-template-columns: 1fr; }
    .foot-main .st { text-align: left; }

    .foot-links {
      justify-content: flex-start;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 640px) {
    .foot-bottom {
      flex-direction: column;
      gap: 6px;
    }

    .foot-links { gap: 18px; }
    .giant { font-size: 36vw; }
  }
</style>
