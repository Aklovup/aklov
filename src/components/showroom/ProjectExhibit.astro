---
import { render, type CollectionEntry } from 'astro:content';
import ProjectMedia from '../work/ProjectMedia.astro';
interface Props { projects:CollectionEntry<'projects'>[]; }
const { projects }=Astro.props;
const entries=await Promise.all(projects.map(async(project,index)=>({project,index,Content:(await render(project)).Content})));
---
<section class="project-exhibit" data-exhibit hidden aria-label="Project exhibition">
  <header class="exhibit-header"><p data-exhibit-type></p><h2 data-exhibit-title tabindex="-1"></h2><p data-exhibit-intro></p><p class="exhibit-summary" data-exhibit-summary></p></header>
  <div class="exhibit-installation" data-exhibit-installation>
    <div class="installation-label"><span>Project display</span><span data-media-position></span></div>
    <div class="installation-media" data-exhibit-stage></div>
    <nav class="installation-controls" aria-label="Project media" data-exhibit-media-controls></nav>
  </div>
  <section class="exhibit-story" aria-label="Project story" data-scene-reading>
    <nav class="chapter-nav" aria-label="Case-study chapters" data-exhibit-chapters></nav>
    <div class="chapter-content" data-exhibit-chapter tabindex="0" role="region" aria-label="Selected project chapter"></div>
    <nav class="exhibit-links" aria-label="External project links" data-exhibit-links></nav>
  </section>
</section>
{entries.map(({ project, index, Content }) => (
  <div hidden data-exhibit-template={project.data.slug}>
    <header data-exhibit-metadata data-type={project.data.projectType} data-title={project.data.title} data-intro={project.data.headline} data-summary={project.data.description}></header>
    <div data-exhibit-copy><Content /></div>
    <div data-exhibit-assets>
      {project.data.media.map((item) => (
        <section data-exhibit-asset data-label={item.caption || item.alt} data-available={Boolean(item.url)}>
          <ProjectMedia cover={item} title={project.data.title} number={String(index + 1).padStart(2, '0')} presentation="detail" bounded={false} />
        </section>
      ))}
    </div>
    <nav data-exhibit-external>
      {project.data.externalUrl && (
        <a href={project.data.externalUrl} target="_blank" rel="noopener noreferrer">Visit Website ↗</a>
      )}
      {project.data.externalLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
      ))}
    </nav>
  </div>
))}
<style is:global>
  .project-exhibit { position:absolute;inset:225px var(--pad) 84px;z-index:4;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.85fr);grid-template-rows:auto minmax(0,1fr);gap:24px 5vw;max-width:1300px;margin-inline:auto;pointer-events:none;opacity:0;transform:translateY(12px);transition:opacity .55s,transform .55s; }
  .showroom[data-room-ready='true'] .project-exhibit,.showroom[data-renderer='fallback'] .project-exhibit { opacity:1;transform:none; }
  .project-exhibit[hidden] { display:none; }
  .exhibit-header { grid-column:1/-1;max-width:850px;padding-left:6vw;pointer-events:auto; }
  .exhibit-header>p:first-child { margin:0 0 8px;color:var(--gold);font:10px/1.5 var(--sans);letter-spacing:1.5px;text-transform:uppercase; }
  .exhibit-header h2 { margin:0;color:var(--ivory);font:400 clamp(28px,3.2vw,52px)/1.05 var(--display);letter-spacing:-.025em; }
  .exhibit-header>[data-exhibit-intro],.exhibit-summary { margin:12px 0 0;color:#d1d6cc;font:400 14px/1.7 var(--sans);max-width:65ch; }
  .exhibit-summary { font-size:12px!important;color:#bfc9c0!important;max-width:76ch!important; }
  .project-exhibit .gif-toggle { background:#102023!important;border:1px solid var(--gold); }
  .exhibit-installation { display:flex;flex-direction:column;max-height:100%;min-height:0;min-width:0;align-self:center;margin-left:6vw;pointer-events:auto;border-top:1px solid #d8bd7880;border-bottom:1px solid #d8bd7840;background:linear-gradient(145deg,#17282ae6,#081316e6);box-shadow:0 25px 70px #0005,0 0 35px #d8bd780b; }
  .installation-label { display:flex;justify-content:space-between;gap:12px;padding:15px 18px;color:var(--gold);font:10px/1.4 var(--sans);letter-spacing:1px;text-transform:uppercase; }
  .installation-media { flex:1;min-height:0;max-height:39dvh;overflow:auto;overscroll-behavior:contain;scrollbar-color:var(--gold) #152125;scrollbar-width:thin; }
  .installation-media .project-media { margin:0; }
  .installation-media .project-media>img { width:100%;height:auto;max-height:none; }
  .installation-media .gif-preview { aspect-ratio:var(--media-ratio);max-height:35dvh; }
  .installation-media video { max-height:35dvh; }
  .installation-media figcaption { margin:0;padding:12px 18px;color:#cbd1c7;font-size:11px;background:#0e1b1f; }
  .installation-controls { display:flex;gap:3px;overflow:auto;padding:4px 12px;border-top:1px solid #d8bd7830; }
  .installation-controls button { flex:0 0 auto;min-width:44px;min-height:44px;border:0;color:#b9c2ba!important; }
  .installation-controls button[aria-pressed='true'] { color:var(--gold)!important;border-bottom:1px solid var(--gold); }
  .exhibit-story { min-height:0;pointer-events:auto;display:flex;flex-direction:column;border-left:1px solid #d8bd7870;padding:0 0 0 clamp(20px,2.5vw,40px);background:linear-gradient(90deg,#142226ee,#102023e8);box-shadow:25px 0 50px #102023e8; }
  .chapter-nav { display:flex;flex-wrap:wrap;gap:0 16px;padding:0 12px 12px 0;border-bottom:1px solid #ffffff25; }
  .chapter-nav button { min-height:40px;border:0;border-bottom:1px solid transparent;color:#bcc6bd!important;font-size:11px!important; }
  .chapter-nav button[aria-pressed='true'] { color:var(--gold)!important;border-color:var(--gold); }
  .chapter-content { min-height:0;overflow:auto;overscroll-behavior:contain;padding:24px 18px 20px 0;scrollbar-color:var(--gold) #152125;scrollbar-width:thin; }
  .chapter-content h3 { margin:0 0 22px;color:var(--ivory);font:400 clamp(28px,2.6vw,40px)/1.1 var(--display);letter-spacing:-.015em; }
  .chapter-content p,.chapter-content li { color:#dce0d6;font:400 14px/1.9 var(--sans);overflow-wrap:anywhere; }
  .chapter-content p { margin:0 0 18px; }
  .exhibit-links { display:flex;flex-wrap:wrap;gap:8px 20px;padding:10px 12px 0 0;border-top:1px solid #ffffff25; }
  .exhibit-links:empty { display:none; }
  .exhibit-links a { min-height:44px;display:inline-flex;align-items:center;color:var(--gold);font-size:12px; }
  @media(max-width:1100px) { .project-exhibit { gap:20px;grid-template-columns:minmax(0,1.1fr) minmax(280px,1fr); } .exhibit-header,.exhibit-installation { padding-left:0;margin-left:0; } }
  @media(max-width:800px) { .project-exhibit { inset:235px var(--pad) 92px;display:block;overflow:auto;pointer-events:auto;overscroll-behavior:contain; } .exhibit-header { margin-bottom:22px; } .exhibit-installation { margin-bottom:28px; } .installation-media { max-height:40dvh; } .exhibit-story { padding:20px;border:1px solid #d8bd7860; } .chapter-content { max-height:45dvh; } .exhibit-header h2 { font-size:32px; } }
  @media(max-height:700px) and (min-width:801px) { .project-exhibit { inset-block:170px 72px;gap:12px 3vw; } .exhibit-header>[data-exhibit-intro],.exhibit-summary { margin-top:5px;font-size:12px; } .exhibit-header h2 { font-size:30px; } .chapter-content { padding-top:15px; } }
  @media(prefers-reduced-motion:reduce) { .project-exhibit { transition:none;transform:none; } }
</style>
