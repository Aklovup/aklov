---
import type { CollectionEntry } from 'astro:content';
import { mediaPreview } from '../../lib/media';
import { modelsFor, type ShowroomProject } from '../../scripts/showroomState';
import ProjectGallery from '../work/ProjectGallery.astro';
import ProjectExhibit from './ProjectExhibit.astro';
interface Props { projects:CollectionEntry<'projects'>[]; }
const { projects }=Astro.props;
const entries:ShowroomProject[]=projects.map(({data})=>({slug:data.slug,aliases:data.aliases,title:data.title,description:data.description,projectType:data.projectType,primaryCategory:data.primaryCategory,src:data.cover.poster||mediaPreview(data.cover.url)?.src||(data.cover.type==='image'?data.cover.url:undefined),initialMedia:data.media.find(item=>item.url&&item.url===data.cover.url)?.id,media:data.media.filter(item=>item.url).sort((a,b)=>a.order-b.order).map(item=>({id:item.id,type:item.type,label:item.caption||item.alt,src:item.poster||mediaPreview(item.url)?.src||(item.type==='image'?item.url:undefined)}))}));
const models=modelsFor(entries,'client');
---
<script is:inline>document.documentElement.dataset.showroomJs='';</script>
<section class="showroom" data-showroom data-view="showroom" aria-labelledby="work-title">
  <svg class="showroom-fallback" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs><radialGradient id="room-light"><stop stop-color="#55534e"/><stop offset="1" stop-color="#151515"/></radialGradient><linearGradient id="table-light"><stop stop-color="#b9ad89"/><stop offset="1" stop-color="#655d46"/></linearGradient></defs>
    <rect width="1440" height="1000" fill="url(#room-light)"/>
    <path d="M260 600L780 410L1220 650L680 865Z" fill="#1b1b1b"/>
    <path d="M230 560L780 350L1240 590L680 810Z" fill="url(#table-light)"/>
    {[{x:430,y:460},{x:770,y:430},{x:590,y:600},{x:920,y:580}].map(({x,y})=><g transform={`translate(${x} ${y})`}><path d="M0 0L120 -45L220 10L100 65Z" fill="#eee9db"/><path d="M0 0V80L100 145V65Z" fill="#c7c3b8"/><path d="M100 65L220 10V90L100 145Z" fill="#8c8880"/><path d="M120 65L200 28V78L120 115Z" fill="#292929"/></g>)}
  </svg>
  <canvas data-showroom-canvas aria-hidden="true"></canvas>
  <div class="showroom-shade" aria-hidden="true"></div>
  <div class="showroom-arrival" data-showroom-arrival><span class="arrival-brand">aklov<span>.</span></span><p role="status">Preparing the showroom</p><a href="#showroom-index" data-arrival-rescue hidden>Explore the project index →</a></div>
  <div class="showroom-toolbar">
    <span class="mono">Portfolio / Aklov</span>
    <div class="showroom-types" role="group" aria-label="Choose showroom collection">
      <button type="button" data-showroom-type="client" aria-pressed="true">Client projects</button>
      <button type="button" data-showroom-type="concepts" aria-pressed="false">Independent concepts</button>
    </div>
  </div>
  <nav class="showroom-path" aria-label="Showroom location">
    <button type="button" data-showroom-home>Showroom</button>
    <span data-model-path hidden><span aria-hidden="true">/</span><button type="button" data-showroom-category></button></span>
    <button type="button" data-showroom-back hidden>← Back</button>
  </nav>
  <div class="showroom-title"><h1 id="work-title">Work<span>.</span></h1><p>Client projects<br/><em>&amp; independent concepts.</em></p></div>
  <section class="showroom-info" aria-label="Selected exhibit">
    <span class="showroom-eyebrow" data-showroom-eyebrow>{projects.filter(p=>p.data.projectType==='Client Project').length} client projects</span>
    <h2 data-showroom-heading>Select a model.</h2>
    <p data-showroom-description>Choose a category model to explore its project rooms.</p>

  </section>
  <div class="showroom-options" role="group" aria-label="Choose a category model" data-showroom-options>
    {models.map((model,index)=><button type="button" data-showroom-model={model.category}><span class="option-number">{String(index+1).padStart(2,'0')}</span><span>{model.label}</span><span class="option-count">{String(model.projects.length).padStart(2,'0')}</span></button>)}
  </div>
  <button type="button" class="spatial-exit" data-showroom-exit hidden><span class="exit-threshold" aria-hidden="true"></span><span data-exit-label>Leave room</span><span aria-hidden="true">↙</span></button>
  <ProjectExhibit projects={projects}/>
  <div class="travel-indicator" aria-hidden="true"><span data-travel-progress></span></div>
  <div class="showroom-bottom"><button type="button" data-showroom-index-open>Browse Project List ↗</button><button type="button" data-showroom-motion hidden aria-pressed="false">Pause motion</button><span data-showroom-hint>Move to look · Scroll to travel · Select a model</span></div>
  <p class="sr-status" role="status" aria-live="polite" data-showroom-status></p>
  <script id="showroom-data" type="application/json" set:html={JSON.stringify(entries).replace(/</g,'\u003c')}/>
</section>
<section class="showroom-index" id="showroom-index" tabindex="-1" aria-labelledby="showroom-index-title" data-showroom-index>
  <div class="index-bar"><h2 id="showroom-index-title">Project index</h2><button type="button" data-showroom-index-close hidden>Return to exhibition ↙</button></div>
  <ProjectGallery projects={projects} renderDialog={false}/>
</section>
<script>
  import { mountShowroom } from '../../scripts/showroom';
  const root=document.querySelector<HTMLElement>('[data-showroom]');
  if(root)mountShowroom(root);
</script>
<style is:global>
  html:has(.showroom),body:has(.showroom) { height:100%;overflow:hidden; }
  body:has(.showroom) .header-surface { position:absolute;z-index:10;top:0;left:0;width:100%;background:linear-gradient(#151515e6,transparent); }
  body:has(.showroom) .footer { display:none; }
  .showroom { touch-action:none;position:relative;isolation:isolate;width:100%;height:100dvh;min-height:0;overflow:hidden;background:#151515;color:var(--ivory);--focus-color:var(--gold); }
  .showroom[data-surface-mode='flat'] { touch-action:pan-y pinch-zoom; }
  .showroom canvas[data-showroom-canvas],.showroom-fallback { position:absolute;inset:0;width:100%;height:100%; }
  .showroom canvas[data-showroom-canvas] { z-index:1;opacity:0;transition:opacity .65s;touch-action:none;cursor:grab; }
  .showroom[data-arrival='ready'][data-renderer='webgl'] canvas[data-showroom-canvas] { opacity:1; }
  .showroom-fallback { visibility:hidden; }
  .showroom[data-renderer='fallback'] .showroom-fallback,html:not([data-showroom-js]) .showroom-fallback { visibility:visible; }
  .showroom[data-renderer='fallback'] canvas[data-showroom-canvas] { visibility:hidden;pointer-events:none; }
  .showroom[data-dragging] canvas { cursor:grabbing; }
  .showroom-shade { z-index:2;position:absolute;inset:0;pointer-events:none;background:linear-gradient(0deg,#111111fa 0%,#111111eb 18%,#111111aa 36%,transparent 60%,#11111145); }
  .showroom[data-view='project'] .showroom-shade { background:linear-gradient(0deg,#11111188,transparent 16%,transparent 86%,#11111188); }
  .showroom-toolbar { position:absolute;z-index:3;top:112px;left:var(--pad);right:var(--pad);display:flex;justify-content:space-between;align-items:center;gap:20px; }
  .showroom-toolbar>.mono { color:#c6c1b7; }
  .showroom-types { display:flex;gap:8px; }
  .showroom button { color:inherit;cursor:pointer;background:none;font:500 12px/1.4 var(--sans); }
  .showroom-types button { min-height:44px;padding:0 18px;border:1px solid #ffffff35;border-radius:99px; }
  .showroom-types button[aria-pressed='true'] { color:#151515;background:var(--gold);border-color:var(--gold); }
  .showroom-path { position:absolute;top:170px;left:var(--pad);right:var(--pad);z-index:3;display:flex;align-items:center;gap:14px;font-size:12px; }
  .showroom-path button { min-height:44px;padding:0;border:0;border-bottom:1px solid #ffffff35; }
  .showroom-path [data-model-path] { display:inline-flex;align-items:center;gap:14px; }
  .showroom-path [hidden],.showroom [hidden] { display:none!important; }
  .showroom-path [data-showroom-back] { margin-left:auto; }
  .showroom-title { position:absolute;left:var(--pad);bottom:220px;z-index:2;pointer-events:none;transition:opacity .3s; }
  .showroom-title h1 { margin:0 0 16px;font:400 clamp(80px,10vw,156px)/.85 var(--display);letter-spacing:-.05em; }
  .showroom-title h1 span,.showroom-title em { color:var(--gold); }
  .showroom-title p { margin:0;font:400 clamp(22px,2vw,30px)/1.1 var(--display); }
  .showroom:not([data-view='showroom']) .showroom-title { opacity:0; }
  .showroom-info { position:absolute;right:var(--pad);bottom:220px;z-index:3;width:clamp(260px,25vw,360px);max-height:40dvh;overflow:auto;scrollbar-width:thin; }
  .showroom-eyebrow { display:block;margin-bottom:13px;color:var(--gold);font:500 10px/1.5 var(--sans);letter-spacing:1.3px;text-transform:uppercase; }
  .showroom-info h2 { margin:0 0 14px;font:400 clamp(32px,3.5vw,52px)/1.02 var(--display);letter-spacing:-.025em; }
  .showroom-info p { margin:0;color:#d9d5cc;font:400 14px/1.75 var(--sans); }
  .showroom-case { display:flex;align-items:center;justify-content:space-between;gap:40px;min-height:48px;margin-top:20px;padding:0!important;border:0;border-bottom:1px solid var(--gold); }
  .showroom-options { position:absolute;z-index:3;bottom:78px;left:var(--pad);right:var(--pad);display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px; }
  .showroom-options button { display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;min-height:76px;padding:14px 0;border:0;border-top:1px solid #ffffff55;text-align:left; }
  .showroom-options button:hover,.showroom-options button[aria-pressed='true'] { color:var(--gold);border-color:var(--gold); }
  .option-number,.option-count { color:var(--gold);font-size:10px;font-variant-numeric:tabular-nums; }
  .showroom-bottom { position:absolute;z-index:3;bottom:max(14px,env(safe-area-inset-bottom));left:var(--pad);right:var(--pad);display:flex;align-items:center;justify-content:space-between;gap:18px;border-top:1px solid #ffffff25;padding-top:6px; }
  .showroom-bottom button { min-height:44px;padding:0;border:0; }
  .showroom-bottom>span { font-size:10px;color:#c0bbb1; }
  .sr-status { position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%); }
  .showroom-index { position:fixed;z-index:8;inset:96px 0 0;width:100%;max-width:none;height:calc(100dvh - 96px);max-height:none;margin:0;padding:0;overflow:auto;overscroll-behavior:contain;border:1px solid var(--line);background:var(--ivory);color:var(--charcoal); }

  html[data-showroom-js] .showroom-index:not([data-user-open]) { display:none; }
  .index-bar { position:sticky;top:0;z-index:4;display:flex;justify-content:space-between;align-items:center;gap:24px;padding:18px var(--pad);background:var(--ivory);border-bottom:1px solid var(--line); }
  .index-bar h2 { margin:0;font:400 32px var(--display); }
  .index-bar button { min-height:44px;border:0;background:none;color:var(--charcoal);font:500 13px var(--sans);cursor:pointer; }
  .index-bar button[hidden] { display:none; }
  @media(max-width:800px) {
    .showroom-toolbar { top:94px;flex-wrap:wrap;gap:8px; }
    .showroom-toolbar>.mono { width:100%;font-size:9px; }
    .showroom-types { width:100%; }
    .showroom-types button { min-height:40px;font-size:11px;padding:0 14px; }
    .showroom-path { top:176px;font-size:11px;gap:10px; }
    .showroom-path button { font-size:11px; }
    .showroom-path [data-model-path] { gap:8px;min-width:0; }
    .showroom-path [data-showroom-category] { max-width:43vw;text-align:left; }
    .showroom-title { top:230px;bottom:auto; }
    .showroom-title h1 { font-size:72px;margin-bottom:10px; }
    .showroom-title p { display:none; }
    .showroom-info { bottom:205px;left:var(--pad);right:var(--pad);width:auto;max-height:26dvh;padding-top:12px; }
    .showroom[data-view='showroom'] .showroom-info { max-width:270px; }
    .showroom-info h2 { font-size:29px;margin-bottom:10px; }
    .showroom[data-view='showroom'] .showroom-info h2 { font-size:25px; }
    .showroom-info p { font-size:13px;line-height:1.65; }
    .showroom-eyebrow { font-size:9px;margin-bottom:8px; }
    .showroom-case { margin-top:12px; }
    .showroom-options { bottom:76px;gap:0 16px;grid-template-columns:repeat(2,minmax(0,1fr)); }
    .showroom-options button { min-height:56px;padding:9px 0;gap:7px;font-size:11px; }
    .option-number,.option-count { font-size:9px; }
    .showroom-bottom { gap:12px; }
    .showroom-bottom button { font-size:11px; }
    .showroom-bottom>span { display:none; }
    .showroom-index { inset:82px 0 0;width:100%;height:calc(100dvh - 82px);max-height:none;border:0; }
  }
  @media(max-height:650px) { .showroom-toolbar { top:84px; } .showroom-path { top:135px; } .showroom-title { display:none; } .showroom-info { bottom:150px;max-height:30dvh; } .showroom-options { bottom:60px; } .showroom-options button { min-height:44px; } }

  .showroom-arrival { position:absolute;inset:0;z-index:7;display:none;place-content:center;justify-items:center;gap:22px;background:#151515;opacity:1;transition:opacity .7s,visibility .7s; }
  html[data-showroom-js] .showroom-arrival { display:grid; }
  .arrival-brand { color:var(--ivory);font:600 48px/1 var(--sans);letter-spacing:-3px; }
  .arrival-brand>span { color:var(--gold); }
  .showroom-arrival p { color:var(--gold);font:10px/1.5 var(--sans);letter-spacing:2px;text-transform:uppercase; }
  .showroom-arrival a { color:var(--ivory);font-size:12px;min-height:44px;align-content:center; }
  .showroom[data-arrival='ready'] .showroom-arrival { opacity:0;visibility:hidden;pointer-events:none; }
  .showroom:not([data-arrival='ready'])>.showroom-toolbar,.showroom:not([data-arrival='ready'])>.showroom-path,.showroom:not([data-arrival='ready'])>.showroom-title,.showroom:not([data-arrival='ready'])>.showroom-info,.showroom:not([data-arrival='ready'])>.showroom-options,.showroom:not([data-arrival='ready'])>.showroom-bottom { opacity:0; }
  .showroom[data-view='project']>.showroom-info,.showroom[data-view='project']>.showroom-options { display:none; }
  .spatial-exit { position:absolute;z-index:5;left:clamp(20px,var(--exit-x,4vw),calc(100% - 160px));top:clamp(230px,var(--exit-y,60%),calc(100% - 160px));display:flex;align-items:center;gap:12px;min-height:64px;padding:12px 16px;border:1px solid #d8bd7880!important;background:#0e2023ed!important;box-shadow:0 0 30px #d8bd7815;color:var(--gold)!important; }
  .spatial-exit:hover { border-color:var(--gold)!important;background:#172e30!important; }
  .exit-threshold { display:block;width:16px;height:27px;border:1px solid var(--gold);border-bottom:0;box-shadow:inset 3px 0 #d8bd7850; }
  .travel-indicator { position:absolute;left:var(--pad);bottom:68px;z-index:5;width:100px;height:1px;background:#ffffff25;pointer-events:none; }
  .travel-indicator>span { display:block;width:100%;height:100%;background:var(--gold);transform:scaleX(var(--travel,0));transform-origin:left; }
  .showroom[data-index-open='true'] .spatial-exit,.showroom[data-index-open='true'] .project-exhibit { visibility:hidden; }


  @media(max-width:800px) { .spatial-exit { top:185px;left:auto;right:var(--pad);min-height:44px;padding:5px 10px; } .exit-threshold { display:none; } .showroom[data-view='project'] .showroom-path [data-model-path] { max-width:53%; } }
  @media(prefers-reduced-motion:reduce) { .showroom-arrival,.showroom canvas[data-showroom-canvas] { transition:none; } }
  .showroom[data-view='project'][data-renderer='webgl'] .showroom-toolbar { display:none; }
  .showroom[data-view='project'][data-renderer='webgl'] .showroom-path { top:94px; }
</style>
