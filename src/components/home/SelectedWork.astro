---
import { getCollection } from 'astro:content';
import ProjectMedia from '../work/ProjectMedia.astro';
import { links } from '../../data/links';

const selection = [
  { slug: 'impex-automotive', href: links.workImpex },
  { slug: 'divine-health-black-onyx', href: links.workDivine },
  { slug: 'vera-skincare-concept', href: links.workVera },
];
const projects = await getCollection('projects');
const selected = selection.map(({ slug, href }) => {
  const project = projects.find(({ data }) => data.slug === slug);
  if (!project) throw new Error(`Missing selected project: ${slug}`);
  return { project, href };
});
---

<section class="selected-work" id="selected-work" aria-labelledby="selected-work-title">
  <div class="wrap">
    <div class="work-heading">
      <div>
        <p class="kicker mono">01 / Selected work</p>
        <h2 id="selected-work-title">Built around the business.</h2>
      </div>
      <a class="index-link" href={links.work}>View all projects <span aria-hidden="true">↗</span></a>
    </div>
    <div class="selection">
      {selected.map(({ project: { data }, href }, index) => (
        <article class:list={['selected-project', { 'lead-project': index === 0 }]} aria-labelledby={`selected-${data.slug}`}>
          <ProjectMedia cover={data.cover} number={String(index + 1).padStart(2, '0')} title={data.title} showCaption={false} />
          <div class="project-copy">
            <div class="project-heading">
              <p class="project-type">{data.projectType}</p>
              <h3 id={`selected-${data.slug}`}><a href={href}>{data.title}</a></h3>
            </div>
            <div class="project-summary">
              <p>{data.description}</p>
              <a class="project-link" href={href} aria-label={`View project: ${data.title}`}>View project <span aria-hidden="true">↗</span></a>
              {data.projectType === 'Independent Concept' && <a class="concept-link" href={links.workConcepts}>Explore independent concepts <span aria-hidden="true">→</span></a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .selected-work { padding-block: clamp(52px, 5vw, 80px) clamp(56px, 6vw, 96px); border-bottom: 1px solid var(--line); }
  p, h2, h3 { margin: 0; }
  .work-heading { display: flex; justify-content: space-between; align-items: end; gap: 32px; padding-bottom: 28px; border-bottom: 1px solid var(--charcoal); margin-bottom: 32px; }
  h2 { max-width: 18ch; margin-top: 20px; font-family: var(--display); font-size: clamp(48px, 6vw, 96px); font-weight: 400; line-height: .98; letter-spacing: -.035em; }
  .index-link, .project-link { display: inline-flex; align-items: center; gap: 24px; min-height: 44px; font-size: 12px; font-weight: 600; }
  .index-link { flex-shrink: 0; border-bottom: 1px solid var(--charcoal); }
  .index-link span, .project-link span { font-size: 19px; }
  .selection { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 4vw, 64px) clamp(24px, 3vw, 48px); }
  .selected-project { min-width: 0; }
  .lead-project { grid-column: 1 / -1; }
  .lead-project :global(.project-media > img), .lead-project :global(.gif-preview) { aspect-ratio: 2.1; }
  .project-copy { padding-top: 22px; }
  .project-type { margin-bottom: 10px; color: var(--gold-dark); font-size: 11px; font-weight: 600; }
  h3 { font-family: var(--display); font-size: clamp(32px, 3vw, 48px); font-weight: 400; line-height: 1.06; letter-spacing: -.025em; }
  .project-summary > p { max-width: 48em; margin-top: 16px; color: var(--body); font-size: 14px; line-height: 1.8; }
  .project-link { margin-top: 12px; }
  .concept-link { display: flex; align-items: center; gap: 18px; width: fit-content; min-height: 44px; margin-top: 4px; border-bottom: 1px solid var(--line); color: var(--gold-dark); font-size: 12px; line-height: 1.6; }
  .concept-link span { font-size: 18px; }
  .lead-project .project-copy { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; }
  .lead-project .project-summary > p { margin-top: 0; }
  @media (hover: hover) { a:hover { color: var(--gold-dark); } }
  @media (max-width: 640px) {
    .work-heading { display: block; margin-bottom: 24px; }
    h2 { font-size: clamp(44px, 10vw, 62px); }
    .index-link { margin-top: 18px; }
    .selection { grid-template-columns: 1fr; gap: 36px; }
    .lead-project .project-copy { display: block; }
    .lead-project .project-summary > p { margin-top: 16px; }
    .lead-project :global(.project-media > img), .lead-project :global(.gif-preview) { aspect-ratio: 8 / 5; }
    h3 { font-size: 36px; }
  }
</style>
