---
// A fixed seed keeps the server-rendered sky stable across visits and screenshots.
// Small SVG points need no video download, canvas loop or new dependency.
let seed = 1847;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const layers = [96, 192, 336].map((count, layer) => ({
  layer,
  stars: Array.from({ length: count }, (_, index) => ({
    // Overscan keeps the sky filled as each layer crosses the hero edges.
    x: Math.round(random() * 1640 - 100),
    y: Math.round(random() * 960 - 100),
    radius: ([1.05, 0.7, 0.4][layer] + random() * [1.1, 0.8, 0.65][layer]).toFixed(2),
    brightness: (0.4 + random() * 0.55).toFixed(2),
    twinkle: index % 5 === 0,
    gold: random() > 0.8,
    duration: (4.5 + random() * 5.5).toFixed(2),
    delay: (-random() * 18).toFixed(2),
  })),
}));
---

<div class="hero-sky" data-hero-sky data-running="false" data-paused="false">
  <div class="sky-field" aria-hidden="true">
    <svg id="home-starfield" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      {layers.map(({ layer, stars }) => (
        <g class:list={['star-drift', `depth-${layer}`]}>
          {stars.map((star) => (
            <circle class:list={['star', { 'star-gold': star.gold, 'star-twinkle': star.twinkle }]} cx={star.x} cy={star.y} r={star.radius} style={`--brightness:${star.brightness};--twinkle:${star.duration}s;--phase:${star.delay}s;`} />
          ))}
        </g>
      ))}
    </svg>
  </div>
  <button class="sky-control" type="button" data-sky-toggle aria-controls="home-starfield" hidden>
    <span class="sky-control-icon" aria-hidden="true"></span>
    <span data-sky-label>Pause background</span>
  </button>
</div>

<script>
  const sky = document.querySelector<HTMLElement>('[data-hero-sky]');
  const button = sky?.querySelector<HTMLButtonElement>('[data-sky-toggle]');
  const label = sky?.querySelector<HTMLElement>('[data-sky-label]');
  if (sky && button && label) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let userPaused = false;
    let inView = false;
    const sync = () => {
      sky.dataset.running = String(!userPaused && !reduced.matches && inView && !document.hidden);
      sky.dataset.paused = String(userPaused);
      button.hidden = reduced.matches;
      label.textContent = userPaused ? 'Resume background' : 'Pause background';
    };
    button.addEventListener('click', () => {
      userPaused = !userPaused;
      sync();
    });
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      sync();
    });
    observer.observe(sky);
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
    sync();
  }
</script>

<style>
  .hero-sky { position: absolute; inset: 0; pointer-events: none; }
  .sky-field { position: absolute; z-index: 0; inset: 0; overflow: hidden; background: radial-gradient(ellipse at 92% 30%, color-mix(in srgb, var(--gold) 4%, transparent), transparent 68%); }
  .sky-field svg { display: block; width: 100%; height: 100%; mask-image: linear-gradient(90deg, #0004, #0006 30%, #000d 65%, #000); }
  .star { fill: var(--ivory); opacity: var(--brightness); }
  .star-twinkle { animation: star-breathe var(--twinkle) ease-in-out var(--phase) infinite alternate; }
  .star-gold { fill: var(--gold); }
  .star-drift { transform-origin: center; animation: sky-drift 28s ease-in-out -8s infinite alternate; }
  .depth-1 { animation-duration: 48s; animation-delay: -19s; animation-direction: alternate-reverse; }
  .depth-2 { animation-duration: 76s; animation-delay: -46s; }
  .star, .star-drift { animation-play-state: paused; }
  [data-running='true'] .star, [data-running='true'] .star-drift { animation-play-state: running; }
  .sky-control { position: absolute; z-index: 2; right: var(--pad); bottom: 4px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 0 6px; border: 0; background: none; color: var(--on-dark-dim); font: 11px var(--sans); cursor: pointer; pointer-events: auto; }
  .sky-control[hidden] { display: none; }
  .sky-control:focus-visible { outline-offset: 1px; }
  .sky-control-icon { width: 8px; height: 9px; border-inline: 2px solid currentColor; }
  [data-paused='true'] .sky-control-icon { width: 0; height: 0; border: 5px solid transparent; border-left: 7px solid currentColor; border-right: 0; }
  @keyframes sky-drift { from { transform: translate(-84px, 56px); } to { transform: translate(96px, -64px); } }
  @keyframes star-breathe { from { opacity: calc(var(--brightness) * .45); } to { opacity: var(--brightness); } }
  @media (hover: hover) { .sky-control:hover { color: var(--ivory); } }
  @media (max-width: 640px) { .sky-field svg { mask-image: linear-gradient(90deg, #0005, #0009 58%, #000); } }
  @media (prefers-reduced-motion: reduce) {
    .star, .star-drift { animation: none; }
    .sky-control { display: none; }
  }
</style>
