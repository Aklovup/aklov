---
const { contactHref = '/#contact' } = Astro.props;

const pathname = Astro.url.pathname;
const path = pathname.length > 1 && pathname.endsWith('/') ? pathname.slice(0, -1) : pathname;
const isHome = path === '/';
const isSolutions = path.startsWith('/solutions');
const isWork = path === '/work';
const isAbout = path === '/about';
---

<div class="header-surface">
  <div class="wrap">
    <header class="top" id="site-header">
      <a class="brand" href="/" aria-label="Aklov home">aklov<i>.</i></a>

      <span class="top-note mono">Business systems studio</span>

      <button class="menu-toggle mono" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>

      <nav class="nav" id="site-nav" aria-label="Main navigation">
        <a href="/" aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href="/solutions/" aria-current={isSolutions ? 'page' : undefined}>Solutions</a>
        <a href="/work/" aria-current={isWork ? 'page' : undefined}>Work</a>
        <a href="/about/" aria-current={isAbout ? 'page' : undefined}>About</a>
        <a href={contactHref}>Let’s talk <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
  </div>
</div>

<style>
  .header-surface {
    background: var(--charcoal);
    color: var(--ivory);
  }

  .top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 26px;
    border-bottom: 1px solid var(--line-dark);
    color: var(--on-dark);
  }

  .brand {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -2px;
    line-height: 1;
    color: var(--ivory);
  }

  .brand i {
    font-style: normal;
    color: var(--gold);
  }

  .top-note {
    color: var(--on-dark-dim);
    text-align: center;
  }

  .nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 34px;
    font-size: 12px;
  }

  .nav a[aria-current='page'] { color: var(--gold); }

  .nav a:last-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 18px;
    border: 1px solid var(--stone);
    border-radius: 99px;
    color: var(--ivory);
  }

  .menu-toggle {
    display: none;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--stone);
    border-radius: 99px;
    background: transparent;
    color: var(--ivory);
    font-family: var(--sans);
    cursor: pointer;
  }

  @media (hover: hover) {
    .nav a:not(:last-child) { transition: color .2s ease; }
    .nav a:not(:last-child):hover { color: var(--gold); }

    .nav a:last-child {
      transition: background-color .2s ease, color .2s ease, border-color .2s ease;
    }

    .nav a:last-child:hover {
      background: var(--ivory);
      border-color: var(--ivory);
      color: var(--charcoal);
    }

    .menu-toggle:hover { border-color: var(--ivory); }
  }

  @media (max-width: 1000px) {
    .top { grid-template-columns: 1fr auto; }
    .top-note { display: none; }
  }

  @media (max-width: 640px) {
    .top {
      row-gap: 0;
      padding-block: 20px;
    }

    .brand { grid-area: 1 / 1; }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      grid-area: 1 / 2;
    }

    .nav {
      display: none;
      grid-area: 2 / 1 / 3 / 3;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-top: 18px;
      font-size: 14px;
    }

    .top.is-open .nav { display: flex; }

    .nav a:not(:last-child) {
      padding-block: 16px;
      border-bottom: 1px solid var(--line-dark);
    }

    .nav a:last-child {
      justify-content: space-between;
      margin-top: 18px;
      padding: 15px 20px;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = header?.querySelector('.menu-toggle');

  const setOpen = (open) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
  };

  toggle?.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
  header?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
