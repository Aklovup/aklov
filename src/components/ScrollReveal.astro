<!-- Progressive enhancement: the document is readable before and without this script. -->
<script>
 (() => {
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const elements = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
  if (!elements.length || !('IntersectionObserver' in window) || !Element.prototype.animate) return;
  const running = new Map<HTMLElement, Animation>();
  const ready = new Set<HTMLElement>();
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      const element = entry.target as HTMLElement;
      const bounds = entry.boundingClientRect;
      if (!entry.isIntersecting) continue;
      if (!ready.delete(element) || preference.matches || document.hidden) continue;
      running.get(element)?.cancel();
      const delay = Number(element.dataset.revealDelay || 0);
      const animation = element.animate([
        { opacity: .25, translate: `0 ${bounds.top < 0 ? '-12px' : '20px'}` },
        { opacity: 1, translate: '0 0' },
      ], { duration: 680, delay, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' });
      animation.id = 'editorial-reveal';
      running.set(element, animation);
      const clear = () => { if (running.get(element) === animation) running.delete(element); };
      animation.onfinish = clear;
      animation.oncancel = clear;
    }
  }, { threshold: 0, rootMargin: '0px 0px -7% 0px' });
  // A wider exit boundary provides hysteresis: reversing a few pixels at the
  // reveal threshold cannot restart the animation while someone is reading.
  const rearm = new IntersectionObserver((entries) => {
    for (const entry of entries) if (!entry.isIntersecting) ready.add(entry.target as HTMLElement);
  }, { rootMargin: '72px 0px' });

  // Never animate the initially visible hero, LCP, forms, or immersive scene.
  for (const element of elements) {
    const bounds = element.getBoundingClientRect();
    if (bounds.top >= innerHeight || bounds.bottom <= 0) ready.add(element);
    observer.observe(element);
    rearm.observe(element);
  }
  const settle = () => {
    for (const animation of running.values()) animation.cancel();
    running.clear();
  };
  preference.addEventListener('change', () => { if (preference.matches) settle(); });
  document.addEventListener('visibilitychange', () => { if (document.hidden) settle(); });
  document.addEventListener('focusin', (event) => {
    // Keyboard focus always gets an immediate, stationary target.
    const target = event.target as HTMLElement;
    for (const [element, animation] of running) {
      if (element === target || element.contains(target)) animation.cancel();
    }
    for (const element of elements) if (element === target || element.contains(target)) ready.delete(element);
  });
  window.addEventListener('pagehide', settle);
 })();
</script>
