---
interface Project { slug:string; title:string; category:string; type:string; src?:string; }
interface Props { projects:Project[]; }
const { projects }=Astro.props;
---
<div class="sculpture" data-sculpture>
  <svg class="sculpture-fallback" viewBox="0 0 1440 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="archive-sky" x2="0" y2="1"><stop stop-color="#101c20"/><stop offset="1" stop-color="#313b38"/></linearGradient>
      <linearGradient id="archive-stone"><stop stop-color="#080e11"/><stop offset=".8" stop-color="#273333"/><stop offset="1" stop-color="#967b43"/></linearGradient>
    </defs>
    <rect width="1440" height="1000" fill="url(#archive-sky)"/>
    <path d="M0 700L720 480L1440 700V1000H0Z" fill="#101b1d"/>
    {[0,1,2,3].map(i=><g opacity={1-i*.18} transform={`translate(${i*110} ${i*60}) scale(${1-i*.13})`}><path d="M370 710V180H1040V710H990V235H420V710Z" fill="url(#archive-stone)"/><path d="M420 700V235H990" fill="none" stroke="#d8bd78" stroke-width="3"/></g>)}
    {projects[0].src && <image data-world-fallback-image href={projects[0].src} x="470" y="320" width="460" height="260" preserveAspectRatio="xMidYMin slice"/>}
  </svg>
  <canvas data-sculpture-canvas aria-hidden="true"></canvas>
  <div class="world-shade" aria-hidden="true"></div>
  <script type="application/json" id="world-projects" set:html={JSON.stringify(projects).replace(/</g,'\u003c')} />
</div>
<style>
  .sculpture { position:absolute; inset:0; }
  canvas,.sculpture-fallback { position:absolute; width:100%; height:100%; inset:0; }
  canvas { touch-action:pan-y pinch-zoom; cursor:grab; opacity:0; transition:opacity 1s ease; }
  :global([data-dragging='true']) canvas { cursor:grabbing; }
  .sculpture[data-renderer='webgl'] canvas { opacity:1; }
  .sculpture[data-renderer='webgl'] .sculpture-fallback { visibility:hidden; }
  .world-shade { position:absolute; inset:0; pointer-events:none; background:linear-gradient(0deg,#05090be6,transparent 48%,#05090b40),linear-gradient(90deg,#05090b60,transparent 45%); }
</style>
<script>
  import { mountSculpture } from '../../scripts/kineticSculpture';
  const root=document.querySelector<HTMLElement>('[data-sculpture]');
  if(root) mountSculpture(root);
</script>
