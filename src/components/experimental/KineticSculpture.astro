<div class="sculpture" data-sculpture>
  <div class="sculpture-shadow" aria-hidden="true"></div>
  <svg class="sculpture-fallback" viewBox="0 0 800 700" aria-hidden="true">
    <defs>
      <linearGradient id="metal-fallback" x1="0" x2="1" y1="0" y2=".8">
        <stop stop-color="#5a4427"/><stop offset=".22" stop-color="#f5e5b6"/><stop offset=".48" stop-color="#b48e4d"/><stop offset=".7" stop-color="#fff8dc"/><stop offset="1" stop-color="#6b512c"/>
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#metal-fallback)" stroke-width="66" transform="translate(400 345) rotate(-24)">
      <ellipse rx="185" ry="108" transform="rotate(0) translate(0 -75)"/>
      <ellipse rx="185" ry="108" transform="rotate(120) translate(0 -75)"/>
      <ellipse rx="185" ry="108" transform="rotate(240) translate(0 -75)"/>
    </g>
  </svg>
  <canvas data-sculpture-canvas aria-hidden="true"></canvas>
</div>

<style>
  .sculpture { position: absolute; inset: 4% -14% 0 14%; pointer-events: none; }
  canvas, .sculpture-fallback { position: absolute; width: 100%; height: 100%; inset: 0; }
  canvas { opacity: 0; transition: opacity .8s ease; }
  .sculpture[data-renderer='webgl'] canvas { opacity: 1; }
  .sculpture[data-renderer='webgl'] .sculpture-fallback { visibility: hidden; }
  .sculpture-shadow { position: absolute; width: 36%; height: 8%; left: 32%; bottom: 8%; background: radial-gradient(ellipse, #70634a36, transparent 70%); filter: blur(16px); }
  @media(max-width: 800px) { .sculpture { inset: 12% -20% 25% -20%; } }
</style>

<script>
  import { mountSculpture } from '../../scripts/kineticSculpture';
  const root = document.querySelector<HTMLElement>('[data-sculpture]');
  if (root) mountSculpture(root);
</script>
