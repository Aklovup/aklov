---
import { Image } from 'astro:assets';
import { profile } from '../../data/about';

const { portrait } = profile;
const [firstName, ...surname] = profile.name.split(' ');
// One shared contour keeps the gold trim attached to the ivory panel.
const contour = 'M0 90 C180 -10 300 25 510 165 S760 185 850 260 S940 355 1000 350';
---

<figure class="portrait" data-about-portrait>
  <div class="portrait-frame">
    {portrait.src ? (
      <>
      <Image
        src={portrait.src}
        alt={portrait.alt}
        width={portrait.width}
        height={portrait.height}
        widths={[480, 760, 1200]}
        sizes="(max-width: 640px) 80vw, (max-width: 1000px) 40vw, 38vw"
        loading="eager"
        decoding="async"
      />
      <div class="portrait-signature">
        <svg class="signature-panel" viewBox="0 0 1000 430" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path class="signature-fill" d={`${contour} L1000 430 H0 Z`} />
          <path class="signature-edge" d={contour} />
        </svg>
        <span class="portrait-name"><span>{firstName}</span> <span>{surname.join(' ')}</span></span>
      </div>
      </>
    ) : (
      <div class="portrait-fallback" role="img" aria-label="Typographic profile of Loveth Akpochimora; portrait photograph pending.">
        <span class="monogram" aria-hidden="true">LA</span>
        <span class="fallback-name" aria-hidden="true">{profile.name}</span>
      </div>
    )}
  </div>
  <figcaption>
    <span class="designation">{profile.designation}</span>
  </figcaption>
</figure>

<style>
  .portrait { margin: 0; }
  .portrait-frame { position: relative; container-type: inline-size; aspect-ratio: 4 / 5; background: var(--gold); overflow: hidden; }
  .portrait-frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; }
  .portrait-fallback { position: relative; display: flex; flex-direction: column; justify-content: space-between; height: 100%; min-height: 0; padding: clamp(24px, 3vw, 48px); background: var(--gold); color: var(--charcoal); }
  .portrait-fallback::before { content: ""; position: absolute; inset: 14px; border: 1px solid color-mix(in srgb, var(--charcoal) 35%, var(--gold)); pointer-events: none; }
  .monogram { display: block; padding-top: 12px; font-family: var(--display); font-size: clamp(160px, 24vw, 400px); line-height: .85; letter-spacing: -.07em; }
  .fallback-name { position: relative; max-width: 12ch; font-family: var(--display); font-size: clamp(30px, 3.6vw, 58px); line-height: 1; letter-spacing: -.025em; }
  figcaption { display: grid; gap: 10px; padding-top: 20px; border-top: 1px solid var(--line-dark); margin-top: 20px; }
  .portrait-signature { position: absolute; inset: auto 0 0; height: 34%; color: var(--charcoal); }
  .signature-panel { position: absolute; inset: 0; display: block; width: 100%; height: 100%; overflow: visible; }
  .signature-fill { fill: var(--ivory); }
  .signature-edge { fill: none; stroke: var(--gold); stroke-width: 7; }
  .portrait-name { position: absolute; left: clamp(20px, 6cqw, 44px); bottom: clamp(18px, 5cqw, 36px); max-width: calc(100% - 40px); font-family: var(--display); font-size: clamp(30px, 10.5cqw, 62px); font-style: italic; line-height: .92; letter-spacing: -.025em; }
  .portrait-name > span { display: block; }
  .designation { max-width: 30ch; color: var(--on-dark); font-size: 13px; line-height: 1.6; }
  @media (max-width: 640px) { .monogram { font-size: clamp(150px, 46vw, 240px); } .fallback-name { font-size: clamp(30px, 9vw, 44px); } }
</style>
