---
import { Image } from 'astro:assets';
import { profile } from '../../data/about';

const { portrait } = profile;
---

<figure class="portrait" data-about-portrait>
  {portrait.src ? (
    <Image
      src={portrait.src}
      alt={portrait.alt}
      width={portrait.width}
      height={portrait.height}
      loading="eager"
      decoding="async"
    />
  ) : (
    <div class="portrait-fallback" role="img" aria-label={`Portrait of ${profile.name}; photograph pending.`}>
      <span class="monogram" aria-hidden="true">LA</span>
    </div>
  )}
</figure>

<style>
  /* Only the lower torso dissolves into the charcoal name baseline. */
  .portrait { margin: 0; aspect-ratio: 447 / 558; mask-image: linear-gradient(to bottom, #000 0 52%, rgb(0 0 0 / .72) 65%, transparent 82%); }
  .portrait img { display: block; width: 100%; height: auto; }
  .portrait-fallback { display: grid; place-items: center; height: 100%; color: var(--gold); }
  .monogram { font-family: var(--display); font-size: clamp(120px, 24vw, 320px); line-height: 1; letter-spacing: -.07em; }
</style>

