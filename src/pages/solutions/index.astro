---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { links } from '../../data/links';
import { mediaPreview } from '../../lib/media';
import SystemsDrawing from '../../components/solutions/SystemsDrawing.astro';

const sectionImage = mediaPreview('/images/solutions/Solutions_img.jpg')!;

const solutions = [
  {
    number: '01',
    id: 'website',
    title: 'Website Design & Development',
    tagline: 'Give your business a stronger online presence.',
    paragraphs: [
      'Your website should make it easier for the right people to understand what you offer, trust your business and take the next step.',
      'I design and develop websites that combine clear messaging, distinctive visual design, responsive layouts and purposeful user journeys.',
    ],
    includes: [
      'Business and service websites',
      'Landing pages designed around a clear goal',
      'Website redesigns and improvements',
      'Mobile-responsive layouts',
      'Contact forms and enquiry pathways',
      'Website integrations and functional enhancements',
    ],
    goal: 'A website that represents your business well and gives visitors a clear path forward.',
    cta: 'Discuss a Website Project',
    subject: 'Website project',
    projectsLabel: 'View Website Projects',
    projectsHref: links.workWebsite,
  },
  {
    number: '02',
    id: 'customer',
    title: 'Customer & Sales Systems',
    tagline: 'Keep customer relationships and sales activity organized.',
    paragraphs: [
      'When enquiries, conversations, follow-ups and customer information are scattered across different places, opportunities can slip through the cracks.',
      'I build and improve systems that help businesses organize customer information, manage sales activity and create a more consistent process from first enquiry to ongoing relationship.',
    ],
    includes: [
      'Lead capture and organization',
      'Sales pipelines and deal tracking',
      'Follow-up reminders and task assignment',
      'Customer onboarding workflows',
      'Customer records and activity tracking',
      'CRM configuration and process improvement',
    ],
    goal: 'Better visibility into customer relationships, clearer next steps and a more reliable sales process.',
    cta: 'Discuss Customer & Sales Systems',
    subject: 'Customer and sales systems',
    projectsLabel: 'View CRM Projects',
    projectsHref: links.workCustomer,
  },
  {
    number: '03',
    id: 'workflow',
    title: 'Workflow Automation',
    tagline: 'Spend less time repeating work that can be handled more efficiently.',
    paragraphs: [
      'Repetitive tasks, manual handoffs and disconnected processes can consume time that should be spent serving customers and running the business.',
      'I identify opportunities to simplify everyday work, then build workflows that move information and tasks between the right people and systems.',
    ],
    includes: [
      'Automated notifications and reminders',
      'Form submissions that trigger follow-up actions',
      'Task assignment and status updates',
      'Approval and review workflows',
      'Email and business application integrations',
      'Automated data handling and routine reporting',
    ],
    goal: 'Less avoidable manual work, more consistent processes and fewer tasks falling through the cracks.',
    cta: 'Discuss Workflow Automation',
    subject: 'Workflow automation',
    projectsLabel: 'View Automation Projects',
    projectsHref: links.workAutomation,
  },
  {
    number: '04',
    id: 'applications',
    title: 'Custom Business Applications',
    tagline: 'Build tools around the way your business actually operates.',
    paragraphs: [
      'Sometimes an off-the-shelf application does not fit the process you need to manage. Your team may rely on spreadsheets, workarounds or several separate tools to complete one task.',
      'I build purpose-specific applications that organize information, support business processes and give teams a more suitable way to get work done.',
    ],
    includes: [
      'Internal business applications',
      'Operational and data-entry tools',
      'Request and approval systems',
      'Service delivery and job-tracking applications',
      'Custom forms, dashboards and record management',
      'Connections to existing business systems',
    ],
    goal: 'A more suitable way to manage work without forcing every process into a generic solution.',
    cta: 'Discuss a Custom Application',
    subject: 'Custom business application',
    projectsLabel: 'View Application Projects',
    projectsHref: links.workApplications,
  },
  {
    number: '05',
    id: 'integrations',
    title: 'Integrations & Reporting',
    tagline: 'Bring your tools and business information closer together.',
    paragraphs: [
      'When business applications operate in isolation, people end up copying data, switching between platforms and assembling reports manually.',
      'I connect relevant systems and improve how information moves between them, helping businesses reduce unnecessary duplication and get a clearer view of their operations.',
    ],
    includes: [
      'Connections between business applications',
      'API-based integrations',
      'Synchronization of relevant records',
      'Automated data transfer and updates',
      'Operational dashboards and reports',
      'Data consolidation and visibility improvements',
    ],
    goal: 'Better-connected tools, more accessible information and clearer operational visibility.',
    cta: 'Discuss Your Integration Needs',
    subject: 'Integrations and reporting',
    projectsLabel: 'View Integration & Reporting Projects',
    projectsHref: links.workIntegrations,
  },
];

const steps = [
  {
    number: '01',
    title: 'Understand',
    description: 'I start by learning how your business works today, what is getting in the way and what a better outcome would look like.',
  },
  {
    number: '02',
    title: 'Design',
    description: 'I define a practical solution around your requirements, existing tools, team and priorities.',
  },
  {
    number: '03',
    title: 'Build',
    description: 'I implement the website, workflow, application or integration with the intended users and real working conditions in mind.',
  },
  {
    number: '04',
    title: 'Test and refine',
    description: 'I check that the solution behaves as expected, address issues and refine the experience before handover.',
  },
];
---

<BaseLayout
  title="Solutions — Aklov®"
  description="Aklov designs digital experiences and builds connected business solutions: websites, customer and sales systems, workflow automation, custom applications, integrations and reporting."
  contactHref="#contact"
>
  <!-- Hero -->
  <section class="hero-surface" aria-labelledby="page-title">
    <div class="wrap hero">
      <div class="hero-meta mono">
        <span>What I help businesses do</span>
        <span>Solutions / Aklov</span>
      </div>
      <h1 id="page-title">
        <span class="l1">Better ways to run,</span>
        <span class="l2"><em>connect and grow</em></span>
        <span class="l3"> your business.</span>
      </h1>
      <div class="hero-composition">
        <div class="hero-introduction">
          <div class="hero-copy-block">
            <p class="hero-copy">
              A business needs more than individual tools. It needs a website that communicates its value, workflows that keep work moving, and systems that help people stay organized.
            </p>
            <p class="hero-copy">
              Aklov designs digital experiences and builds connected business solutions around the way your business actually works.
            </p>
          </div>
          <div class="hero-actions">
            <a class="btn btn-dark" href={links.contact}>Discuss Your Project <span aria-hidden="true">↗</span></a>
            <a class="hero-explore" href="#solutions">Explore My Solutions <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-art"><SystemsDrawing /></div>
      </div>
      <nav class="idx" aria-label="My solutions">
        <div class="idx-top mono">Explore My Solutions</div>
        <div class="idx-links">
          {solutions.map((s) => (
            <a class="idx-row" href={`#${s.id}`}>
              <span class="idx-n">{s.number}</span>
              <span class="idx-t">{s.title}</span>
              <span class="idx-a" aria-hidden="true">↓</span>
            </a>
          ))}
        </div>
      </nav>
    </div>
  </section>

  <!-- Introduction -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="wrap">
      <div class="kicker mono">The right solution starts with the problem</div>
      <h2 id="intro-title">When the way you work starts <em>holding you back.</em></h2>

      <div class="intro-grid">
        <p class="intro-big">
          As a business grows, the gaps become harder to ignore. A website no longer reflects the quality of the business. Enquiries get missed. Teams repeat the same manual tasks. Information lives in different places, and simple processes take more effort than they should.
        </p>

        <div class="intro-side">
          <p>These problems often have something in common: the way things are connected, organized or presented needs to improve.</p>
          <p>I help businesses address those gaps through thoughtful website design, practical business systems, workflow automation and integrations built around their needs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solutions intro -->
  <div class="sols-head" id="solutions">
    <div class="wrap sols-head-grid">
      <figure class="sols-figure">
        <img src={sectionImage.src} srcset={sectionImage.srcset} sizes="(max-width: 1000px) calc(100vw - 40px), 42vw" width={sectionImage.width} height={sectionImage.height} alt="" loading="lazy" decoding="async" />
      </figure>

      <div class="sols-head-text">
        <div class="kicker mono">What I can help with</div>
        <h2>Practical solutions for the work <em>behind your business.</em></h2>
      </div>
    </div>
  </div>

  <!-- A continuous service catalogue, with stable anchors and shared alignment. -->
  <div class="service-catalogue">
    {solutions.map((s) => (
      <section class="sol" id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="wrap">
          <div class="sol-summary">
            <div class="sol-top">
              <span class="sol-num mono" aria-hidden="true">{s.number}</span>
              <h2 class="sol-title" id={`${s.id}-title`}>{s.title}</h2>
            </div>
            <div class="sol-lead">
              <p class="sol-tag">{s.tagline}</p>
              {s.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          </div>

          <div class="sol-body">
            <div class="sol-list">
              <h3 class="mono">What this can include:</h3>
              <ul>{s.includes.map((item) => <li>{item}</li>)}</ul>
            </div>
            <div class="sol-goal">
              <div>
                <span class="mono">The goal</span>
                <p>{s.goal}</p>
              </div>
              <div class="sol-actions">
                <a class="btn btn-line" href={links.contact} aria-label={s.cta}>
                  {s.cta} <span aria-hidden="true">↗</span>
                </a>
                <a class="text-link" href={s.projectsHref}>
                  {s.projectsLabel} <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>

  <!-- Approach -->
  <section class="section approach" aria-labelledby="approach-title">
    <div class="wrap">
      <div class="kicker mono">My approach</div>
      <h2 id="approach-title">Understand the work before changing the system.</h2>

      <div class="steps">
        {steps.map((step) => (
          <article class="step">
            <div class="step-n" aria-hidden="true">{step.number}</div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </article>
        ))}
      </div>

      <p class="approach-note">
        Every project is different. The process should fit the problem rather than introduce unnecessary complexity.
      </p>
    </div>
  </section>

  <!-- Choosing the right solution -->
  <section class="section choose" aria-labelledby="choose-title">

    <div class="wrap">
      <div class="kicker mono">Not sure where to start?</div>
      <h2 id="choose-title">You don’t need to know the <em>technical answer</em> yet.</h2>

      <div class="choose-grid">
        <p>
          You might know that your website needs work, that your team is spending too much time on manual tasks, or that your business tools are not working well together. You do not need to arrive with a complete technical specification.
        </p>

        <div>
          <p>
            Tell me what is happening, what you would like to improve and what you have already tried. Together, we can explore the requirements and determine a sensible direction.
          </p>

          <div class="choose-cta">
            <a class="btn btn-gold" href={links.contact}>
              Tell Me What Needs to Work Better <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="closing" id="contact" aria-labelledby="closing-title">
    <div class="wrap">
      <div class="kicker mono">Let’s talk about your business</div>
      <h2 id="closing-title">What would you change if your <em>systems worked better?</em></h2>

      <div class="closing-grid">
        <div>
          <p>Whether you need a stronger website, a more reliable workflow or a better-connected operation, the first step is understanding the challenge.</p>
          <p>Let’s discuss what you need and work out a practical way forward.</p>
        </div>

        <div class="closing-act">
          <a class="btn btn-dark" href={links.contact}>
            Start a Conversation <span aria-hidden="true">↗</span>
          </a>
          <p>Tell me about your project, your current challenges and the outcome you want to achieve.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1, h2, h3, h4, p, ul, figure { margin: 0; }

  /* A wide ivory drawing plate gives Solutions its own opening composition. */
  .hero-surface { background: var(--ivory); color: var(--charcoal); --focus-color: var(--charcoal); border-bottom: 1px solid var(--line); }
  .hero { padding-block: clamp(40px, 4.5vw, 72px) 0; }
  .hero-meta { display: flex; justify-content: space-between; gap: 24px; margin-bottom: 30px; color: var(--gold-dark); }
  .hero-meta span:last-child { color: var(--body); text-align: right; }
  .hero h1 { font-family: var(--display); font-size: clamp(54px, 7.3vw, 126px); font-weight: 400; line-height: .98; letter-spacing: -.04em; }
  .hero h1 .l1 { display: block; }
  .hero h1 .l2 { padding-left: clamp(20px, 4.2vw, 76px); }
  .hero h1 .l3 { margin-left: .1em; }
  .hero h1 em { color: #a5852e; font-style: italic; }
  .hero-composition { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); align-items: center; gap: clamp(32px, 4vw, 64px); padding-block: 12px 24px; }
  .hero-introduction { min-width: 0; }
  .hero-copy-block { max-width: 52ch; }
  .hero-copy { color: var(--body); font-size: 16px; line-height: 1.8; }
  .hero-copy + .hero-copy { margin-top: 18px; color: var(--charcoal); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 28px; margin-top: 26px; }
  .hero-explore { display: inline-flex; align-items: center; gap: 20px; min-height: 44px; border-bottom: 1px solid var(--line); font-size: 12px; font-weight: 600; }
  .hero-explore span { font-size: 18px; }
  .hero-art { width: 100%; max-width: 800px; justify-self: end; }
  .idx { width: 100%; min-width: 0; padding-block: 22px 26px; border-top: 1px solid var(--line); color: var(--charcoal); background: transparent; --focus-color: var(--charcoal); }
  .idx-top { margin-bottom: 16px; color: var(--gold-dark); font-size: 9px; }
  .idx-links { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .idx-row { min-width: 0; display: grid; grid-template-columns: 20px minmax(0, 1fr) 20px; gap: 10px; align-items: baseline; min-height: 64px; padding: 8px 20px; border-left: 1px solid var(--line); }
  .idx-row:first-child { border-left: 0; padding-left: 0; }
  .idx-row:last-child { padding-right: 0; }
  .idx-n { color: var(--gold-dark); font-size: 10px; }
  .idx-t { overflow-wrap: anywhere; font-family: var(--display); font-size: clamp(20px, 1.7vw, 28px); line-height: 1.12; }
  .idx-a { color: var(--gold-dark); font-size: 16px; }

  /* Introduction */

  .section { padding-block: clamp(56px, 6vw, 100px); }

  .intro h2,
  .sols-head h2,
  .choose h2,
  .approach h2,
  .closing h2 {
    font-family: var(--display);
    font-weight: 400;
    letter-spacing: -.04em;
  }

  .intro { padding-block: clamp(44px, 4.5vw, 72px); }
  .intro h2 { max-width: 18ch; margin-top: 24px; font-size: clamp(48px, 5.3vw, 88px); line-height: .98; }
  .intro h2 em, .sols-head h2 em { color: var(--gold-dark); font-style: italic; }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
    gap: clamp(40px, 7vw, 120px);
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--charcoal);
  }

  .intro-big { font-family: var(--display); font-size: clamp(26px, 2.4vw, 38px); line-height: 1.28; letter-spacing: -.02em; }
  .intro-side p { max-width: 460px; color: var(--body); font-size: 14.5px; line-height: 1.95; }
  .intro-side p + p { margin-top: 22px; color: var(--charcoal); }

  /* Solutions intro: image + heading */

  .sols-head {
    padding-block: clamp(36px, 4vw, 64px) clamp(48px, 5vw, 80px);
    background: var(--ivory);
  }

  .sols-head-grid {
    display: grid;
    grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 6vw, 100px);
    align-items: end;
  }

  .sols-figure {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 760px;
    overflow: hidden;
    background: var(--charcoal);
  }

  .sols-figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.7) contrast(1.05) sepia(.2);
  }

  .sols-figure::after {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid rgba(216, 189, 120, .5);
    pointer-events: none;
  }

  .sols-head-text { padding-bottom: 6px; }
  .sols-head-text h2 { max-width: 11ch; margin-top: 30px; font-size: clamp(50px, 7.4vw, 132px); line-height: .9; text-align: left; }

  /* Reference rows: the content provides variation; alignment stays predictable. */
  .service-catalogue { background: var(--ivory); }
  .sol { scroll-margin-top: 24px; }
  .sol > .wrap { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(40px, 8vw, 130px); padding-block: clamp(48px, 5vw, 80px); border-top: 1px solid var(--line); }
  .sol-summary, .sol-body { min-width: 0; }
  .sol-top { margin-bottom: 28px; }
  .sol-num { display: block; margin-bottom: 20px; color: var(--gold-dark); }
  .sol-title { max-width: 17ch; font-family: var(--display); font-size: clamp(42px, 4.4vw, 70px); font-weight: 400; line-height: 1; letter-spacing: -.035em; }
  .sol-tag { max-width: 28ch; margin-bottom: 22px; font-family: var(--display); font-size: clamp(26px, 2.3vw, 34px); line-height: 1.2; letter-spacing: -.02em; }
  .sol-lead p:not(.sol-tag) { max-width: 56ch; color: var(--body); font-size: 15px; line-height: 1.9; }
  .sol-lead p + p { margin-top: 18px; }
  .sol-list h3 { margin-bottom: 18px; color: var(--gold-dark); }
  .sol-list ul { padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .sol-list li { padding: 15px 0; border-bottom: 1px solid var(--line); font-size: 15px; line-height: 1.6; }
  .sol-goal { margin-top: 30px; }
  .sol-goal .mono { display: block; margin-bottom: 12px; color: var(--gold-dark); }
  .sol-goal p { max-width: 34ch; font-family: var(--display); font-size: clamp(24px, 2vw, 30px); line-height: 1.2; letter-spacing: -.02em; }
  .sol-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 28px; margin-top: 26px; }
  .sol-actions .btn { height: auto; padding-block: 14px; line-height: 1.5; }
  .text-link { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; padding-bottom: 2px; border-bottom: 1px solid currentColor; font-size: 12px; font-weight: 600; }
  .text-link span { font-family: var(--display); font-size: 20px; line-height: 1; }

  /* Approach */

  .approach { background: var(--paper-deep); }
  .approach h2 { max-width: 23ch; margin: 24px 0 clamp(32px, 4vw, 56px); font-size: clamp(44px, 4.8vw, 76px); line-height: 1; }

  .steps { display: grid; grid-template-columns: repeat(4, 1fr); align-items: stretch; }
  .step { padding: 24px 26px 20px 0; border-top: 1px solid var(--charcoal); }
  .step + .step { padding-left: 26px; border-left: 1px solid var(--charcoal); }

  .step-n { margin-bottom: 24px; color: var(--gold-dark); font-family: var(--display); font-size: 48px; line-height: 1; letter-spacing: -.04em; }

  .step h3 { margin-bottom: 14px; font-family: var(--display); font-size: clamp(28px, 2.8vw, 44px); font-weight: 400; line-height: 1; }
  .step p { max-width: 300px; color: var(--body); font-size: 13.5px; line-height: 1.9; }

  .approach-note {
    max-width: 52ch;
    margin-top: 32px;
    font-family: var(--display);
    font-size: clamp(26px, 2.6vw, 38px);
    font-style: italic;
    line-height: 1.15;
    letter-spacing: -.02em;
  }

  /* Guidance belongs to the process surface, rather than another dark band. */
  .choose { background: var(--paper-deep); color: var(--charcoal); padding-top: 0; --focus-color: var(--charcoal); }
  .choose > .wrap { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 24px clamp(40px, 8vw, 130px); padding-top: clamp(36px, 4vw, 56px); border-top: 1px solid var(--line); }
  .choose .kicker { grid-column: 1 / -1; }
  .choose h2 { max-width: 17ch; font-size: clamp(40px, 4.1vw, 64px); line-height: 1.02; }
  .choose h2 em { color: var(--gold-dark); font-style: italic; }
  .choose-grid { display: grid; gap: 22px; }
  .choose-grid p { max-width: 60ch; color: var(--body); font-size: 15px; line-height: 1.9; }
  .choose-cta { margin-top: 26px; }

  /* Closing */

  .closing { padding-block: clamp(56px, 6vw, 100px) 0; background: var(--gold); color: var(--charcoal); }
  .closing .kicker { color: var(--charcoal); }
  .closing h2 { max-width: 19ch; margin-top: 26px; font-size: clamp(52px, 7.5vw, 120px); line-height: .96; letter-spacing: -.035em; }
  .closing h2 em { font-style: italic; }

  .closing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 6vw, 100px);
    margin-top: clamp(32px, 4vw, 56px);
    padding-block: 36px 60px;
    border-top: 1px solid var(--charcoal);
  }

  .closing-grid > div:first-child p { max-width: 430px; font-size: 15px; line-height: 1.95; }
  .closing-grid > div:first-child p + p { margin-top: 18px; }
  .closing-act .btn { margin-bottom: 22px; }
  .closing-act p { max-width: 380px; font-size: 13px; line-height: 1.9; }

  /* Hover (pointer devices) */

  @media (hover: hover) {
    .text-link span { transition: transform .2s ease; }
    .text-link:hover span { transform: translateX(4px); }
    .idx-a { transition: transform .2s ease; }
    .idx-row:hover .idx-a { transform: translateY(3px); }
    .idx-row:hover .idx-t { color: var(--gold-dark); }
    .hero-explore:hover { color: var(--gold-dark); border-color: var(--gold-dark); }

  }

  /* Tablet */

  @media (max-width: 1000px) {
    .hero-composition { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; padding-block: 28px; }
    .hero h1 { font-size: clamp(52px, 7.2vw, 74px); }
    .hero h1 span { display: block; }
    .hero h1 .l3 { margin-left: 0; }
    .hero-copy-block { max-width: 720px; }
    .hero-actions { flex-direction: row; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
    .idx-links { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .idx-row { border-left: 0; padding: 14px 0; border-bottom: 1px solid var(--line); }
    .idx-row:nth-child(even) { padding-left: 24px; }
    .idx-t { font-size: 24px; }

    .intro-grid,
    .choose-grid,
