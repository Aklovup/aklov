
---
const services = [
  {
    number: "01",
    title: "Customer & sales systems",
    description: "Build reliable ways to manage enquiries, customer relationships and the work that moves opportunities forward."
  },
  {
    number: "02",
    title: "Workflow automation",
    description: "Connect repetitive tasks, handoffs and business processes so work moves with less manual effort."
  },
  {
    number: "03",
    title: "Custom business applications",
    description: "Create practical tools around the way your business operates, including internal apps and tailored workflows."
  },
  {
    number: "04",
    title: "Integrations & reporting",
    description: "Bring disconnected tools together and make operational information easier to track and understand."
  }
];

const principles = [
  ["Understand the work", "We start with the real process, the people involved and where things currently break down."],
  ["Design the right system", "The structure follows your business needs, not a collection of features looking for a purpose."],
  ["Build and improve", "Implement the workflow, test it against real scenarios and refine it for everyday use."]
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151515" />
    <meta name="description" content="Aklov helps growing businesses improve their operations through better systems, workflow automation and custom business applications." />
    <title>Aklov — Better systems for the way business works</title>
    <style>
      :root {
        --ink: #151515;
        --paper: #f5f2ea;
        --gold: #d8bd78;
        --muted: #a7a49c;
        --line: rgba(245, 242, 234, .17);
        --dark-panel: #20201e;
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: Arial, Helvetica, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      a { color: inherit; text-decoration: none; }

      .shell {
        width: min(1160px, calc(100% - 48px));
        margin: 0 auto;
      }

      .top {
        background: var(--ink);
        color: var(--paper);
      }

      header {
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        border-bottom: 1px solid var(--line);
      }

      .wordmark {
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -1.7px;
      }

      .wordmark span { color: var(--gold); }

      nav {
        display: flex;
        align-items: center;
        gap: 27px;
        font-size: 13px;
        color: #d0cec7;
      }

      nav a:hover { color: var(--gold); }

      .nav-cta {
        border: 1px solid #77736a;
        padding: 12px 15px;
        color: var(--paper);
      }

      .hero {
        padding: 105px 0 95px;
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        align-items: end;
        gap: 70px;
      }

      .eyebrow {
        display: flex;
        align-items: center;
        gap: 11px;
        color: var(--gold);
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 2px;
        font-weight: 700;
      }

      .eyebrow::before {
        content: "";
        width: 25px;
        height: 1px;
        background: currentColor;
      }

      h1 {
        max-width: 760px;
        margin: 27px 0 24px;
        font-size: clamp(48px, 7vw, 82px);
        line-height: .99;
        letter-spacing: -5px;
        font-weight: 600;
      }

      h1 em {
        color: var(--gold);
        font-style: normal;
      }

      .hero-copy {
        max-width: 465px;
        color: #c2bfb7;
        font-size: 16px;
        line-height: 1.85;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
      }

      .button {
        min-height: 49px;
        padding: 15px 19px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
      }

      .button-primary {
        background: var(--gold);
        color: var(--ink);
      }

      .button-secondary {
        border: 1px solid #66635c;
        color: var(--paper);
      }

      .hero-aside {
        border-top: 1px solid #77736a;
        padding-top: 22px;
        padding-bottom: 7px;
      }

      .aside-label {
        color: var(--muted);
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: 1.8px;
      }

      .hero-aside p {
        font-size: 20px;
        line-height: 1.55;
        margin: 19px 0 26px;
      }

      .aside-note {
        color: var(--gold);
        font-size: 12px;
      }

      .ticker {
        border-top: 1px solid var(--line);
        padding: 21px 0;
        color: #b6b2a9;
        font-size: 11px;
        letter-spacing: 1.4px;
        text-transform: uppercase;
      }

      .ticker-inner {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
      }

      .section {
        padding: 100px 0;
      }

      .section-heading {
        display: grid;
        grid-template-columns: .8fr 1.2fr;
        gap: 55px;
        margin-bottom: 48px;
      }

      .section-label {
        color: #756b52;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 1.8px;
        font-weight: 700;
      }

      h2 {
        margin: 0;
        font-size: clamp(34px, 4.5vw, 53px);
        line-height: 1.08;
        letter-spacing: -2px;
        font-weight: 600;
      }

      .section-intro {
        max-width: 600px;
        color: #66645e;
        line-height: 1.8;
        margin: 18px 0 0;
        font-size: 15px;
      }

      .service-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-top: 1px solid #d6d1c5;
      }

      .service {
        padding: 30px 30px 32px 0;
        border-bottom: 1px solid #d6d1c5;
      }

      .service:nth-child(even) {
        padding-left: 30px;
        border-left: 1px solid #d6d1c5;
      }

      .service-number {
        font-size: 11px;
        color: #8d7a4b;
        letter-spacing: 1px;
      }

      .service h3 {
        font-size: 22px;
        letter-spacing: -.6px;
        margin: 24px 0 12px;
      }

      .service p {
        max-width: 440px;
        color: #68665f;
        font-size: 14px;
        line-height: 1.8;
        margin: 0;
      }

      .approach {
        background: #e9e5db;
      }

      .principles {
        border-top: 1px solid #cec8ba;
      }

      .principle {
        display: grid;
        grid-template-columns: 70px .8fr 1.2fr;
        gap: 25px;
        align-items: start;
        padding: 27px 0;
        border-bottom: 1px solid #cec8ba;
      }

      .principle-number {
        color: #8d7a4b;
        font-size: 12px;
      }

      .principle h3 {
        font-size: 18px;
        margin: 0;
        font-weight: 600;
      }

      .principle p {
        margin: 0;
        color: #68665f;
        font-size: 14px;
        line-height: 1.8;
      }

      .contact {
        background: var(--ink);
        color: var(--paper);
        padding: 86px 0;
      }

      .contact-inner {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 40px;
      }

      .contact h2 {
        max-width: 650px;
        margin-top: 24px;
      }

      .contact p {
        max-width: 470px;
        color: #bcb9b1;
        line-height: 1.8;
        font-size: 14px;
        margin-top: 20px;
      }

      footer {
        background: var(--ink);
        color: #aaa69d;
        border-top: 1px solid var(--line);
        padding: 23px 0;
        font-size: 11px;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
      }

      .footer-links {
        display: flex;
        gap: 20px;
      }

      @media (max-width: 760px) {
        .shell { width: calc(100% - 36px); }

        header {
          min-height: 72px;
          flex-wrap: wrap;
          padding: 19px 0;
          gap: 17px;
        }

        nav {
          width: 100%;
          gap: 18px;
          overflow-x: auto;
          padding-bottom: 3px;
          font-size: 12px;
        }

        .nav-cta { padding: 9px 11px; }

        .hero {
          grid-template-columns: 1fr;
          gap: 49px;
          padding: 75px 0 58px;
        }

        h1 {
          font-size: clamp(46px, 12vw, 66px);
          letter-spacing: -3px;
        }

        .hero-aside { max-width: 480px; }

        .ticker-inner { gap: 13px 22px; }

        .section { padding: 72px 0; }

        .section-heading {
          grid-template-columns: 1fr;
          gap: 20px;
          margin-bottom: 32px;
        }

        .service-grid { grid-template-columns: 1fr; }

        .service,
        .service:nth-child(even) {
          padding: 25px 0;
          border-left: 0;
        }

        .service h3 { margin-top: 17px; }

        .principle {
          grid-template-columns: 35px 1fr;
          gap: 12px;
        }

        .principle p { grid-column: 2; }

        .contact-inner {
          align-items: start;
          flex-direction: column;
        }

        .contact { padding: 72px 0; }

        .footer-inner {
          align-items: start;
          flex-direction: column;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
      }
    </style>
  </head>
  <body>
    <div class="top">
      <div class="shell">
        <header>
          <a class="wordmark" href="/" aria-label="Aklov home">aklov<span>.</span></a>
          <nav aria-label="Main navigation">
            <a href="#solutions">Solutions</a>
            <a href="#approach">Approach</a>
            <a href="/work/">Work</a>
            <a href="/insights/">Insights</a>
            <a class="nav-cta" href="#contact">Start a conversation ↗</a>
          </nav>
        </header>

        <main>
          <section class="hero">
            <div>
              <div class="eyebrow">Business systems & digital solutions</div>
              <h1>Better systems for the way <em>business works.</em></h1>
              <p class="hero-copy">
                Growing businesses need more than disconnected tools and improvised processes.
                Aklov helps bring customer workflows, everyday operations and business systems
                into a structure people can actually work with.
              </p>
              <div class="hero-actions">
                <a class="button button-primary" href="#contact">Discuss your business needs ↗</a>
                <a class="button button-secondary" href="/work/">Explore selected work</a>
              </div>
            </div>

            <aside class="hero-aside">
              <div class="aside-label">The work behind the work</div>
              <p>Clearer processes. Connected systems. Less unnecessary manual work.</p>
              <div class="aside-note">Designed around how your business operates.</div>
            </aside>
          </section>

          <div class="ticker">
            <div class="ticker-inner">
              <span>Customer workflows</span>
              <span>Process automation</span>
              <span>Custom applications</span>
              <span>Connected operations</span>
            </div>
          </div>
        </main>
      </div>
    </div>

    <section class="section" id="solutions">
      <div class="shell">
        <div class="section-heading">
          <div class="section-label">01 / What we improve</div>
          <div>
            <h2>Make the moving parts work together.</h2>
            <p class="section-intro">
              From the first customer enquiry to the work happening behind the scenes,
              we improve the systems that help a business operate with greater consistency.
            </p>
          </div>
        </div>

        <div class="service-grid">
          {services.map((service) => (
            <article class="service">
              <div class="service-number">{service.number}</div>
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section approach" id="approach">
      <div class="shell">
        <div class="section-heading">
          <div class="section-label">02 / How we work</div>
          <div>
            <h2>Start with the problem. Build with purpose.</h2>
            <p class="section-intro">
              Good systems begin with understanding what people need to get done,
              where work gets stuck and what a better process should make possible.
            </p>
          </div>
        </div>

        <div class="principles">
          {principles.map((principle, index) => (
            <article class="principle">
              <div class="principle-number">0{index + 1}</div>
              <h3>{principle[0]}</h3>
              <p>{principle[1]}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="contact" id="contact">
      <div class="shell contact-inner">
        <div>
          <div class="eyebrow">Let's talk about your operations</div>
          <h2>Where does work get harder than it needs to be?</h2>
          <p>
            Tell us about a process that takes too much effort, a workflow that
            keeps breaking down or a system your business has outgrown.
          </p>
        </div>
        <a class="button button-primary" href="mailto:hello@aklov.com">Start a conversation ↗</a>
      </div>
    </section>

    <footer>
      <div class="shell footer-inner">
        <a class="wordmark" href="/" style="font-size: 21px">aklov<span>.</span></a>
        <span>Business systems, thoughtfully built.</span>
        <div class="footer-links">
          <a href="/work/">Work</a>
          <a href="/insights/">Insights</a>
          <a href="#contact">Contact</a>
        </div>
      </div>
    </footer>
  </body>
</html>
