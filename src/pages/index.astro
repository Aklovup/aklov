
---
const services = [
  {
    number: '01',
    title: 'Website design & development',
    description: 'Create a clear, distinctive online presence with thoughtful design, responsive layouts and a website built around your goals.',
    detail: 'DIGITAL EXPERIENCES',
  },
  {
    number: '02',
    title: 'Customer & sales systems',
    description: 'Give enquiries, customer relationships and sales activity a clearer structure, from the first conversation to the next action.',
    detail: 'CUSTOMER OPERATIONS',
  },
  {
    number: '03',
    title: 'Workflow automation',
    description: 'Reduce repetitive work and improve handoffs by connecting the steps, people and decisions behind everyday processes.',
    detail: 'PROCESS DESIGN',
  },
  {
    number: '04',
    title: 'Custom business applications',
    description: 'Build practical internal tools around the way your business actually works, from purpose-built apps to approval workflows.',
    detail: 'APPLICATIONS',
  },
  {
    number: '05',
    title: 'Integrations & reporting',
    description: 'Connect the systems you rely on and bring useful operational information into view, without unnecessary complexity.',
    detail: 'CONNECTED SYSTEMS',
  },
];

const principles = [
  {
    number: '01',
    title: 'Understand the operation',
    description: 'Map the real process, the people involved and the points where work slows down or breaks.',
  },
  {
    number: '02',
    title: 'Shape the right solution',
    description: 'Design around the actual business requirement, existing tools and the way the team needs to work.',
  },
  {
    number: '03',
    title: 'Build, test, refine',
    description: 'Put the system through realistic scenarios and improve it until the workflow makes sense in practice.',
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#171715" />
  <meta name="description" content="Aklov designs distinctive websites and improves business systems, operational workflows, custom applications and integrations for growing businesses." />
  <title>Aklov® — Websites, Business Systems & Digital Solutions</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

  <style>
    :root {
      --ink: #171715;
      --ink-soft: #22221f;
      --paper: #f5f2ea;
      --paper-deep: #eae6dc;
      --gold: #d8bd78;
      --gold-dark: #806a3b;
      --body: #615f57;
      --line: #d7d1c4;
      --line-dark: rgba(245,242,234,.19);
      --display: "Instrument Serif", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
      --pad: clamp(20px,3.4vw,52px);
    }

    *,*::before,*::after { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 24px;
    }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 15px;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    a:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 5px;
    }

    ::selection {
      background: var(--gold);
      color: var(--ink);
    }

    .wrap { padding-inline: var(--pad); }

    .mono {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* Header */

    .top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding-block: 26px;
      border-bottom: 1px solid var(--line-dark);
      color: #c9c6bd;
    }

    .brand {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -2px;
      line-height: 1;
      color: var(--paper);
    }

    .brand i,
    .foot-brand i {
      font-style: normal;
      color: var(--gold);
    }

    .top-note {
      color: #a9a69d;
      text-align: center;
    }

    .nav {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 34px;
      font-size: 12px;
    }

    .nav a:last-child {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 18px;
      border: 1px solid #777268;
      color: var(--paper);
      border-radius: 99px;
    }

    /* Hero */

    .dark {
      background: var(--ink);
      color: var(--paper);
      position: relative;
      overflow: hidden;
    }

    .hero {
      position: relative;
      padding-block: 56px 0;
    }

    .hero-meta {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      color: var(--gold);
      margin-bottom: 34px;
    }

    .hero-meta span:last-child {
      color: #8f8b80;
      text-align: right;
    }

    .hero h1 {
      margin: 0;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(68px,13.6vw,226px);
      line-height: .84;
      letter-spacing: -.045em;
      position: relative;
      z-index: 2;
    }

    .hero h1 span { display: block; }

    .hero h1 .l2 {
      padding-left: clamp(40px,14vw,260px);
    }

    .hero h1 em {
      color: var(--gold);
      font-style: normal;
    }

    .hero-lower {
      display: grid;
      grid-template-columns: minmax(0,1fr) minmax(0,460px);
      gap: clamp(30px,6vw,90px);
      align-items: start;
      margin-top: 48px;
      position: relative;
      z-index: 2;
      padding-bottom: 96px;
    }

    .hero-copy-block {
      padding-top: 0;
      max-width: 430px;
    }

    .hero-copy {
      max-width: 430px;
      margin: 0;
      color: #c1beb5;
      font-size: 15px;
      line-height: 1.9;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 32px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 16px;
      min-height: 52px;
      padding: 0 24px;
      border-radius: 99px;
      font-size: 12px;
      font-weight: 600;
      transition: transform .2s ease, background-color .2s ease;
    }

    .btn:hover { transform: translateY(-2px); }

    .btn-p {
      background: var(--gold);
      color: var(--ink);
    }

    .btn-p:hover { background: #e4ce94; }

    .btn-s {
      border: 1px solid #69665e;
      color: var(--paper);
    }

    /* Decorative arc and portrait placeholder */

    .arc {
      position: absolute;
      z-index: 0;
      right: -14vw;
      top: 4vw;
      width: 78vw;
      max-width: 1250px;
      aspect-ratio: 1;
      border-radius: 50%;
      pointer-events: none;
      background: radial-gradient(
        circle,
        transparent 61%,
        rgba(216,189,120,.07) 62%,
        rgba(216,189,120,.5) 66.5%,
        rgba(216,189,120,.06) 71%,
        transparent 72%
      );
    }

    .arc::after {
      content: "";
      position: absolute;
      inset: 11%;
      border-radius: 50%;
      border: 1px solid rgba(216,189,120,.22);
    }

    .portrait {
      position: absolute;
      z-index: 1;
      bottom: 0;
      left: 34%;
      width: min(36%,560px);
      height: 96%;
      margin: 0;
      pointer-events: none;
    }

    .portrait img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center bottom;
    }

    /* Workflow panel */

    .panel {
      margin-left: auto;
      width: 100%;
      max-width: 460px;
      background: var(--paper);
      color: var(--ink);
      padding: 26px 28px 24px;
      position: relative;
    }

    .panel::before {
      content: "";
      position: absolute;
      inset: 14px -14px -14px 14px;
      border: 1px solid var(--gold);
      z-index: -1;
    }

    .panel-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--ink);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }

    .panel-top span:last-child { color: var(--gold-dark); }

    .flow {
      display: grid;
      margin-top: 6px;
    }

    .node {
      display: grid;
      grid-template-columns: 48px minmax(0,1fr) auto;
      align-items: baseline;
      gap: 14px;
      padding: 22px 0;
      border-bottom: 1px solid var(--line);
    }

    .node .no {
      font-family: var(--display);
      font-size: 36px;
      line-height: .8;
      color: var(--gold-dark);
    }

    .node h3 {
      margin: 0;
      font-family: var(--display);
      font-weight: 400;
      font-size: 25px;
      line-height: 1.05;
    }

    .node p {
      margin: 7px 0 0;
      color: var(--body);
      font-size: 12px;
      line-height: 1.6;
    }

    .node .tag {
      font-size: 9px;
      letter-spacing: 1.6px;
      font-weight: 600;
      color: var(--gold-dark);
    }

    .node.main {
      background: var(--ink);
      color: var(--paper);
      margin-inline: -28px;
      padding-inline: 28px;
    }

    .node.main .no,
    .node.main .tag { color: var(--gold); }

    .node.main p { color: #b5b1a6; }

    .panel-bottom {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 18px;
      font-size: 10px;
      line-height: 1.6;
      color: var(--body);
    }

    .panel-bottom .st {
      color: var(--gold-dark);
      font-weight: 600;
      text-align: right;
    }

    /* Five core capabilities */

    .caps {
      display: grid;
      grid-template-columns: repeat(5,minmax(0,1fr));
      border-top: 1px solid var(--line-dark);
      position: relative;
      z-index: 1;
    }

    .cap {
      padding: 26px var(--pad);
      border-right: 1px solid var(--line-dark);
      color: #b8b4aa;
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .cap:last-child { border-right: 0; }

    .cap b {
      display: block;
      color: var(--gold);
      font-weight: 600;
      margin-bottom: 6px;
      font-size: 10px;
    }

    /* Shared sections */

    .section { padding-block: clamp(80px,10vw,150px); }

    .kicker {
      color: var(--gold-dark);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .kicker::before {
      content: "";
      width: 26px;
      height: 1px;
      background: currentColor;
    }

    h2 {
      margin: 0;
      font-family: var(--display);
      font-weight: 400;
      letter-spacing: -.035em;
    }

    .sv-head {
      display: grid;
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: clamp(50px,7vw,100px);
    }

    .sv-head h2 {
      font-size: clamp(54px,9.6vw,160px);
      line-height: .88;
      max-width: 12ch;
    }

    .sv-head h2 em {
      font-style: italic;
      color: var(--gold-dark);
    }

    .intro {
      max-width: 480px;
      margin: 0 0 0 auto;
      color: var(--body);
      font-size: 14px;
      line-height: 1.9;
    }

    /* Services */

    .service-list { border-top: 1px solid var(--ink); }

    .service {
      display: grid;
      grid-template-columns: 70px minmax(0,1.5fr) minmax(0,1fr) 40px;
      gap: 30px;
      align-items: start;
      padding-block: 40px 44px;
      border-bottom: 1px solid var(--ink);
    }

    .service-number {
      font-size: 11px;
      letter-spacing: 1px;
      color: var(--gold-dark);
      padding-top: 14px;
      font-weight: 600;
    }

    .service h3 {
      margin: 0;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(38px,5.6vw,92px);
      line-height: .95;
      letter-spacing: -.03em;
    }

    .service:nth-child(even) {
      background: var(--ink);
      color: var(--paper);
      margin-inline: calc(var(--pad)*-1);
      padding-inline: var(--pad);
      border-bottom-color: var(--ink);
    }

    .service:nth-child(even) .service-number,
    .service:nth-child(even) .service-detail,
    .service:nth-child(even) .service-arrow {
      color: var(--gold);
    }

    .service:nth-child(even) p { color: #bdb9b0; }

    .service-body p {
      margin: 8px 0 0;
      color: var(--body);
      font-size: 13px;
      line-height: 1.9;
      max-width: 380px;
    }

    .service-detail {
      margin-top: 18px;
      font-size: 9px;
      letter-spacing: 1.8px;
      font-weight: 600;
      color: var(--gold-dark);
    }

    .service-arrow {
      font-family: var(--display);
      font-size: 38px;
      line-height: 1;
      text-align: right;
      color: var(--ink);
    }

    /* Approach */

    .approach {
      background: var(--paper-deep);
      position: relative;
      overflow: hidden;
    }

    .approach::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(23,23,21,.05) 1px,transparent 1px),
        linear-gradient(90deg,rgba(23,23,21,.05) 1px,transparent 1px);
      background-size: 64px 64px;
      -webkit-mask-image: linear-gradient(90deg,transparent 30%,#000);
      mask-image: linear-gradient(90deg,transparent 30%,#000);
    }

    .approach > .wrap { position: relative; }

    .ap-head {
      display: grid;
      grid-template-columns: 1.4fr .6fr;
      gap: 40px;
      align-items: end;
      margin-bottom: clamp(50px,6vw,90px);
    }

    .ap-head h2 {
      font-size: clamp(50px,8vw,132px);
      line-height: .9;
      margin-top: 26px;
    }

    .ap-note {
      text-align: right;
      color: #777267;
      line-height: 1.8;
    }

    .ap-sub {
      max-width: 460px;
      margin: 30px 0 0;
      color: var(--body);
      font-size: 14px;
      line-height: 1.9;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 0;
      align-items: start;
    }

    .principle {
      padding: 34px 30px 60px 0;
      position: relative;
      border-top: 1px solid var(--ink);
    }

    .principle + .principle {
      padding-left: 30px;
      border-left: 1px solid var(--ink);
    }

    .p2 { margin-top: 70px; }
    .p3 { margin-top: 140px; }

    .principle-number {
      font-family: var(--display);
      font-size: clamp(130px,17vw,290px);
      line-height: .75;
      letter-spacing: -.05em;
      color: transparent;
      -webkit-text-stroke: 1px var(--gold-dark);
      margin-bottom: 34px;
    }

    .principle h3 {
      margin: 0 0 14px;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(28px,3vw,44px);
      line-height: 1;
    }

    .principle p {
      margin: 0;
      color: var(--body);
      font-size: 13px;
      line-height: 1.9;
      max-width: 320px;
    }

    /* Contact */

    .contact {
      background: var(--gold);
      color: var(--ink);
      padding-block: clamp(80px,10vw,150px) 0;
    }

    .contact .kicker { color: var(--ink); }

    .contact h2 {
      font-size: clamp(58px,11.4vw,200px);
      line-height: .84;
      margin-top: 30px;
      letter-spacing: -.045em;
    }

    .contact h2 em { font-style: italic; }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(30px,6vw,100px);
      margin-top: clamp(50px,6vw,90px);
      padding-block: 36px 56px;
      border-top: 1px solid var(--ink);
    }

    .contact-copy {
      margin: 0;
      font-size: 15px;
      line-height: 1.9;
      max-width: 420px;
    }

    .contact-action p {
      margin: 0 0 24px;
      font-size: 13px;
      line-height: 1.9;
      max-width: 380px;
    }

    .btn-d {
      background: var(--ink);
      color: var(--paper);
    }

    /* Footer */

    .footer {
      background: var(--ink);
      color: #aaa69d;
      overflow: hidden;
    }

    .foot-main {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 30px;
      align-items: center;
      padding-block: 34px;
      border-bottom: 1px solid var(--line-dark);
      font-size: 11px;
    }

    .foot-main .st {
      text-align: center;
      color: var(--paper);
      font-family: var(--display);
      font-size: 22px;
    }

    .foot-links {
      display: flex;
      gap: 24px;
      justify-content: flex-end;
    }

    .foot-brand {
      color: var(--paper);
      font-size: 23px;
      font-weight: 700;
      letter-spacing: -1.5px;
    }

    .giant {
      font-family: var(--display);
      font-size: clamp(150px,36vw,640px);
      line-height: .72;
      letter-spacing: -.06em;
      color: var(--paper);
      margin: 0 0 0 -.03em;
      padding-top: .1em;
      white-space: nowrap;
      height: .62em;
      overflow: hidden;
      font-weight: 400;
      user-select: none;
    }

    .giant i {
      font-style: normal;
      color: var(--gold);
    }

    .foot-bottom {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding-block: 16px;
      border-top: 1px solid var(--line-dark);
      font-size: 9px;
      color: #858178;
      letter-spacing: .5px;
    }

    /* Tablet */

    @media (max-width:1000px) {
      .top { grid-template-columns: 1fr auto; }
      .top-note { display: none; }

      .hero-lower {
        grid-template-columns: 1fr;
        margin-top: -30px;
      }

      .panel { max-width: none; }

      .portrait {
        position: relative;
        left: auto;
        width: min(78%,440px);
        height: auto;
        aspect-ratio: 600/780;
        margin: -24px 0 0 auto;
      }

      .arc {
        width: 120vw;
        right: -40vw;
        top: 40vw;
      }

      .service {
        grid-template-columns: 44px minmax(0,1fr) 28px;
        gap: 20px;
      }

      .service-body { grid-column: 2; }

      .service-arrow {
        grid-column: 3;
        grid-row: 1;
      }

      .ap-head { grid-template-columns: 1fr; }
      .ap-note { text-align: left; }

      .steps { grid-template-columns: 1fr; }
      .p2,.p3 { margin-top: 0; }

      .principle,
      .principle + .principle {
        padding: 30px 0 40px;
        border-left: 0;
      }

      .principle-number {
        font-size: 150px;
        margin-bottom: 24px;
      }

      .contact-grid { grid-template-columns: 1fr; }

      .caps { grid-template-columns: repeat(3,minmax(0,1fr)); }

      .cap { border-bottom: 1px solid var(--line-dark); }
      .cap:nth-child(3) { border-right: 0; }
      .cap:nth-child(n+4) { border-bottom: 0; }

      .foot-main { grid-template-columns: 1fr; }
      .foot-main .st { text-align: left; }
      .foot-links { justify-content: flex-start; flex-wrap: wrap; }
      .intro { margin-left: 0; }
    }

    /* Mobile */

    @media (max-width:560px) {
      .hero { padding-top: 38px; }

      .hero-meta {
        font-size: 8px;
        letter-spacing: 1.2px;
      }

      .hero h1 { font-size: clamp(57px,13vw,78px); }
      .hero h1 .l2 { padding-left: 24px; }

      .hero-lower { margin-top: -24px; }

      .hero-actions {
        align-items: stretch;
        flex-direction: column;
      }

      .hero-actions .btn {
        justify-content: space-between;
        width: 100%;
      }

      .panel { padding: 22px 20px 20px; }
      .panel::before { inset: 10px -8px -10px 8px; }

      .node {
        grid-template-columns: 38px minmax(0,1fr);
        gap: 10px;
      }

      .node .tag { display: none; }
      .node .no { font-size: 32px; }
      .node h3 { font-size: 23px; }

      .node.main {
        margin-inline: -20px;
        padding-inline: 20px;
      }

      .panel-bottom { font-size: 9px; }

      .caps { grid-template-columns: 1fr 1fr; }

      .cap {
        padding: 20px var(--pad);
        font-size: 10px;
      }

      .cap:nth-child(2) { border-right: 0; }
      .cap:nth-child(3) { border-right: 1px solid var(--line-dark); }
      .cap:nth-child(n+4) { border-bottom: 0; }

      .sv-head h2 { font-size: clamp(52px,12vw,72px); }

      .service {
        grid-template-columns: 30px minmax(0,1fr) 20px;
        gap: 12px;
        padding-block: 30px;
      }

      .service h3 { font-size: clamp(34px,8.5vw,48px); }
      .service-number { padding-top: 8px; font-size: 10px; }
      .service-arrow { font-size: 30px; }
      .service-body p { font-size: 12px; }

      .ap-head h2 { font-size: clamp(48px,11vw,66px); }
      .principle-number { font-size: 125px; }

      .contact h2 { font-size: clamp(54px,12vw,76px); }

      .foot-bottom {
        flex-direction: column;
        gap: 6px;
      }

      .foot-links { gap: 18px; }
      .giant { font-size: 36vw; }
    }

    @media (prefers-reduced-motion:reduce) {
      html { scroll-behavior: auto; }

      *,
      *::before,
      *::after {
        transition: none !important;
        animation: none !important;
      }
    }
  </style>
</head>

<body>
  <div class="dark">
    <div class="arc" aria-hidden="true"></div>

    <div class="wrap">
      <header class="top">
        <a class="brand" href="/" aria-label="Aklov home">aklov<i>.</i></a>
        <span class="top-note mono">Business systems studio</span>

