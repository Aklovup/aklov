
---
const services = [
  {
    number: "01",
    title: "Customer & sales systems",
    description:
      "Give enquiries, customer relationships and sales activity a clearer structure, from the first conversation to the next action.",
    detail: "CUSTOMER OPERATIONS"
  },
  {
    number: "02",
    title: "Workflow automation",
    description:
      "Reduce repetitive work and improve handoffs by connecting the steps, people and decisions behind everyday processes.",
    detail: "PROCESS DESIGN"
  },
  {
    number: "03",
    title: "Custom business applications",
    description:
      "Build practical internal tools around the way your business actually works, from purpose-built apps to approval workflows.",
    detail: "APPLICATIONS"
  },
  {
    number: "04",
    title: "Integrations & reporting",
    description:
      "Connect the systems you rely on and bring useful operational information into view, without unnecessary complexity.",
    detail: "CONNECTED SYSTEMS"
  }
];

const principles = [
  {
    number: "01",
    title: "Understand the operation",
    description:
      "Map the real process, the people involved and the points where work slows down or breaks."
  },
  {
    number: "02",
    title: "Shape the right solution",
    description:
      "Design around the actual business requirement, existing tools and the way the team needs to work."
  },
  {
    number: "03",
    title: "Build, test, refine",
    description:
      "Put the system through realistic scenarios and improve it until the workflow makes sense in practice."
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171715" />
    <meta
      name="description"
      content="Aklov designs and improves business systems, operational workflows, custom applications and integrations for growing businesses."
    />
    <title>Aklov® — Business Systems & Digital Solutions</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <style>
      :root {
        color-scheme: light;
        --ink: #171715;
        --ink-soft: #22221f;
        --paper: #f5f2ea;
        --paper-deep: #eae6dc;
        --gold: #d8bd78;
        --gold-dark: #806a3b;
        --body: #615f57;
        --line: #d7d1c4;
        --line-dark: rgba(245, 242, 234, 0.19);
        --display: "Instrument Serif", Georgia, serif;
        --sans: "DM Sans", Arial, sans-serif;
        --page-width: 1220px;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 30px;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 15px;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 5px;
      }

      ::selection {
        background: var(--gold);
        color: var(--ink);
      }

      .shell {
        width: min(var(--page-width), calc(100% - 88px));
        margin-inline: auto;
      }

      .dark {
        background: var(--ink);
        color: var(--paper);
      }

      /* Navigation */

      .site-header {
        position: relative;
        z-index: 2;
        display: flex;
        min-height: 88px;
        align-items: center;
        justify-content: space-between;
        gap: 32px;
        border-bottom: 1px solid var(--line-dark);
      }

      .brand {
        flex-shrink: 0;
        font-size: 29px;
        line-height: 1;
        font-weight: 700;
        letter-spacing: -2px;
      }

      .brand-dot {
        color: var(--gold);
      }

      .brand-note {
        display: block;
        margin-top: 8px;
        color: #a9a69d;
        font-size: 8px;
        font-weight: 500;
        letter-spacing: 2px;
        text-transform: uppercase;
      }

      .navigation {
        display: flex;
        align-items: center;
        gap: clamp(18px, 2.7vw, 37px);
        color: #c9c6bd;
        font-size: 12px;
      }

      .navigation a:not(.nav-contact) {
        transition: color 180ms ease;
      }

      .navigation a:not(.nav-contact):hover {
        color: var(--gold);
      }

      .nav-contact {
        display: inline-flex;
        min-height: 43px;
        align-items: center;
        padding: 0 15px;
        border: 1px solid #777268;
        color: var(--paper);
        transition: background 180ms ease, color 180ms ease;
      }

      .nav-contact:hover {
        background: var(--paper);
        color: var(--ink);
      }

      /* Hero */

      .hero {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1.16fr) minmax(300px, 0.84fr);
        gap: clamp(45px, 7vw, 100px);
        align-items: center;
        padding-block: 100px 94px;
      }

      .eyebrow,
      .section-kicker {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 10px;
        font-weight: 650;
        letter-spacing: 1.9px;
        line-height: 1.5;
        text-transform: uppercase;
      }

      .eyebrow {
        color: var(--gold);
      }

      .eyebrow::before,
      .section-kicker::before {
        width: 26px;
        height: 1px;
        flex: 0 0 26px;
        background: currentColor;
        content: "";
      }

      .hero h1 {
        max-width: 740px;
        margin: 29px 0 24px;
        font-family: var(--display);
        font-size: clamp(64px, 7.6vw, 104px);
        font-weight: 400;
        letter-spacing: -2.2px;
        line-height: 0.91;
      }

      .hero h1 em {
        color: var(--gold);
        font-weight: 400;
      }

      .hero-copy {
        max-width: 470px;
        margin: 0;
        color: #c1beb5;
        font-size: 15px;
        line-height: 1.9;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
      }

      .button {
        display: inline-flex;
        min-height: 49px;
        align-items: center;
        justify-content: center;
        gap: 15px;
        padding: 0 17px;
        font-family: var(--sans);
        font-size: 12px;
        font-weight: 650;
        transition: background 180ms ease, color 180ms ease, border-color 180ms ease;
      }

      .button-primary {
        background: var(--gold);
        color: var(--ink);
      }

      .button-primary:hover {
        background: #ead6a0;
      }

      .button-secondary {
        border: 1px solid #69665e;
        color: var(--paper);
      }

      .button-secondary:hover {
        border-color: var(--paper);
      }

      .button-arrow {
        font-size: 16px;
        line-height: 1;
      }

      /* Purpose-built systems diagram */

      .system-visual {
        position: relative;
        min-width: 0;
        padding: 23px 20px 20px;
        border: 1px solid #41413a;
        background:
          linear-gradient(rgba(245, 242, 234, 0.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(245, 242, 234, 0.035) 1px, transparent 1px),
          #1b1b19;
        background-size: 26px 26px;
      }

      .visual-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding-bottom: 19px;
        border-bottom: 1px solid #41413a;
      }

      .visual-label {
        color: #c7c2b7;
        font-size: 9px;
        font-weight: 650;
        letter-spacing: 1.5px;
        text-transform: uppercase;
      }

      .visual-index {
        color: #9c978b;
        font-size: 9px;
        letter-spacing: 1px;
      }

      .flow-diagram {
        display: grid;
        gap: 0;
        padding-top: 18px;
      }

      .flow-node {
        position: relative;
        display: grid;
        grid-template-columns: 34px minmax(0, 1fr) auto;
        min-height: 64px;
        align-items: center;
        gap: 12px;
        padding: 11px 12px;
        border: 1px solid #4b4a42;
        background: rgba(35, 35, 31, 0.96);
      }

      .flow-node-main {
        border-color: #8d794b;
        background: #302b20;
      }

      .flow-symbol {
        display: flex;
        width: 30px;
        height: 30px;
        align-items: center;
        justify-content: center;
        border: 1px solid #625b48;
        color: var(--gold);
        font-size: 10px;
        letter-spacing: -0.3px;
      }

      .flow-node h3 {
        margin: 0;
        color: #f1eee5;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.45;
      }

      .flow-node p {
        margin: 4px 0 0;
        color: #a9a59a;
        font-size: 9px;
        line-height: 1.45;
      }

      .flow-tag {
        color: #b5ad98;
        font-size: 8px;
        letter-spacing: 0.6px;
        text-align: right;
        text-transform: uppercase;
      }

      .flow-connector {
        display: flex;
        height: 28px;
        align-items: center;
        justify-content: center;
        color: var(--gold);
        font-size: 14px;
      }

      .visual-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 18px;
        padding-top: 15px;
        border-top: 1px solid #41413a;
      }

      .visual-bottom span {
        color: #b1ada2;
        font-size: 9px;
        line-height: 1.6;
      }

      .visual-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--gold) !important;
        text-align: right;
      }

      .visual-status::before {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--gold);
        content: "";
      }

      /* Capability strip */

      .capability-strip {
        border-top: 1px solid var(--line-dark);
      }

      .capability-inner {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        padding-block: 23px;
      }

      .capability {
        padding-inline: 18px;
        border-right: 1px solid var(--line-dark);
        color: #b8b4aa;
        font-size: 10px;
        letter-spacing: 0.7px;
        line-height: 1.7;
        text-align: center;
      }

      .capability:first-child {
        padding-left: 0;
      }

      .capability:last-child {
        padding-right: 0;
        border-right: 0;
      }

      /* Shared sections */

      .section {
        padding-block: 110px;
      }

      .section-kicker {
        color: var(--gold-dark);
      }

      .section-head {
        display: grid;
        grid-template-columns: 0.7fr 1.3fr;
        gap: 50px;
        align-items: start;
        margin-bottom: 61px;
      }

      .section-heading-copy {
        max-width: 720px;
      }

      .section h2,
      .contact h2 {
        margin: 0;
        font-family: var(--display);
        font-size: clamp(45px, 5.5vw, 72px);
        font-weight: 400;
        letter-spacing: -1.2px;
        line-height: 0.99;
      }

      .section-intro {
        max-width: 520px;
        margin: 23px 0 0;
        color: var(--body);
        font-size: 14px;
        line-height: 1.9;
      }

      /* Services: editorial rows, not cards */

      .service-list {
        border-top: 1px solid var(--line);
      }

      .service {
        display: grid;
        grid-template-columns: 55px minmax(200px, 0.92fr) minmax(0, 1.08fr) 24px;
        align-items: start;
        gap: 25px;
        padding-block: 29px 31px;
        border-bottom: 1px solid var(--line);
        transition: padding 180ms ease;
      }

      .service-number {
        padding-top: 9px;
        color: var(--gold-dark);
        font-size: 10px;
        letter-spacing: 1px;
      }

      .service h3 {
        max-width: 320px;
        margin: 0;
        font-family: var(--display);
        font-size: clamp(26px, 3vw, 37px);
        font-weight: 400;
        line-height: 1.12;
      }

      .service p {
        max-width: 440px;
        margin: 3px 0 0;
        color: var(--body);
        font-size: 13px;
        line-height: 1.9;
      }

      .service-detail {
        margin-top: 14px;
        color: #8a8579;
        font-size: 9px;
        letter-spacing: 1.4px;
      }

      .service-arrow {
        padding-top: 5px;
        color: #8a8579;
        font-size: 18px;
        text-align: right;
      }

      /* Approach */

      .approach {
        background: var(--paper-deep);
      }

      .approach-intro {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 35px;
        margin-bottom: 57px;
      }

      .approach-intro .section-heading-copy {
        max-width: 750px;
      }

      .approach-intro .section-intro {
        max-width: 440px;
      }

      .approach-note {
        max-width: 180px;
        padding-bottom: 5px;
        color: #777267;
        font-size: 10px;
        letter-spacing: 1.1px;
        line-height: 1.8;
        text-align: right;
        text-transform: uppercase;
      }

      .principle-list {
        border-top: 1px solid #cec7b8;
      }

      .principle {
        display: grid;
        grid-template-columns: 65px minmax(190px, 0.8fr) minmax(0, 1.2fr);
        gap: 25px;
        align-items: start;
        padding-block: 28px;
        border-bottom: 1px solid #cec7b8;
      }

      .principle-number {
        padding-top: 5px;
        color: var(--gold-dark);
        font-size: 11px;
      }

      .principle h3 {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.6;
      }

      .principle p {
        max-width: 500px;
        margin: 0;
        color: var(--body);
        font-size: 13px;
        line-height: 1.9;
      }

      /* Contact */

      .contact {
        padding-block: 98px;
        background: var(--ink);
        color: var(--paper);
      }

      .contact-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(220px, 0.75fr);
        gap: 70px;
        align-items: end;
      }

      .contact .eyebrow {
        margin-bottom: 25px;
      }

      .contact h2 {
        max-width: 760px;
        font-size: clamp(49px, 6vw, 78px);
      }

      .contact h2 em {
        color: var(--gold);
        font-weight: 400;
      }

      .contact-copy {
        max-width: 420px;
        margin: 23px 0 0;
        color: #bdb9b0;
        font-size: 14px;
        line-height: 1.9;
      }

      .contact-action {
        padding-bottom: 5px;
      }

      .contact-action p {
        margin: 0 0 19px;
        color: #bdb9b0;
        font-size: 12px;
        line-height: 1.8;
      }

      /* Footer */

      .site-footer {
        border-top: 1px solid var(--line-dark);
        background: var(--ink);
        color: #aaa69d;
      }

      .footer-main {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding-block: 28px;
      }

      .footer-brand {
        color: var(--paper);
        font-size: 23px;
        font-weight: 700;
        letter-spacing: -1.5px;
      }

      .footer-statement {
        font-size: 10px;
        letter-spacing: 0.3px;
      }

      .footer-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
        font-size: 11px;
      }

      .footer-meta a:hover {
        color: var(--gold);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding-block: 15px;
        border-top: 1px solid var(--line-dark);
        color: #858178;
        font-size: 9px;
        line-height: 1.7;
      }

      /* Tablet and mobile */

      @media (max-width: 900px) {
        .shell {
          width: min(var(--page-width), calc(100% - 48px));
        }

        .hero {
          grid-template-columns: minmax(0, 1fr) minmax(255px, 0.8fr);
          gap: 32px;
          padding-block: 80px;
        }

        .hero h1 {
          font-size: clamp(61px, 8vw, 79px);
        }

        .system-visual {
          padding-inline: 14px;
        }

        .flow-node {
          grid-template-columns: 30px minmax(0, 1fr);
          gap: 9px;
          padding-inline: 9px;
        }

        .flow-tag {
          display: none;
        }

        .section {
          padding-block: 85px;
        }

        .section-head {
          grid-template-columns: 0.55fr 1.45fr;
          gap: 30px;
        }

        .service {
          grid-template-columns: 35px minmax(170px, 0.95fr) minmax(0, 1.05fr) 15px;
          gap: 17px;
        }

        .contact-layout {
          gap: 40px;
        }
      }

      @media (max-width: 680px) {
        .shell {
          width: calc(100% - 40px);
        }

        .site-header {
          min-height: auto;
          align-items: flex-start;
          flex-direction: column;
          gap: 23px;
          padding-block: 23px 18px;
        }

        .brand {
          font-size: 27px;
        }

        .navigation {
          width: 100%;
          justify-content: space-between;
          gap: 12px;
          font-size: 11px;
        }

        .nav-contact {
          min-height: 36px;
          padding-inline: 10px;
          white-space: nowrap;
        }

        .hero {
          grid-template-columns: minmax(0, 1fr);
          gap: 48px;
          padding-block: 68px 52px;
        }

        .hero h1 {
          max-width: 570px;
          margin-top: 25px;
          font-size: clamp(64px, 13.5vw, 88px);
          letter-spacing: -1.2px;
          line-height: 0.93;
        }

        .hero-copy {
          max-width: 500px;
          font-size: 14px;
          line-height: 1.9;
        }

        .hero-actions {
          gap: 10px;
          margin-top: 25px;
        }

        .button {
          min-height: 47px;
          padding-inline: 13px;
          font-size: 11px;
        }

        .system-visual {
          width: 100%;
          max-width: 460px;
          justify-self: center;
          padding: 18px;
        }

        .flow-node {
          grid-template-columns: 34px minmax(0, 1fr) auto;
          min-height: 61px;
          gap: 11px;
          padding-inline: 11px;
        }

        .flow-tag {
          display: block;
          font-size: 7px;
        }

        .capability-inner {
          grid-template-columns: 1fr 1fr;
          row-gap: 15px;
          padding-block: 19px;
        }

        .capability {
          padding-inline: 8px;
          font-size: 9px;
        }

        .capability:nth-child(2) {
          border-right: 0;
        }

        .capability:nth-child(3) {
          padding-left: 0;
        }

        .section {
          padding-block: 73px;
        }

        .section-head {
          grid-template-columns: 1fr;
          gap: 23px;
          margin-bottom: 37px;
        }

        .section h2 {
          font-size: clamp(46px, 10vw, 61px);
        }

        .section-intro {
          margin-top: 18px;
          font-size: 13px;
        }

        .service {
          grid-template-columns: 30px minmax(0, 1fr) 18px;
          gap: 12px;
          padding-block: 24px 25px;
        }

        .service-number {
          padding-top: 6px;
        }

        .service h3 {
          font-size: 31px;
        }

        .service p {
          grid-column: 2;
          font-size: 12px;
        }

        .service-detail {
          margin-top: 11px;
        }

        .service-arrow {
          grid-column: 3;
          grid-row: 1;
          padding-top: 2px;
        }

        .approach-intro {
          align-items: flex-start;
          flex-direction: column;
          gap: 20px;
          margin-bottom: 36px;
        }

        .approach-note {
          max-width: none;
          text-align: left;
        }

        .principle {
          grid-template-columns: 31px minmax(0, 1fr);
          gap: 10px 13px;
          padding-block: 24px;
        }

        .principle h3 {
          font-size: 14px;
        }

        .principle p {
          grid-column: 2;
          font-size: 12px;
        }

        .contact {
          padding-block: 72px;
        }

        .contact-layout {
          grid-template-columns: minmax(0, 1fr);
          gap: 34px;
        }

        .contact h2 {
          font-size: clamp(52px, 11vw, 70px);
        }

        .contact-copy {
          font-size: 13px;
        }

        .contact-action p {
          max-width: 340px;
        }

        .footer-main {
          align-items: flex-start;
          flex-direction: column;
          gap: 17px;
          padding-block: 25px;
        }

        .footer-statement {
          max-width: 260px;
          line-height: 1.8;
        }

        .footer-bottom {
          align-items: flex-start;
          flex-direction: column;
          gap: 5px;
        }
      }

      @media (max-width: 370px) {
        .shell {
          width: calc(100% - 32px);
        }

        .navigation {
          gap: 9px;
          font-size: 10px;
        }

        .nav-contact {
          padding-inline: 8px;
        }

        .hero h1 {
          font-size: 59px;
        }

        .hero-actions {
          align-items: stretch;
          flex-direction: column;
        }

        .hero-actions .button {
          justify-content: space-between;
        }

        .system-visual {
          padding-inline: 11px;
        }

        .flow-node {
          grid-template-columns: 29px minmax(0, 1fr);
        }

        .flow-tag {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          scroll-behavior: auto !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>

  <body>
    <div class="dark">
      <div class="shell">
        <header class="site-header">
          <a class="brand" href="/" aria-label="Aklov home">
            aklov<span class="brand-dot">.</span>
            <span class="brand-note">Business systems studio</span>
          </a>

          <nav class="navigation" aria-label="Main navigation">
            <a href="#solutions">Solutions</a>
            <a href="#approach">Approach</a>
            <a class="nav-contact" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
