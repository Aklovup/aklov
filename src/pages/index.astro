---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../data/links';
import SelectedWork from '../components/home/SelectedWork.astro';
import Starfield from '../components/home/Starfield.astro';

const services = [
  {
    number: '01',
    href: links.solutionsWebsite,
    title: 'Website design & development',
    description: 'Create a clear, distinctive online presence with thoughtful design, responsive layouts and a website built around your goals.',
    detail: 'DIGITAL EXPERIENCES',
  },
  {
    number: '02',
    href: links.solutionsCustomer,
    title: 'Customer & sales systems',
    description: 'Give enquiries, customer relationships and sales activity a clearer structure, from the first conversation to the next action.',
    detail: 'CUSTOMER OPERATIONS',
  },
  {
    number: '03',
    href: links.solutionsAutomation,
    title: 'Workflow automation',
    description: 'Reduce repetitive work and improve handoffs by connecting the steps, people and decisions behind everyday processes.',
    detail: 'PROCESS DESIGN',
  },
  {
    number: '04',
    href: links.solutionsApplications,
    title: 'Custom business applications',
    description: 'Build practical internal tools around the way your business actually works, from purpose-built apps to approval workflows.',
    detail: 'APPLICATIONS',
  },
  {
    number: '05',
    href: links.solutionsIntegrations,
    title: 'Integrations & reporting',
    description: 'Connect the systems you rely on and bring useful operational information into view, without unnecessary complexity.',
    detail: 'CONNECTED SYSTEMS',
  },
];

const principles = [
  {
    number: '01',
    title: 'Understand the operation',
    description: 'Map the real process, the people involved and the points where work slows down or breaks.',
  },
  {
    number: '02',
    title: 'Shape the right solution',
    description: 'Design around the actual business requirement, existing tools and the way the team needs to work.',
  },
  {
    number: '03',
    title: 'Build, test, refine',
    description: 'Put the system through realistic scenarios and improve it until the workflow makes sense in practice.',
  },
];
---

<BaseLayout
  title="Aklov® — Websites, Business Systems & Digital Solutions"
  description="Aklov designs distinctive websites and improves business systems, operational workflows, custom applications and integrations for growing businesses."
  contactHref="#contact"
>
  <section class="dark home-hero" aria-labelledby="hero-title">
    <Starfield />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const reveal = () => {
          if (window.scrollY < 48) return;
          root.dataset.homeReveal = 'shown';
          window.removeEventListener('scroll', reveal);
        };
        window.addEventListener('scroll', reveal, { passive: true });
        window.addEventListener('pageshow', reveal, { once: true });
        root.dataset.homeReveal = 'pending';
        reveal();
      })();
    </script>
    <div class="wrap hero">
      <p class="hero-meta mono">Websites, business systems &amp; digital solutions</p>
      <h1 id="hero-title">
        <span>Better systems.</span>
        <span class="hero-second">Better business.</span>
      </h1>
      <p class="hero-copy" data-hero-copy>
        The way a business operates matters. I help growing businesses build a stronger online presence and bring customer workflows, everyday processes and disconnected tools into systems that work with the people behind them.
      </p>
      <div class="hero-actions">
        <a class="btn btn-gold" href={links.contact}>Discuss a business challenge <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#selected-work">View selected work <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <SelectedWork />

  <!-- Capabilities -->
  <section class="section" id="solutions">
    <div class="wrap">
      <div class="sv-head">
        <div class="kicker mono">02 / Capabilities</div>
        <h2>Make the moving parts <em>work together.</em></h2>
        <p class="intro">
          From a well-designed website to better-connected business operations, the right solution starts with understanding the goal, the people and the problem to be solved.
        </p>
      </div>

      <div class="service-list">
        {services.map((service) => (
          <a class="service" href={service.href} aria-label={`Explore ${service.title}`}>
            <div class="service-number">{service.number}</div>
            <h3>{service.title}</h3>
            <div class="service-body">
              <p>{service.description}</p>
              <div class="service-detail">{service.detail}</div>
            </div>
            <span class="service-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section approach" id="approach">
    <div class="wrap">
      <div class="ap-head">
        <div>
          <div class="kicker mono">03 / The approach</div>
          <h2>Understand first. Build with purpose.</h2>
          <p class="ap-sub">
            A website or business system should make things clearer for the people who use it. That starts before choosing a visual direction, tools or automations.
          </p>
        </div>

        <div class="ap-note mono">
          Clear thinking before<br />technical complexity.
        </div>
      </div>

      <div class="steps">
        {principles.map((principle, index) => (
          <article class:list={['principle', `p${index + 1}`]}>
            <div class="principle-number" aria-hidden="true">{principle.number}</div>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="contact" id="contact">
    <div class="wrap">
      <div class="kicker mono">Start with the real problem</div>
      <h2>Where could things work better than <em>they do today?</em></h2>

      <div class="contact-grid">
        <p class="contact-copy">
          Tell me about a website that needs a stronger presence, a process that takes too much effort, a workflow that keeps breaking down or a system your business has outgrown.
        </p>

        <div class="contact-action">
          <p>
            A useful conversation starts with understanding what is happening today and what needs to work better.
          </p>
          <a class="btn btn-dark" href={links.contact}>
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1, h2, h3, p { margin: 0; }
  .dark { background: var(--charcoal); color: var(--ivory); --focus-color: var(--gold); }
  .home-hero { position: relative; isolation: isolate; overflow: hidden; }
  .hero { position:relative;z-index:1;display:flex;flex-direction:column;min-height:calc(100svh - 97px);padding-block:clamp(36px,4vw,64px) clamp(28px,3vw,48px); }
  .hero-meta { margin-bottom:clamp(28px,3vw,48px);color:var(--gold); }
  h1 { font-family:var(--display);font-size:clamp(46px,16.8vw,300px);font-weight:400;line-height:.89;letter-spacing:-.045em; }
  h1 span { display:block; }
  .hero-second { text-align:right;color:var(--gold); }
  .hero-copy { max-width:70ch;margin-top:auto;padding-top:clamp(30px,4vw,64px);color:var(--on-dark);font-size:clamp(16px,1.3vw,20px);line-height:1.75;opacity:1;transform:none;transition:opacity .75s ease,transform .75s cubic-bezier(.16,1,.3,1); }
  :global(html[data-home-reveal='pending']) .hero-copy { opacity:0;transform:translateY(14px); }
  .hero-actions { display:flex;justify-content:space-between;align-items:end;gap:24px;margin-top:clamp(30px,3vw,48px); }
  .text-link { display:inline-flex;align-items:center;gap:16px;min-height:44px;font-size:13px;border-bottom:1px solid var(--on-dark-dim); }
  .text-link span { font-size:18px; }

  .section { padding-block: clamp(64px, 7vw, 112px); }
  h2 { font-family: var(--display); font-weight: 400; letter-spacing: -.035em; }
  .sv-head { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .7fr); align-items: end; gap: 24px 64px; margin-bottom: clamp(36px, 4vw, 64px); }
  .sv-head .kicker { grid-column: 1 / -1; }
  .sv-head h2 { max-width: 12ch; font-size: clamp(52px, 7vw, 112px); line-height: .95; }
  .sv-head h2 em { color: var(--gold-dark); }
  .intro { max-width: 400px; justify-self: end; padding-bottom: 4px; color: var(--body); font-size: 15px; line-height: 1.8; }
  .service-list { border-top: 1px solid var(--charcoal); }
  .service { display: grid; grid-template-columns: 40px minmax(0, 1.2fr) minmax(0, 1fr) 30px; gap: clamp(18px, 2.4vw, 38px); align-items: start; padding-block: clamp(28px, 3vw, 44px); border-bottom: 1px solid var(--charcoal); }
  .service-number { padding-top: 9px; color: var(--gold-dark); font-size: 11px; font-weight: 600; letter-spacing: 1px; }
  .service h3 { max-width: 16ch; font-family: var(--display); font-size: clamp(34px, 4vw, 64px); font-weight: 400; line-height: 1.02; letter-spacing: -.025em; }
  .service:nth-child(even) { --focus-color: var(--gold); background: var(--charcoal); color: var(--ivory); box-shadow: 0 0 0 100vmax var(--charcoal); clip-path: inset(0 -100vmax); }
  .service:nth-child(even) .service-number, .service:nth-child(even) .service-detail, .service:nth-child(even) .service-arrow { color: var(--gold); }
  .service:nth-child(even) p { color: var(--on-dark); }
  .service-body p { max-width: 400px; margin-top: 4px; color: var(--body); font-size: 14px; line-height: 1.8; }
  .service-detail { margin-top: 16px; color: var(--gold-dark); font-size: 9px; font-weight: 600; letter-spacing: 1.5px; }
  .service-arrow { display: flex; align-items: center; justify-content: end; min-height: 44px; font-size: 30px; line-height: 1; }

  .approach { position: relative; overflow: hidden; background: var(--paper-deep); }

  .approach::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(21, 21, 21, .05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(21, 21, 21, .05) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: linear-gradient(90deg, transparent 30%, #000);
    mask-image: linear-gradient(90deg, transparent 30%, #000);
  }

  .approach > .wrap { position: relative; }

  .ap-head {
    display: grid;
    grid-template-columns: 1.4fr .6fr;
    gap: 40px;
    align-items: end;
    margin-bottom: clamp(50px, 6vw, 90px);
  }

  .ap-head h2 { margin-top: 26px; font-size: clamp(50px, 8vw, 132px); line-height: .9; }
  .ap-note { color: var(--stone); line-height: 1.8; text-align: right; }
  .ap-sub { max-width: 460px; margin-top: 30px; color: var(--body); font-size: 14px; line-height: 1.9; }

  .steps { display: grid; grid-template-columns: repeat(3, 1fr); align-items: start; }

  .principle { position: relative; padding: 34px 30px 60px 0; border-top: 1px solid var(--charcoal); }
  .principle + .principle { padding-left: 30px; border-left: 1px solid var(--charcoal); }
  .p2 { margin-top: 70px; }
  .p3 { margin-top: 140px; }

  .principle-number {
    margin-bottom: 34px;
    font-family: var(--display);
    font-size: clamp(130px, 17vw, 290px);
    line-height: .75;
    letter-spacing: -.05em;
    color: transparent;
    -webkit-text-stroke: 1px var(--gold-dark);
  }

  .principle h3 { margin-bottom: 14px; font-family: var(--display); font-size: clamp(28px, 3vw, 44px); font-weight: 400; line-height: 1; }
  .principle p { max-width: 320px; color: var(--body); font-size: 13px; line-height: 1.9; }

  .contact { padding-block: clamp(64px, 7vw, 112px) 0; background: var(--gold); color: var(--charcoal); }
  .contact .kicker { color: var(--charcoal); }
  .contact h2 { max-width: 19ch; margin-top: 26px; font-size: clamp(52px, 7.5vw, 120px); line-height: .96; letter-spacing: -.035em; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); margin-top: 36px; padding-block: 28px 48px; border-top: 1px solid var(--charcoal); }
  .contact-copy { max-width: 440px; font-size: 16px; line-height: 1.8; }
  .contact-action p { max-width: 400px; margin-bottom: 22px; font-size: 14px; line-height: 1.8; }
  @media (hover: hover) {
    .text-link:hover { color: var(--gold); border-color: var(--gold); }
    .service h3, .service-arrow { transition: transform .2s ease; }
    .service:hover h3 { transform: translateX(5px); }
    .service:hover .service-arrow { transform: translate(3px, -3px); }
  }
  @media (max-width: 1000px) {
    .sv-head { grid-template-columns: minmax(0, 1fr) minmax(0, .8fr); gap: 24px 32px; }
    .service { grid-template-columns: 30px minmax(0, 1fr) minmax(0, 1fr) 24px; gap: 20px; }
    .ap-head { grid-template-columns: 1fr; }
    .ap-note { text-align: left; }
    .steps { grid-template-columns: 1fr; }
    .p2, .p3 { margin-top: 0; }
    .principle, .principle + .principle { padding: 30px 0 40px; border-left: 0; }
    .principle-number { margin-bottom: 24px; font-size: 150px; }
  }
  @media (max-width: 640px) {
    .hero-meta { max-width: 34ch; font-size: 9px; letter-spacing: 1.4px; margin-bottom: 26px; }
    .hero { min-height:calc(100svh - 85px);padding-block:32px 28px; }
    h1 { font-size:clamp(46px,17.5vw,110px);line-height:.94; }
    .hero-copy { padding-top:30px; }
    .hero-actions { display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.9fr);gap:16px;margin-top:28px; }
    .hero-actions .btn { min-height:64px;height:auto;gap:10px;padding:12px;line-height:1.5; }
    .hero-actions .text-link { justify-self:end;min-width:0;gap:8px;font-size:12px;line-height:1.5; }
    .hero-actions .text-link span { flex-shrink:0;font-size:16px; }
    .sv-head { grid-template-columns: 1fr; gap: 22px; }
    .intro { justify-self: start; font-size: 14px; }
    .sv-head h2 { max-width: 14ch; font-size: clamp(48px, 10vw, 64px); }
    .service { grid-template-columns: 24px minmax(0, 1fr) 24px; gap: 12px; }
    .service h3 { font-size: clamp(32px, 8vw, 46px); }
    .service-body { grid-column: 2; }
    .service-arrow { grid-column: 3; grid-row: 1; }
    .service-body p { font-size: 14px; }
    .ap-head h2 { font-size: clamp(48px, 11vw, 66px); }
    .principle-number { font-size: 125px; }
    .contact-grid { grid-template-columns: 1fr; gap: 24px; margin-top: 28px; }
    .contact h2 { font-size: clamp(48px, 10vw, 66px); }
  }
  @media(prefers-reduced-motion:reduce) { .hero-copy { transition:none;transform:none!important; } }
</style>

