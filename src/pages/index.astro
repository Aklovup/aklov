---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#151515" />
  <meta name="description" content="Aklov designs distinctive websites and improves business systems, operational workflows, custom applications and integrations for growing businesses." />
  <title>Aklov® — Websites, Business Systems & Digital Solutions</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      /* Brand palette */
      --charcoal: #151515;
      --ivory: #f5f2ea;
      --gold: #d8bd78;
      --stone: #77766f;

      /* Derived tones */
      --paper-deep: color-mix(in srgb, var(--ivory) 90%, var(--stone));
      --gold-dark: color-mix(in srgb, var(--gold) 55%, var(--charcoal));
      --body: color-mix(in srgb, var(--charcoal) 72%, var(--ivory));
      --on-dark: color-mix(in srgb, var(--ivory) 74%, var(--charcoal));
      --on-dark-dim: color-mix(in srgb, var(--ivory) 52%, var(--charcoal));
      --line: color-mix(in srgb, var(--stone) 35%, var(--ivory));
      --line-dark: color-mix(in srgb, var(--ivory) 19%, transparent);
      --gold-soft: color-mix(in srgb, var(--gold) 80%, var(--ivory));

      --display: "Instrument Serif", Georgia, serif;
      --sans: "DM Sans", Arial, sans-serif;
      --pad: clamp(20px, 3.4vw, 52px);
      --max: 1800px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 24px;
    }

    body {
      margin: 0;
      background: var(--ivory);
      color: var(--charcoal);
      font-family: var(--sans);
      font-size: 15px;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    a { color: inherit; text-decoration: none; }

    a:focus-visible,
    button:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 5px;
    }

    ::selection { background: var(--gold); color: var(--charcoal); }

    .wrap {
      width: 100%;
      max-width: var(--max);
      margin-inline: auto;
      padding-inline: var(--pad);
    }

    .mono {
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* Header */

    .top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding-block: 26px;
      border-bottom: 1px solid var(--line-dark);
      color: var(--on-dark);
    }

    .brand {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -2px;
      line-height: 1;
      color: var(--ivory);
    }

    .brand i,
    .foot-brand i {
      font-style: normal;
      color: var(--gold);
    }

    .top-note { color: var(--on-dark-dim); text-align: center; }

    .nav {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 34px;
      font-size: 12px;
    }

    .nav a:last-child {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 18px;
      border: 1px solid var(--stone);
      color: var(--ivory);
      border-radius: 99px;
    }

    .menu-toggle {
      display: none;
      min-height: 40px;
      padding: 0 16px;
      border: 1px solid var(--stone);
      border-radius: 99px;
      background: transparent;
      color: var(--ivory);
      font-family: var(--sans);
      cursor: pointer;
    }

    /* Hero */

    .dark {
      background: var(--charcoal);
      color: var(--ivory);
      position: relative;
      overflow: hidden;
    }

    .hero { position: relative; padding-block: 56px 0; }

    .hero-meta {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      color: var(--gold);
      margin-bottom: 34px;
    }

    .hero-meta span:last-child { color: var(--on-dark-dim); text-align: right; }

    .hero h1 {
      position: relative;
      z-index: 2;
      margin: 0;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(68px, 13.6vw, 226px);
      line-height: .84;
      letter-spacing: -.045em;
    }

    .hero h1 span { display: block; }
    .hero h1 .l2 { padding-left: clamp(40px, 14vw, 260px); }
    .hero h1 em { color: var(--gold); font-style: normal; }

    .hero-lower {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
      gap: clamp(30px, 6vw, 90px);
      align-items: start;
      margin-top: 48px;
      padding-bottom: 96px;
    }

    .hero-copy-block { max-width: 430px; }

    .hero-copy {
      max-width: 430px;
      margin: 0;
      color: var(--on-dark);
      font-size: 15px;
      line-height: 1.9;
    }

    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 16px;
      min-height: 52px;
      padding: 0 24px;
      border-radius: 99px;
      font-size: 12px;
      font-weight: 600;
      transition: transform .2s ease, background-color .2s ease, border-color .2s ease, color .2s ease;
    }

    .btn:active { transform: translateY(0); }
    .btn-p { background: var(--gold); color: var(--charcoal); }
    .btn-s { border: 1px solid var(--stone); color: var(--ivory); }
    .btn-d { background: var(--charcoal); color: var(--ivory); }

    /* Arc and portrait */

    .arc {
      position: absolute;
      z-index: 0;
      right: -14vw;
      top: 4vw;
      width: 78vw;
      max-width: 1250px;
      aspect-ratio: 1;
      border-radius: 50%;
      pointer-events: none;
      background: radial-gradient(
        circle,
        transparent 61%,
        rgba(216, 189, 120, .07) 62%,
        rgba(216, 189, 120, .5) 66.5%,
        rgba(216, 189, 120, .06) 71%,
        transparent 72%
      );
    }

    .arc::after {
      content: "";
      position: absolute;
      inset: 11%;
      border-radius: 50%;
      border: 1px solid rgba(216, 189, 120, .22);
    }

    .portrait {
      position: absolute;
      z-index: 1;
      bottom: 0;
      left: 34%;
      width: min(36%, 560px);
      height: 96%;
      margin: 0;
      pointer-events: none;
    }

    .portrait img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center bottom;
    }

    /* Workflow panel */

    .panel {
      position: relative;
      width: 100%;
      max-width: 460px;
      margin-left: auto;
      padding: 26px 28px 24px;
      background: var(--ivory);
      color: var(--charcoal);
    }

    .panel::before {
      content: "";
      position: absolute;
      inset: 14px -14px -14px 14px;
      border: 1px solid var(--gold);
      z-index: -1;
    }

    .panel-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding-bottom: 18px;
      border-bottom: 1px solid var(--charcoal);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }

    .panel-top span:last-child { color: var(--gold-dark); }

    .flow { display: grid; margin-top: 6px; }

    .node {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 14px;
      padding: 22px 0;
      border-bottom: 1px solid var(--line);
    }

    .node .no { font-family: var(--display); font-size: 36px; line-height: .8; color: var(--gold-dark); }
    .node h3 { margin: 0; font-family: var(--display); font-weight: 400; font-size: 25px; line-height: 1.05; }
    .node p { margin: 7px 0 0; color: var(--body); font-size: 12px; line-height: 1.6; }
    .node .tag { font-size: 9px; letter-spacing: 1.6px; font-weight: 600; color: var(--gold-dark); }

    .node.main {
      margin-inline: -28px;
      padding-inline: 28px;
      background: var(--charcoal);
      color: var(--ivory);
    }

    .node.main .no,
    .node.main .tag { color: var(--gold); }
    .node.main p { color: var(--on-dark); }

    .panel-bottom {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      margin-top: 18px;
      font-size: 10px;
      line-height: 1.6;
      color: var(--body);
    }

    .panel-bottom .st { color: var(--gold-dark); font-weight: 600; text-align: right; }

    /* Capability strip */

    .caps {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-top: 1px solid var(--line-dark);
    }

    .cap {
      padding: 26px var(--pad);
      border-right: 1px solid var(--line-dark);
      color: var(--on-dark);
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .cap:last-child { border-right: 0; }
    .cap b { display: block; margin-bottom: 6px; color: var(--gold); font-size: 10px; font-weight: 600; }

    /* Shared sections */

    .section { padding-block: clamp(80px, 10vw, 150px); }

    .kicker { display: flex; align-items: center; gap: 12px; color: var(--gold-dark); }
    .kicker::before { content: ""; width: 26px; height: 1px; background: currentColor; }

    h2 { margin: 0; font-family: var(--display); font-weight: 400; letter-spacing: -.035em; }

    .sv-head {
      display: grid;
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: clamp(50px, 7vw, 100px);
    }

    .sv-head h2 { max-width: 12ch; font-size: clamp(54px, 9.6vw, 160px); line-height: .88; }
    .sv-head h2 em { font-style: italic; color: var(--gold-dark); }

    .intro { max-width: 480px; margin: 0 0 0 auto; color: var(--body); font-size: 14px; line-height: 1.9; }

    /* Services */

    .service-list { border-top: 1px solid var(--charcoal); }

    .service {
      display: grid;
      grid-template-columns: 70px minmax(0, 1.5fr) minmax(0, 1fr) 40px;
      gap: 30px;
      align-items: start;
      padding-block: 40px 44px;
      border-bottom: 1px solid var(--charcoal);
    }

    .service-number { padding-top: 14px; color: var(--gold-dark); font-size: 11px; font-weight: 600; letter-spacing: 1px; }

    .service h3 {
      margin: 0;
      font-family: var(--display);
      font-weight: 400;
      font-size: clamp(38px, 5.6vw, 92px);
      line-height: .95;
      letter-spacing: -.03em;
    }

    /* Even rows: full-bleed charcoal band that stays aligned on wide screens */
    .service:nth-child(even) {
      background: var(--charcoal);
      color: var(--ivory);
      box-shadow: 0 0 0 100vmax var(--charcoal);
      clip-path: inset(0 -100vmax);
    }

    .service:nth-child(even) .service-number,
    .service:nth-child(even) .service-detail,
    .service:nth-child(even) .service-arrow { color: var(--gold); }
    .service:nth-child(even) p { color: var(--on-dark); }

    .service-body p { max-width: 380px; margin: 8px 0 0; color: var(--body); font-size: 13px; line-height: 1.9; }
    .service-detail { margin-top: 18px; color: var(--stone); font-size: 9px; font-weight: 600; letter-spacing: 1.8px; }

    .service-arrow { font-family: var(--display); font-size: 38px; line-height: 1; text-align: right; color: var(--charcoal); }

    /* Approach */

    .approach { position: relative; overflow: hidden; background: var(--paper-deep); }

    .approach::before {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(21, 21, 21, .05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(21, 21, 21, .05) 1px, transparent 1px);
      background-size: 64px 64px;
      -webkit-mask-image: linear-gradient(90deg, transparent 30%, #000);
      mask-image: linear-gradient(90deg, transparent 30%, #000);
    }

    .approach > .wrap { position: relative; }

    .ap-head {
      display: grid;
      grid-template-columns: 1.4fr .6fr;
      gap: 40px;
      align-items: end;
      margin-bottom: clamp(50px, 6vw, 90px);
    }

    .ap-head h2 { margin-top: 26px; font-size: clamp(50px, 8vw, 132px); line-height: .9; }
    .ap-note { color: var(--stone); line-height: 1.8; text-align: right; }
    .ap-sub { max-width: 460px; margin: 30px 0 0; color: var(--body); font-size: 14px; line-height: 1.9; }

    .steps { display: grid; grid-template-columns: repeat(3, 1fr); align-items: start; }

    .principle { position: relative; padding: 34px 30px 60px 0; border-top: 1px solid var(--charcoal); }
    .principle + .principle { padding-left: 30px; border-left: 1px solid var(--charcoal); }
    .p2 { margin-top: 70px; }
    .p3 { margin-top: 140px; }

    .principle-number {
      margin-bottom: 34px;
      font-family: var(--display);
      font-size: clamp(130px, 17vw, 290px);
      line-height: .75;
      letter-spacing: -.05em;
      color: transparent;
      -webkit-text-stroke: 1px var(--gold-dark);
    }

    .principle h3 { margin: 0 0 14px; font-family: var(--display); font-weight: 400; font-size: clamp(28px, 3vw, 44px); line-height: 1; }
    .principle p { max-width: 320px; margin: 0; color: var(--body); font-size: 13px; line-height: 1.9; }

    /* Contact */

    .contact { padding-block: clamp(80px, 10vw, 150px) 0; background: var(--gold); color: var(--charcoal); }
    .contact .kicker { color: var(--charcoal); }

    .contact h2 { margin-top: 30px; font-size: clamp(58px, 11.4vw, 200px); line-height: .84; letter-spacing: -.045em; }
    .contact h2 em { font-style: italic; }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(30px, 6vw, 100px);
      margin-top: clamp(50px, 6vw, 90px);
      padding-block: 36px 56px;
      border-top: 1px solid var(--charcoal);
    }

    .contact-copy { max-width: 420px; margin: 0; font-size: 15px; line-height: 1.9; }
    .contact-action p { max-width: 380px; margin: 0 0 24px; font-size: 13px; line-height: 1.9; }

    /* Footer */

    .footer { overflow: hidden; background: var(--charcoal); color: var(--on-dark); }

    .foot-main {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 30px;
      align-items: center;
      padding-block: 34px;
      border-bottom: 1px solid var(--line-dark);
      font-size: 11px;
    }

    .foot-main .st { color: var(--ivory); font-family: var(--display); font-size: 22px; text-align: center; }
    .foot-links { display: flex; justify-content: flex-end; gap: 24px; }
    .foot-brand { color: var(--ivory); font-size: 23px; font-weight: 700; letter-spacing: -1.5px; }

    .giant {
      height: .62em;
      margin: 0 0 0 -.03em;
      padding-top: .1em;
      overflow: hidden;
      color: var(--ivory);
      font-family: var(--display);
      font-size: clamp(150px, 36vw, 640px);
      font-weight: 400;
      line-height: .72;
      letter-spacing: -.06em;
      white-space: nowrap;
      user-select: none;
    }

    .giant i { font-style: normal; color: var(--gold); }

    .foot-bottom {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding-block: 16px;
      border-top: 1px solid var(--line-dark);
      color: var(--on-dark-dim);
      font-size: 9px;
      letter-spacing: .5px;
    }

    /* Hover states (pointer devices only) */

    @media (hover: hover) {
      .nav a:not(:last-child),
      .foot-links a { transition: color .2s ease; }

      .nav a:not(:last-child):hover,
      .foot-links a:hover { color: var(--gold); }

      .nav a:last-child { transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
      .nav a:last-child:hover { background: var(--ivory); border-color: var(--ivory); color: var(--charcoal); }

      .menu-toggle:hover { border-color: var(--ivory); }

      .btn:hover { transform: translateY(-2px); }
      .btn-p:hover { background: var(--gold-soft); }
      .btn-s:hover { border-color: var(--ivory); }
      .btn-d:hover { background: color-mix(in srgb, var(--charcoal) 85%, var(--gold)); }

      .service h3 { transition: transform .3s ease; }
      .service:hover h3 { transform: translateX(10px); }
      .service-arrow { transition: transform .3s ease; }
      .service:hover .service-arrow { transform: translate(4px, -4px); }
    }

    /* Tablet */

    @media (max-width: 1000px) {
      .top { grid-template-columns: 1fr auto; }
      .top-note { display: none; }

      .hero-lower { grid-template-columns: 1fr; margin-top: -30px; }
      .panel { max-width: none; }

      .portrait {
        position: relative;
        left: auto;
        width: min(78%, 440px);
        height: auto;
        aspect-ratio: 600 / 780;
        margin: -24px 0 0 auto;
      }

      .arc { width: 120vw; right: -40vw; top: 40vw; }

      .service { grid-template-columns: 44px minmax(0, 1fr) 28px; gap: 20px; }
      .service-body { grid-column: 2; }
      .service-arrow { grid-column: 3; grid-row: 1; }

      .ap-head { grid-template-columns: 1fr; }
      .ap-note { text-align: left; }

      .steps { grid-template-columns: 1fr; }
      .p2, .p3 { margin-top: 0; }
      .principle, .principle + .principle { padding: 30px 0 40px; border-left: 0; }
      .principle-number { margin-bottom: 24px; font-size: 150px; }

      .contact-grid { grid-template-columns: 1fr; }

      .caps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .cap { border-bottom: 1px solid var(--line-dark); }
      .cap:nth-child(3) { border-right: 0; }
      .cap:nth-child(n+4) { border-bottom: 0; }

      .foot-main { grid-template-columns: 1fr; }
      .foot-main .st { text-align: left; }
      .foot-links { justify-content: flex-start; flex-wrap: wrap; }
      .intro { margin-left: 0; }
    }

    /* Mobile */

    @media (max-width: 560px) {
      .top { row-gap: 0; padding-block: 20px; }
      .brand { grid-area: 1 / 1; }
      .menu-toggle { display: inline-flex; align-items: center; grid-area: 1 / 2; }

      .nav {
        display: none;
        grid-area: 2 / 1 / 3 / 3;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding-top: 18px;
        font-size: 14px;
      }

      .top.is-open .nav { display: flex; }

      .nav a:not(:last-child) { padding-block: 16px; border-bottom: 1px solid var(--line-dark); }
      .nav a:last-child { justify-content: space-between; margin-top: 18px; padding: 15px 20px; }

      .hero { padding-top: 38px; }
      .hero-meta { font-size: 8px; letter-spacing: 1.2px; }
      .hero h1 { font-size: clamp(57px, 13vw, 78px); }
      .hero h1 .l2 { padding-left: 24px; }
      .hero-lower { margin-top: -24px; }

      .hero-actions { align-items: stretch; flex-direction: column; }
      .hero-actions .btn { justify-content: space-between; width: 100%; }

      .panel { padding: 22px 20px 20px; }
      .panel::before { inset: 10px -8px -10px 8px; }

      .node { grid-template-columns: 38px minmax(0, 1fr); gap: 10px; }
      .node .tag { display: none; }
      .node .no { font-size: 32px; }
      .node h3 { font-size: 23px; }
      .node.main { margin-inline: -20px; padding-inline: 20px; }
      .panel-bottom { font-size: 9px; }

      .caps { grid-template-columns: 1fr 1fr; }
      .cap { padding: 20px var(--pad); font-size: 10px; }
      .cap:nth-child(2) { border-right: 0; }
      .cap:nth-child(3) { border-right: 1px solid var(--line-dark); }
      .cap:nth-child(n+4) { border-bottom: 0; }

      .sv-head h2 { font-size: clamp(52px, 12vw, 72px); }

      .service { grid-template-columns: 30px minmax(0, 1fr) 20px; gap: 12px; padding-block: 30px; }
      .service h3 { font-size: clamp(34px, 8.5vw, 48px); }
      .service-number { padding-top: 8px; font-size: 10px; }
      .service-arrow { font-size: 30px; }
      .service-body p { font-size: 12px; }

      .ap-head h2 { font-size: clamp(48px, 11vw, 66px); }
      .principle-number { font-size: 125px; }

      .contact h2 { font-size: clamp(54px, 12vw, 76px); }

      .foot-bottom { flex-direction: column; gap: 6px; }
      .foot-links { gap: 18px; }
      .giant { font-size: 36vw; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition: none !important; animation: none !important; }
    }
  </style>
</head>

<body>
  <div class="dark">
    <div class="arc" aria-hidden="true"></div>

    <div class="wrap">
      <header class="top" id="top">
        <a class="brand" href="/" aria-label="Aklov home">aklov<i>.</i></a>
        <span class="top-note mono">Business systems studio</span>

        <button class="menu-toggle mono" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>

        <nav class="nav" id="site-nav" aria-label="Main navigation">
          <a href="#solutions">Solutions</a>
          <a href="#approach">Approach</a>
          <a href="#contact">Let’s talk <span aria-hidden="true">↗</span></a>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-meta mono">
            <span>Websites, business systems &amp; digital solutions</span>
            <span>System study / 001</span>
          </div>

          <h1 id="hero-title">
            <span class="l1">Better systems.</span>
            <span class="l2"><em>Better business.</em></span>
          </h1>

          <figure class="portrait">
            <img src={portrait.src} alt={portrait.alt} width="600" height="780" />
          </figure>

          <div class="hero-lower">
            <div class="hero-copy-block">
              <p class="hero-copy">
                The way a business operates matters. Aklov helps growing businesses build a stronger online presence and bring customer workflows, everyday processes and disconnected tools into systems that work with the people behind them.
              </p>

              <div class="hero-actions">
                <a class="btn btn-p" href="#contact">
                  Discuss a business challenge <span aria-hidden="true">↗</span>
                </a>
                <a class="btn btn-s" href="#solutions">
                  Explore capabilities <span aria-hidden="true">↓</span>
                </a>
              </div>
            </div>

            <div class="panel" role="img" aria-label="Illustrative business systems diagram showing customer enquiries moving through connected workflows into coordinated operations.">
              <div class="panel-top">
                <span>A connected operation</span>
                <span>System study / 001</span>
              </div>

              <div class="flow">
                <div class="node">
                  <div class="no">01</div>
                  <div>
                    <h3>Customer enquiry</h3>
                    <p>Capture the incoming request</p>
                  </div>
                  <span class="tag">INPUT</span>
                </div>

                <div class="node main">
                  <div class="no">02</div>
                  <div>
                    <h3>Connected workflow</h3>
                    <p>Route tasks, actions and follow-up</p>
                  </div>
                  <span class="tag">PROCESS</span>
                </div>

                <div class="node">
                  <div class="no">03</div>
                  <div>
                    <h3>Coordinated operations</h3>
                    <p>Keep work and people aligned</p>
                  </div>
                  <span class="tag">OUTPUT</span>
                </div>
              </div>

              <div class="panel-bottom">
                <span>Illustrative workflow<br />Every business is different.</span>
                <span class="st">● Designed with purpose</span>
              </div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <div class="caps" aria-label="Core capabilities">
      <div class="cap"><b>01</b>Website design</div>
      <div class="cap"><b>02</b>Customer &amp; sales systems</div>
      <div class="cap"><b>03</b>Workflow automation</div>
      <div class="cap"><b>04</b>Custom applications</div>
      <div class="cap"><b>05</b>Integrations &amp; reporting</div>
    </div>
  </div>

  <section class="section" id="solutions">
    <div class="wrap">
      <div class="sv-head">
        <div class="kicker mono">01 / Capabilities</div>
        <h2>Make the moving parts <em>work together.</em></h2>
        <p class="intro">
          From a well-designed website to better-connected business operations, the right solution starts with understanding the goal, the people and the problem to be solved.
        </p>
      </div>

      <div class="service-list">
        {services.map((service) => (
          <article class="service">
            <div class="service-number">{service.number}</div>
            <h3>{service.title}</h3>
            <div class="service-body">
              <p>{service.description}</p>
              <div class="service-detail">{service.detail}</div>
            </div>
            <div class="service-arrow" aria-hidden="true">↗</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section approach" id="approach">
    <div class="wrap">
      <div class="ap-head">
        <div>
          <div class="kicker mono">02 / The approach</div>
          <h2>Understand first. Build with purpose.</h2>
          <p class="ap-sub">
            A website or business system should make things clearer for the people who use it. That starts before choosing a visual direction, tools or automations.
          </p>
        </div>

        <div class="ap-note mono">
          Clear thinking before<br />technical complexity.
        </div>
      </div>

      <div class="steps">
        {principles.map((principle, index) => (
          <article class:list={['principle', `p${index + 1}`]}>
            <div class="principle-number" aria-hidden="true">{principle.number}</div>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <div class="kicker mono">Start with the real problem</div>
      <h2>Where could things work better than <em>they do today?</em></h2>

      <div class="contact-grid">
        <p class="contact-copy">
          Tell us about a website that needs a stronger presence, a process that takes too much effort, a workflow that keeps breaking down or a system your business has outgrown.
        </p>

        <div class="contact-action">
          <p>
            A useful conversation starts with understanding what is happening today and what needs to work better.
          </p>
          <a class="btn btn-d" href="mailto:aklovup@gmail.com">
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="wrap">
      <div class="foot-main">
        <a class="foot-brand" href="/" aria-label="Aklov home">aklov<i>.</i></a>
        <div class="st">Websites and business systems, thoughtfully built.</div>
        <div class="foot-links">
          <a href="#solutions">Capabilities</a>
          <a href="#approach">Approach</a>
          <a href="#contact">Contact</a>
        </div>
      </div>

      <div class="foot-bottom">
        <span>© {new Date().getFullYear()} Aklov. All rights reserved.</span>
        <span>Built around the way business works.</span>
      </div>
    </div>

    <div class="giant" aria-hidden="true">aklov<i>.</i></div>
  </footer>

  <script>
    const header = document.getElementById('top');
    const toggle = header?.querySelector('.menu-toggle');

    const setOpen = (open) => {
      header?.classList.toggle('is-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (toggle) toggle.textContent = open ? 'Close' : 'Menu';
    };

    toggle?.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    header?.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  </script>
</body>
</html>