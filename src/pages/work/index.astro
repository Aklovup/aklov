---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { orderProjects } from '../../lib/projectOrder';
import ProjectGallery from '../../components/work/ProjectGallery.astro';
import KineticSculpture from '../../components/experimental/KineticSculpture.astro';
import { links } from '../../data/links';
import { mediaPreview } from '../../lib/media';
import { categoryLabel } from '../../data/projectCategories';
const projects = orderProjects(await getCollection('projects'));
const worldProjects = projects.map(({data}) => ({slug:data.slug, title:data.title, category:categoryLabel(data.primaryCategory), type:data.projectType, src:data.cover.poster || mediaPreview(data.cover.url)?.src || (data.cover.type === 'image' ? data.cover.url : undefined)}));
---

<BaseLayout title="Work — Aklov®" description="Aklov portfolio: client projects and independent concepts across websites, customer and sales systems, workflow automation, custom applications, integrations and reporting.">
  <div class="work-experiment">
    <section class="kinetic-hero work-intro" aria-labelledby="work-title" data-kinetic-hero>
      <KineticSculpture projects={worldProjects} />
      <div class="hero-registration"><span>Portfolio / Aklov</span><span>{String(projects.length).padStart(2,'0')} projects — 05 categories</span></div>
      <p class="world-gesture-hint" hidden>Drag or swipe to explore</p>
      <div class="world-heading"><h1 id="work-title">Work<span>.</span></h1><p>Client projects<br/><em>&amp; independent concepts.</em></p></div>
      <div class="world-project-panel">
        <div class="world-project-meta"><span data-world-category>{worldProjects[0].category}</span><span><span data-form-number>01</span> / {String(projects.length).padStart(2,'0')}</span></div>
        <h2 data-world-title>{worldProjects[0].title}</h2>
        <div class="world-controls" hidden role="group" aria-label="Explore projects in the scene">
          <button class="world-arrow" type="button" data-world-prev aria-label="Previous project">←</button>
          <button class="world-arrow" type="button" data-form-toggle aria-label="Next project">→</button>
          <button type="button" class="world-open" data-world-open>View project <span aria-hidden="true">↗</span></button>
        </div>
        <p class="world-status" role="status" aria-live="polite" data-world-status></p>
      </div>
      <div class="hero-baseline"><a href="#projects">Explore project index ↓</a><button type="button" data-motion-toggle aria-pressed="false" hidden>Pause motion</button><span aria-hidden="true">Aklov / Selected work</span></div>
    </section>
    <div class="index-surface">
      <div class="index-title"><span class="mono">Selected work</span><p>Built around<br/><em>the business.</em></p><span class="index-total">{String(projects.length).padStart(2,'0')}</span></div>
      <ProjectGallery projects={projects}/>
    </div>
    <section class="experiment-close" aria-label="Contact">
      <span class="mono">Start a conversation</span>
      <a href={links.contact}>Let's talk about<br/><em>your project.</em><span aria-hidden="true">↗</span></a>
      <a class="back-index" href="#work-title">Back to top ↑</a>
    </section>
  </div>
</BaseLayout>

<style>
  .work-experiment { --focus-color: var(--gold); }
  .kinetic-hero { position: relative; isolation: isolate; overflow: hidden; height: 100svh; min-height: 800px; background: #0a1012; color: var(--ivory); }
  .hero-registration { position: absolute; z-index: 3; top: 126px; left: var(--pad); right: var(--pad); display: flex; justify-content: space-between; gap: 20px; font: 500 10px/1.5 var(--sans); text-transform: uppercase; letter-spacing: 1.5px; color: #c9c6bb; }
  .world-gesture-hint[hidden] { display:none; }
  .world-gesture-hint { position:absolute; z-index:2; top:158px; left:var(--pad); color:#d6cba9; font:500 11px var(--sans); letter-spacing:.5px; pointer-events:none; }
  .world-heading { position: absolute; z-index: 2; left: var(--pad); bottom: 126px; pointer-events: none; }
  h1 { margin: 0 0 18px; font: 400 clamp(100px,12.6vw,210px)/.8 var(--display); letter-spacing: -.055em; }
  h1 span { color: var(--gold); }
  .world-heading p { margin: 0; font: 400 clamp(22px,2.2vw,34px)/1.15 var(--display); }
  .world-heading em { color: var(--gold); }
  .world-project-panel { position: absolute; bottom: 120px; right: var(--pad); width: min(380px,32vw); z-index: 3; padding-top: 18px; border-top: 1px solid #d8bd7870; }
  .world-project-meta { display: flex; justify-content: space-between; align-items: start; gap: 18px; color: #d6cba9; font-size: 11px; line-height: 1.6; }
  .world-project-panel h2 { margin: 16px 0 20px; font: 400 clamp(28px,2.7vw,43px)/1.05 var(--display); letter-spacing: -.02em; }
  .world-controls[hidden] { display: none; }
  .world-controls { display: flex; align-items: center; gap: 10px; }
  .world-controls button, .hero-baseline button { min-height: 44px; color: var(--ivory); background: none; border: 0; font: 500 12px var(--sans); cursor: pointer; }
  .world-controls .world-arrow { width: 46px; height: 46px; border: 1px solid #ffffff65; border-radius: 50%; font-size: 22px; }
  .world-controls .world-open { display: flex; justify-content: space-between; align-items: center; gap: 32px; padding: 0; margin-left: 14px; border-bottom: 1px solid #d8bd7870; }
  .world-status { min-height: 1.5em; margin: 10px 0 0; font-size: 11px; color: var(--gold); }
  .hero-baseline { position: absolute; bottom: 22px; left: var(--pad); right: var(--pad); display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 10px; border-top: 1px solid #ffffff30; font-size: 11px; }
  .hero-baseline a { display: inline-flex; align-items: center; min-height: 44px; }
  .hero-baseline button[hidden] { display: none; }
  @media(hover:hover) { .world-controls button:hover, .hero-baseline a:hover, .hero-baseline button:hover { color: var(--gold); border-color: var(--gold); } }
  .index-surface { background: #171814; color: var(--ivory); }
  .index-title { position: relative; display: grid; grid-template-columns: 1fr 2fr; align-items: start; gap: 32px; padding: 100px var(--pad) 60px; border-bottom: 1px solid #ffffff25; }
  .index-title > .mono { color: var(--gold); padding-top: 12px; }
  .index-title p { margin: 0; font: 400 clamp(52px,7vw,110px)/.95 var(--display); letter-spacing: -.04em; }
  .index-title p em { color: var(--gold); }
  .index-total { position: absolute; right: var(--pad); top: 80px; font: 400 80px var(--display); color: #ffffff38; }
  .experiment-close { position: relative; padding: 80px var(--pad) 56px; background: var(--gold); color: var(--charcoal); }
  .experiment-close > a:not(.back-index) { display: block; position: relative; width: 100%; margin-block: 48px 64px; font: 400 clamp(64px,10vw,160px)/.94 var(--display); letter-spacing: -.04em; }
  .experiment-close > a > span { position: absolute; right: 0; top: 0; font-family: var(--sans); font-weight: 400; }
  .back-index { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; border-bottom: 1px solid; }
  @media(max-width:800px) {
    .kinetic-hero { min-height: 900px; }
    .hero-registration { top: 110px; font-size: 9px; letter-spacing: .5px; }
    .world-gesture-hint { top:140px; font-size:10px; }
    .world-heading { top: 180px; bottom: auto; }
    h1 { font-size: clamp(96px,26vw,150px); margin-bottom: 14px; }
    .world-heading p { font-size: 22px; }
    .world-project-panel { width: auto; left: var(--pad); right: var(--pad); bottom: 112px; }
    .world-project-panel h2 { font-size: 32px; max-width: 28ch; }
    .world-project-meta { font-size: 10px; }
    .hero-baseline { bottom: max(14px,env(safe-area-inset-bottom)); gap: 10px; font-size: 10px; }
    .hero-baseline > span { display: none; }
    .index-title { grid-template-columns: 1fr; padding-top: 64px; gap: 28px; }
    .index-total { top: 60px; font-size: 54px; }
    .experiment-close > a:not(.back-index) { font-size: clamp(52px,11vw,88px); }
    .experiment-close > a > span { font-size: 40px; }
  }
</style>

<style is:global>
  /* Every override is scoped to this one experiment. Shared source files are untouched. */
  body:has(.work-experiment) .header-surface { position: absolute; z-index: 10; top: 0; left: 0; width: 100%; background: linear-gradient(#0a1012d9,transparent); color: var(--ivory); }
  body:has(.work-experiment) .top { border-color: #ffffff25; color: #e7e4db; }
  body:has(.work-experiment) .brand, body:has(.work-experiment) .nav a:last-child, body:has(.work-experiment) .menu-toggle { color: var(--ivory); }
  body:has(.work-experiment) .brand i, body:has(.work-experiment) .nav a[aria-current='page'] { color: var(--gold); }
  body:has(.work-experiment) .top-note { color: #b8b5ab; }
  body:has(.work-experiment) .top.is-open { background: #0a1012; }
  .work-experiment .gallery { padding-top: 30px; --body: #c2c0b6; --gold-dark: #d8bd78; --line: #ffffff25; --focus-color: #d8bd78; }
  .work-experiment .group-filters { border-color: #ffffff45; }
  .work-experiment .group-filters button, .work-experiment .filters button { color: #bbb9b0; font-size: 14px; }
  .work-experiment .group-filters button[aria-pressed='true'], .work-experiment .filters button[aria-pressed='true'] { color: var(--gold); border-bottom-color: var(--gold); }
  .work-experiment .group-filters button:focus-visible, .work-experiment .filters button:focus-visible { outline-color: var(--gold); }
  .work-experiment .project-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 80px 50px; }
  .work-experiment .project-card[data-layout] { grid-column: span 1; }
  .work-experiment .project-card[data-layout='0'], .work-experiment .project-card[data-layout='3'] { display: grid; grid-template-columns: 1.35fr .65fr; align-items: center; gap: clamp(28px,5vw,80px); grid-column: 1 / -1; padding-block: 36px; border-block: 1px solid #ffffff25; }
  .work-experiment .project-card[data-layout='3'] > .project-media { order: 2; }
  .work-experiment .project-card[data-layout='3'] { grid-template-columns: .65fr 1.35fr; }
  .work-experiment .project-card h2 { color: var(--ivory); font-size: clamp(36px,4.2vw,72px); }
  .work-experiment .project-card .card-copy { padding-top: 24px; }
  .work-experiment .project-card .project-description { font-size: 15px; }
  .work-experiment .project-open { color: var(--ivory); font-size: 14px; }
  .work-experiment .project-open:focus-visible, .work-experiment .card-footer a:focus-visible { outline-color: var(--gold); }
  .work-experiment .project-media { overflow: hidden; border: 1px solid #ffffff20; }
  .work-experiment .project-media > img { transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  .work-experiment .placeholder-bottom span:first-child, .work-experiment .placeholder-top span:last-child { visibility: hidden; }
  @media(hover:hover) { .work-experiment .project-card:hover .project-media > img { transform: scale(1.025); } .work-experiment .project-card:hover .project-open { color: var(--gold); } }
  @media(max-width:1000px) { .work-experiment .project-grid { gap: 54px 28px; } .work-experiment .project-card[data-layout='0'], .work-experiment .project-card[data-layout='3'] { grid-template-columns: 1fr 1fr; gap: 28px; } }
  @media(max-width:640px) {
    .work-experiment .project-grid { grid-template-columns: 1fr; gap: 54px; }
    .work-experiment .project-card[data-layout] { display: block; grid-column: 1 / -1; padding-block: 0; border: 0; }
    .work-experiment .project-card h2 { font-size: 40px; }
    .work-experiment .group-filters { gap: 10px; }
    .work-experiment .group-filters button { font-size: 13px; }
    .work-experiment .filters button { font-size: 12px; }
  }
</style>
