---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPortrait from '../../components/about/AboutPortrait.astro';
import CellularStructures from '../../components/about/CellularStructures.astro';
import { about, profile } from '../../data/about';
import { links } from '../../data/links';
import { getCollection } from 'astro:content';
import { mediaPreview } from '../../lib/media';

const proof = (await getCollection('projects')).find(({ data }) => data.slug === 'impex-automotive')!;
const proofPreview = mediaPreview(proof.data.cover.url)!;

const [firstName, ...surname] = profile.name.split(' ');
const [headlineStart, headlineEnd] = about.introduction.headline.split('understanding');
const [biographyStart, biographyEnd] = about.biography.heading.split('about me');
const [approachStart, approachEnd] = about.approach.heading.split('the work');
const [experienceStart, experienceEnd] = about.work.heading.split("I've done");
const [togetherStart, togetherEnd] = about.together.heading.split('together');
---

<BaseLayout title={about.metadata.title} description={about.metadata.description}>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="wrap hero-composition">
        <div class="hero-gold-plane" aria-hidden="true"></div>
        <CellularStructures />
        <p class="kicker mono hero-eyebrow">{about.introduction.eyebrow}</p>
        <h1 class="identity-name" id="about-title"><span class="identity-first">{firstName}</span>{' '}<span class="identity-surname">{surname.join(' ')}</span></h1>
        <div class="hero-statement">
          <p class="hero-principle">{headlineStart}<em>understanding</em>{headlineEnd}</p>
          <p class="designation">{profile.designation}</p>
        </div>
        <div class="hero-portrait"><AboutPortrait /></div>
      </div>
    </section>

    <div class="profile-story">
      <div class="intro-detail">
        <div class="wrap intro-detail-grid">
          <div class="intro-profile" data-reveal>
            <p class="personal-introduction" data-approved-copy>{about.introduction.paragraphs[4]}</p>
            <p data-approved-copy>{about.introduction.paragraphs[3]}</p>
          </div>
          <div class="intro-context" data-reveal data-reveal-delay="80">
            {about.introduction.paragraphs.slice(0, 3).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
          </div>
        </div>
      </div>

      <section class="section biography" aria-labelledby="biography-title">
        <div class="wrap biography-grid">
          <div class="section-heading" data-reveal>
            <h2 id="biography-title">{biographyStart}<em>about me</em>{biographyEnd}</h2>
          </div>
          <div class="reading-copy biography-copy" data-reveal>
            {about.biography.paragraphs.map((paragraph, index) => (
              <p class:list={{ lead: index === 0 }} data-approved-copy>{paragraph}</p>
            ))}
          </div>
        </div>
      </section>

      <section class="section approach" aria-labelledby="approach-title">
        <div class="wrap">
          <div class="section-heading" data-reveal>
            <h2 id="approach-title">{approachStart}<em>the work</em>{approachEnd}</h2>
          </div>
          <div class="approach-layout">
            <div class="approach-introduction" data-reveal>
              <p class="approach-lead" data-approved-copy>{about.approach.paragraphs[0]}</p>
              <div class="reading-copy">
                {about.approach.paragraphs.slice(1).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
              </div>
            </div>
            <div class="approach-sequence">
              <p class="sequence-introduction" data-approved-copy>{about.approach.sequenceIntroduction}</p>
              <ol class="stage-list" role="list">
                {about.approach.stages.map((stage) => (
                  <li data-reveal>
                    <span class="stage-number" aria-hidden="true">{stage.number}</span>
                    <h3>{stage.title}</h3>
                    <p data-approved-copy>{stage.description}</p>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        </div>
        <div class="wrap statement">
          <p class="approach-closing" data-reveal data-approved-copy>{about.approach.closing.split(/(makes sense|actually use it)/g).map((part) => (
            part === 'makes sense' || part === 'actually use it' ? <em>{part}</em> : part
          ))}</p>
        </div>
      </section>

      <section class="section experience" aria-labelledby="experience-title">
        <div class="wrap">
          <div class="experience-heading" data-reveal>
            <div class="section-heading">
              <h2 id="experience-title">{experienceStart}<em>I've done</em>{experienceEnd}</h2>
            </div>
            <figure class="experience-proof">
              <a href={links.workImpex} aria-label={`View project: ${proof.data.title}`}>
                <img src={proofPreview.src} srcset={proofPreview.srcset} sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 1000px) 32vw, 360px" width={proofPreview.width} height={proofPreview.height} alt={proof.data.cover.alt} loading="lazy" decoding="async" />
                <span class="proof-caption"><span>{proof.data.projectType}</span><strong>{proof.data.title}</strong><span aria-hidden="true">↗</span></span>
              </a>
            </figure>
          </div>
          <div class="experience-story reading-copy">
            <p class="lead" data-reveal data-approved-copy>{about.work.paragraphs[0]}</p>
            <div class="experience-column" data-reveal>{about.work.paragraphs.slice(1, 5).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}</div>
            <div class="experience-column" data-reveal data-reveal-delay="80">{about.work.paragraphs.slice(5).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}</div>
          </div>
          <a class="editorial-link" href={links.workClients} data-about-work-link>{about.work.cta}</a>
        </div>
      </section>

      <section class="section together" aria-labelledby="together-title">
        <div class="wrap">
          <div class="together-layout">
            <div class="section-heading" data-reveal>
              <h2 id="together-title">{togetherStart}<em>together</em>{togetherEnd}</h2>
            </div>
            <div class="together-story" data-reveal>
              <p class="lead" data-approved-copy>{about.together.paragraphs[0]}</p>
              <div class="reading-copy">
                {about.together.paragraphs.slice(1).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>

    <section class="closing" aria-labelledby="closing-title">
      <div class="wrap">
        <h2 id="closing-title" data-reveal>{about.closing.headline}</h2>
        <div class="closing-grid">
          <p data-approved-copy>{about.closing.paragraph}</p>
          <div class="closing-actions">
            <a class="btn btn-dark" href={links.contact} data-about-contact>{about.closing.primaryCta}</a>
            <a class="closing-work-link" href={links.work} data-about-work-secondary>{about.closing.secondaryCta}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page {
    --about-accent: color-mix(in srgb, var(--gold-dark) 85%, var(--charcoal));
    /* Richer display gold: 3.13:1 on ivory for these large text accents. */
    --about-display-gold: #a5852e;
  }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: var(--display); font-weight: 400; }
  h2 { font-size: clamp(46px, 5vw, 76px); line-height: 1; letter-spacing: -.035em; }
  /* The name, unframed portrait and gold plane occupy one shared composition. */
  .about-hero { background: var(--charcoal); color: var(--ivory); }
  .hero-composition { position: relative; isolation: isolate; container-type: inline-size; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto auto auto; row-gap: 12px; padding-block: clamp(32px, 2.8vw, 44px) clamp(48px, 5.4vw, 96px); }
  .hero-eyebrow { grid-column: 1 / 7; grid-row: 1; z-index: 2; margin-bottom: clamp(16px, 1.4vw, 24px); color: var(--gold); }
  .hero-gold-plane { grid-column: 8 / -1; grid-row: 1 / 4; height: 350px; align-self: start; background: var(--gold); z-index: 0; }
  .identity-name { grid-column: 1 / -1; grid-row: 2 / 5; display: grid; grid-template-columns: subgrid; grid-template-rows: subgrid; position: relative; z-index: 3; pointer-events: none; color: var(--ivory); letter-spacing: -.055em; line-height: .86; }
  .identity-name > span { display: block; white-space: nowrap; letter-spacing: -.055em; }
  .identity-first { grid-column: 1 / -1; grid-row: 1; font-size: clamp(100px, 26cqw, 440px); }
  .identity-surname { grid-column: 1 / -1; grid-row: 3; font-size: clamp(64px, 24.8cqw, 420px); }
  .hero-statement { grid-column: 1 / 5; grid-row: 3; z-index: 2; min-width: 0; padding-block: 4px 12px; }
  .hero-principle { max-width: 14ch; font-family: var(--display); font-size: clamp(28px, 2.4vw, 38px); line-height: 1.12; letter-spacing: -.025em; }
  .hero-principle em { color: var(--gold); font-style: italic; }
  .designation { max-width: 27ch; margin-top: 20px; color: var(--on-dark); font-size: 13px; line-height: 1.6; }
  .designation::before { content: ''; display: block; width: 28px; height: 1px; margin-bottom: 12px; background: var(--gold); }
  .hero-portrait { grid-column: 6 / -1; grid-row: 1 / 5; z-index: 1; width: 100%; max-width: 560px; margin-top: 12px; justify-self: center; align-self: start; pointer-events: none; }
  /* A shared left margin anchors the headings; the story occupies the wider right column. */
  .profile-story { background: var(--ivory); color: var(--charcoal); }
  .profile-story > .section > .wrap, .intro-detail > .wrap { max-width: var(--max); }
  .intro-detail { padding-block: clamp(40px, 5vw, 72px); }
  .intro-detail-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(36px, 7vw, 100px); align-items: start; }
  .intro-detail p { max-width: 62ch; color: var(--body); font-size: 16px; line-height: 1.85; }
  .intro-detail p + p { margin-top: 22px; }
  .intro-detail .personal-introduction { max-width: 27ch; color: var(--charcoal); font-family: var(--display); font-size: clamp(30px, 3.2vw, 50px); line-height: 1.12; letter-spacing: -.025em; }
  .intro-profile p + p { max-width: 57ch; margin-top: 28px; }
  .intro-context { padding-top: 8px; border-top: 1px solid var(--line); }
  .intro-context p:first-child { color: var(--charcoal); font-family: var(--display); font-size: clamp(26px, 2.1vw, 34px); line-height: 1.2; letter-spacing: -.02em; }
  .section { padding-bottom: clamp(44px, 5vw, 72px); }
  .section-heading { min-width: 0; }
  .section-heading h2 { max-width: 14ch; font-size: clamp(42px, 4.4vw, 68px); line-height: 1.02; }
  .section-heading h2 em { display: block; color: var(--about-display-gold); font-style: italic; }
  .reading-copy { max-width: 66ch; color: var(--body); font-size: 16px; line-height: 1.85; }
  .reading-copy p + p { margin-top: 20px; }
  .lead { color: var(--charcoal); font-family: var(--display); font-size: clamp(25px, 2.3vw, 34px); line-height: 1.3; letter-spacing: -.02em; }
  .biography-grid, .experience > .wrap, .together-layout { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 28px clamp(36px, 7vw, 100px); align-items: start; }
  .biography-copy .lead { margin-bottom: 26px; }

  /* Narrative and stages form one spread, rather than a centred essay. */
  .approach { --focus-color: var(--charcoal); }
  .approach > .wrap:not(.statement) { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); column-gap: clamp(36px, 7vw, 100px); border-top: 1px solid var(--line); padding-top: clamp(36px, 4vw, 56px); }
  .approach .section-heading { grid-column: 1; grid-row: 1; }
  .approach-layout { display: contents; }
  .approach-introduction { grid-column: 1; grid-row: 2; margin-top: 26px; }
  .approach-introduction .reading-copy { margin-top: 22px; font-size: 15px; }
  .approach-lead { font-family: var(--display); font-size: clamp(25px, 2.2vw, 32px); line-height: 1.3; letter-spacing: -.02em; }
  .approach-sequence { grid-column: 2; grid-row: 1 / span 2; min-width: 0; }
  .sequence-introduction { margin-bottom: 22px; color: var(--body); font-size: 15px; line-height: 1.85; }
  .stage-list { list-style: none; margin: 0; padding: 0; }
  .stage-list li { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 10px 20px; padding-block: 28px; border-bottom: 1px solid var(--line); }
  .stage-list li:first-child { padding-top: 0; }
  .stage-number { grid-column: 1; grid-row: 1 / span 2; color: var(--about-display-gold); font-family: var(--display); font-size: 48px; font-style: italic; line-height: 1; }
  .stage-list h3 { grid-column: 2; font-size: clamp(28px, 2.3vw, 36px); font-style: italic; line-height: 1.1; letter-spacing: -.025em; }
  .stage-list p { grid-column: 2; max-width: 56ch; color: var(--body); font-size: 16px; line-height: 1.8; }

  /* The only centred element is the deliberate pull statement, not the body copy. */
  .profile-story > .approach > .statement { max-width: 1180px; padding-top: clamp(40px, 5vw, 72px); }
  .approach-closing { max-width: 26ch; margin: 0 auto; color: var(--charcoal); font-family: var(--display); font-size: clamp(38px, 5vw, 76px); font-style: italic; line-height: 1.08; letter-spacing: -.025em; }
  .approach-closing em { color: var(--about-display-gold); font-style: inherit; }

  /* A single piece of real work anchors a magazine-like reading spread. */
  .experience > .wrap { grid-template-columns: minmax(0, .65fr) minmax(0, 1.35fr); }
  .experience-heading { min-width: 0; }
  .experience-story { max-width: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(28px, 3vw, 52px); }
  .experience-story > .lead { grid-column: 1 / -1; max-width: 47ch; }
  .experience-column { min-width: 0; max-width: 56ch; }
  .experience-proof { margin: 36px 0 0; max-width: 360px; }
  .experience-proof a { display: block; }
  .experience-proof img { display: block; width: 100%; height: auto; aspect-ratio: 1280 / 610; object-fit: cover; border: 1px solid var(--line); }
  .proof-caption { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .proof-caption > span:first-child { grid-column: 1 / -1; color: var(--body); font-size: 11px; }
  .proof-caption strong { font-family: var(--display); font-size: 28px; font-weight: 400; line-height: 1.1; }
  .proof-caption > span:last-child { align-self: center; font-size: 18px; }
  .experience-story .lead { margin-bottom: 24px; }
  .editorial-link { grid-column: 2; justify-self: start; display: inline-flex; align-items: center; min-height: 48px; padding-bottom: 4px; border-bottom: 1px solid currentColor; font-size: 13px; font-weight: 600; transition: color .2s ease; }
  .editorial-link:focus-visible { outline-color: var(--charcoal); }
  .together-layout { border-top: 1px solid var(--line); padding-top: clamp(32px, 4vw, 52px); }
  .together-story .lead { max-width: 34ch; margin-bottom: 24px; }

  /* A compact invitation ends the profile at the same editorial scale. */
  .closing { padding-block: clamp(40px, 5vw, 64px); background: var(--gold); color: var(--charcoal); }
  .closing > .wrap { max-width: var(--max); display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 28px clamp(36px, 7vw, 100px); align-items: start; }
  .closing h2 { max-width: 18ch; font-size: clamp(40px, 4.4vw, 64px); font-style: italic; line-height: 1.03; letter-spacing: -.035em; }
  .closing-grid > p { max-width: 58ch; font-size: 15px; line-height: 1.85; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: center; margin-top: 24px; }
  .closing-work-link { display: inline-flex; align-items: center; min-height: 52px; width: fit-content; padding-block: 8px; border-bottom: 1px solid currentColor; font-size: 13px; font-weight: 600; line-height: 1.6; transition: color .2s ease; }
  .closing a:focus-visible { outline-color: var(--charcoal); }
  @media (hover: hover) { .editorial-link:hover { color: var(--about-accent); } }
  @media (max-width: 1000px) {
    .experience > .wrap { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
    .experience-story { grid-template-columns: 1fr; gap: 24px; }
    .experience-story > .lead { margin-bottom: 0; }
    .hero-gold-plane { height: min(36vw, 270px); }
    .hero-portrait { max-width: 420px; }
    .hero-statement { grid-column: 1 / 6; }
    .hero-principle { font-size: clamp(28px, 3.6vw, 36px); }
    .approach > .wrap:not(.statement) { display: block; }
    .approach-introduction { margin-top: 24px; }
    .approach-introduction .reading-copy { max-width: 70ch; }
    .approach-sequence { margin-top: 32px; }
  }
  @media (max-width: 640px) {
    .hero-composition { grid-template-columns: repeat(6, minmax(0, 1fr)); row-gap: 18px; padding-block: 30px 24px; }
    .hero-eyebrow { grid-column: 1 / -1; margin-bottom: 6px; font-size: 9px; letter-spacing: 1.4px; }
    .hero-gold-plane { grid-column: 4 / -1; grid-row: 3; height: 70%; }
    .identity-first { font-size: clamp(94px, 40cqw, 240px); padding-bottom: clamp(18px, 5cqw, 30px); }
    .hero-statement { grid-column: 1 / 4; padding-block: 4px 14px; }
    .hero-principle { max-width: 14ch; font-size: clamp(23px, 5.9vw, 36px); }
    .designation { margin-top: 18px; padding-top: 0; font-size: 12px; }
    .designation::before { width: 22px; margin-bottom: 12px; }
    .hero-portrait { grid-column: 3 / -1; grid-row: 3 / 5; max-width: 360px; margin-top: 0; align-self: end; }
    .intro-detail-grid, .biography-grid, .experience > .wrap, .together-layout, .closing > .wrap { grid-template-columns: 1fr; gap: 24px; }
    .experience-proof { margin-top: 28px; }
    .intro-context { margin-top: 8px; padding-top: 24px; }
    .section-heading h2 { font-size: clamp(42px, 11vw, 60px); }
    .stage-list li { grid-template-columns: 40px minmax(0, 1fr); column-gap: 16px; padding-block: 24px; }
    .stage-number { font-size: 40px; }
    .stage-list h3 { font-size: 32px; }
    .editorial-link { grid-column: 1; }
    .closing h2 { font-size: clamp(40px, 10.5vw, 60px); }
    .closing-actions { flex-direction: column; align-items: stretch; }
    .closing-actions .btn { width: 100%; }
    .closing-work-link { align-self: flex-start; }
  }
</style>



