---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPortrait from '../../components/about/AboutPortrait.astro';
import { about } from '../../data/about';
import { links } from '../../data/links';

const [headlineStart, headlineEnd] = about.introduction.headline.split('understanding');
---

<BaseLayout title={about.metadata.title} description={about.metadata.description}>
  <div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
      <div class="wrap hero-composition">
        <div class="hero-heading">
          <p class="kicker mono">{about.introduction.eyebrow}</p>
          <h1 id="about-title">{headlineStart}<em>understanding{headlineEnd}</em></h1>
        </div>
        <div class="hero-portrait"><AboutPortrait /></div>
        <div class="hero-opening">
          {about.introduction.paragraphs.slice(0, 3).map((paragraph, index) => (
            <p class:list={{ 'opening-line': index === 0 }} data-approved-copy>{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <div class="intro-detail">
      <div class="wrap intro-detail-grid">
        {about.introduction.paragraphs.slice(3).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
      </div>
    </div>

    <section class="section biography" aria-labelledby="biography-title">
      <div class="wrap biography-grid">
        <div class="section-heading">
          <span class="section-number" aria-hidden="true">01</span>
          <h2 id="biography-title">{about.biography.heading}</h2>
        </div>
        <div class="reading-copy biography-copy">
          {about.biography.paragraphs.map((paragraph, index) => (
            <p class:list={{ lead: index === 0 }} data-approved-copy>{paragraph}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="section approach" aria-labelledby="approach-title">
      <div class="wrap">
        <div class="section-heading">
          <span class="section-number" aria-hidden="true">02</span>
          <h2 id="approach-title">{about.approach.heading}</h2>
        </div>
        <div class="approach-introduction">
          <p class="approach-lead" data-approved-copy>{about.approach.paragraphs[0]}</p>
          <div class="reading-copy">
            {about.approach.paragraphs.slice(1).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
          </div>
        </div>
        <p class="sequence-introduction" data-approved-copy>{about.approach.sequenceIntroduction}</p>
        <ol class="stage-list" role="list">
          {about.approach.stages.map((stage) => (
            <li>
              <span class="stage-number" aria-hidden="true">{stage.number}</span>
              <h3>{stage.title}</h3>
              <p data-approved-copy>{stage.description}</p>
            </li>
          ))}
        </ol>
        <p class="approach-closing" data-approved-copy>{about.approach.closing}</p>
      </div>
    </section>

    <section class="section experience" aria-labelledby="experience-title">
      <div class="wrap">
        <div class="experience-heading">
          <div class="section-heading">
            <span class="section-number" aria-hidden="true">03</span>
            <h2 id="experience-title">{about.work.heading}</h2>
          </div>
          <p class="lead" data-approved-copy>{about.work.paragraphs[0]}</p>
        </div>
        <div class="experience-story">
          <div class="work-experience">
            {about.work.paragraphs.slice(1, 5).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
          </div>
          <div class="reading-copy experience-reflection">
            {about.work.paragraphs.slice(5).map((paragraph, index) => (
              <p class:list={{ 'reflection-line': index === 2 }} data-approved-copy>{paragraph}</p>
            ))}
          </div>
        </div>
        <a class="editorial-link" href={links.work} data-about-work-link>{about.work.cta}</a>
      </div>
    </section>

    <section class="section together" aria-labelledby="together-title">
      <div class="wrap">
        <div class="together-heading">
          <div class="section-heading">
            <span class="section-number" aria-hidden="true">04</span>
            <h2 id="together-title">{about.together.heading}</h2>
          </div>
          <p class="lead" data-approved-copy>{about.together.paragraphs[0]}</p>
        </div>
        <div class="together-copy">
          <div class="reading-copy">
            {about.together.paragraphs.slice(1, 3).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
          </div>
          <div class="reading-copy">
            {about.together.paragraphs.slice(3).map((paragraph) => <p data-approved-copy>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="wrap">
        <h2 id="closing-title">{about.closing.headline}</h2>
        <div class="closing-grid">
          <p data-approved-copy>{about.closing.paragraph}</p>
          <div class="closing-actions">
            <a class="btn btn-dark" href={links.contact} data-about-contact>{about.closing.primaryCta}</a>
            <a class="btn btn-line" href={links.work} data-about-work-secondary>{about.closing.secondaryCta}</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-page { --about-accent: color-mix(in srgb, var(--gold-dark) 85%, var(--charcoal)); }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { font-family: var(--display); font-weight: 400; }
  h2 { font-size: clamp(48px, 6.5vw, 112px); line-height: .94; letter-spacing: -.035em; }
  .about-hero { padding-block: clamp(40px, 5vw, 72px) clamp(48px, 6vw, 88px); background: var(--charcoal); color: var(--ivory); }
  .hero-composition { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); grid-template-rows: auto 1fr; gap: 32px clamp(32px, 6vw, 96px); align-items: start; }
  .hero-heading { grid-column: 1; grid-row: 1; }
  .hero-heading .kicker { color: var(--gold); }
  h1 { max-width: 15ch; margin-top: 28px; font-size: clamp(56px, 6.8vw, 118px); line-height: .94; letter-spacing: -.04em; }
  h1 em { color: var(--gold); font-style: italic; }
  .hero-portrait { grid-column: 2; grid-row: 1 / span 2; align-self: end; }
  .hero-opening { grid-column: 1; grid-row: 2; max-width: 55ch; color: var(--on-dark); font-size: 14px; line-height: 1.9; }
  .hero-opening p + p { margin-top: 18px; }
  .hero-opening .opening-line { margin-bottom: 24px; color: var(--ivory); font-family: var(--display); font-size: clamp(26px, 2.5vw, 38px); line-height: 1.2; }
  .intro-detail { padding-block: clamp(40px, 5vw, 72px); }
  .intro-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .intro-detail p { max-width: 58ch; color: var(--body); font-size: 15px; line-height: 1.9; }
  .intro-detail p:first-child { color: var(--charcoal); font-family: var(--display); font-size: clamp(26px, 2.5vw, 38px); line-height: 1.28; letter-spacing: -.02em; }
  .section { padding-block: clamp(56px, 7vw, 112px); }
  .section-heading { min-width: 0; }
  .section-number { display: block; margin-bottom: 26px; color: var(--about-accent); font-size: 11px; line-height: 1.6; letter-spacing: 2px; }
  .biography > .wrap { padding-top: clamp(32px, 4vw, 56px); border-top: 1px solid var(--line); }
  .biography-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(32px, 8vw, 140px); }
  .biography h2 { max-width: 9ch; }
  .reading-copy { max-width: 62ch; color: var(--body); font-size: 15px; line-height: 1.9; }
  .reading-copy p + p { margin-top: 20px; }
  .lead { color: var(--charcoal); font-family: var(--display); font-size: clamp(26px, 2.4vw, 38px); line-height: 1.3; letter-spacing: -.02em; }
  .biography-copy .lead { margin-bottom: 26px; }
  .approach { background: var(--charcoal); color: var(--ivory); }
  .approach .section-number { color: var(--gold); }
  .approach h2 { max-width: 14ch; }
  .approach-introduction { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 8vw, 140px); margin-top: clamp(36px, 5vw, 72px); }
  .approach-lead { max-width: 24ch; font-family: var(--display); font-size: clamp(28px, 3vw, 44px); line-height: 1.2; letter-spacing: -.02em; }
  .approach .reading-copy { color: var(--on-dark); }
  .sequence-introduction { margin-top: clamp(36px, 5vw, 72px); color: var(--on-dark); font-size: 14px; line-height: 1.8; }
  .stage-list { list-style: none; margin: 24px 0 0; padding: 0; border-top: 1px solid var(--line-dark); }
  .stage-list li { display: grid; grid-template-columns: 110px minmax(0, .75fr) minmax(0, 1.25fr); gap: clamp(20px, 3vw, 48px); align-items: start; padding-block: 28px; border-bottom: 1px solid var(--line-dark); }
  .stage-number { color: transparent; -webkit-text-stroke: 1px var(--gold); font-family: var(--display); font-size: 96px; line-height: .8; letter-spacing: -.05em; }
  .stage-list h3 { font-size: clamp(32px, 3.8vw, 62px); line-height: 1; letter-spacing: -.025em; }
  .stage-list p { max-width: 58ch; color: var(--on-dark); font-size: 14px; line-height: 1.85; }
  .approach-closing { max-width: 30ch; margin: 36px 0 0 auto; color: var(--gold); font-family: var(--display); font-size: clamp(28px, 3.4vw, 52px); font-style: italic; line-height: 1.15; letter-spacing: -.02em; }
  .experience { background: var(--paper-deep); }
  .experience-heading, .together-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: end; }
  .experience h2 { max-width: 9ch; }
  .experience-heading .lead, .together-heading .lead { max-width: 32ch; }
  .experience-story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); margin-top: clamp(36px, 5vw, 72px); }
  .work-experience { border-top: 1px solid var(--charcoal); }
  .work-experience p { padding-block: 22px; border-bottom: 1px solid var(--line); color: var(--body); font-size: 15px; line-height: 1.85; }
  .experience-reflection { padding-top: 22px; border-top: 1px solid var(--charcoal); }
  .reading-copy .reflection-line { margin-top: 28px; color: var(--charcoal); font-family: var(--display); font-size: clamp(28px, 2.8vw, 42px); line-height: 1.2; letter-spacing: -.02em; }
  .editorial-link { display: inline-flex; align-items: center; min-height: 48px; margin-top: 28px; padding-bottom: 4px; border-bottom: 1px solid currentColor; font-size: 13px; font-weight: 600; transition: color .2s ease; }
  .editorial-link:focus-visible { outline-color: var(--charcoal); }
  .together h2 { max-width: 10ch; }
  .together-copy { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); margin-top: clamp(36px, 5vw, 72px); padding-top: 32px; border-top: 1px solid var(--line); }
  .closing { padding-block: clamp(56px, 7vw, 112px) 0; background: var(--gold); color: var(--charcoal); }
  .closing h2 { max-width: 15ch; font-size: clamp(56px, 9.8vw, 170px); line-height: .88; letter-spacing: -.04em; }
  .closing-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); margin-top: clamp(36px, 5vw, 72px); padding-block: 32px 56px; border-top: 1px solid var(--charcoal); }
  .closing-grid > p { max-width: 56ch; font-size: 15px; line-height: 1.9; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: start; align-content: start; }
  .closing a:focus-visible { outline-color: var(--charcoal); }
  @media (hover: hover) { .editorial-link:hover { color: var(--about-accent); } }
  @media (max-width: 1000px) {
    .hero-composition { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 28px 32px; }
    h1 { font-size: clamp(52px, 6.8vw, 76px); }
    .biography-grid, .approach-introduction { gap: 40px; }
    .stage-list li { grid-template-columns: 72px minmax(0, .7fr) minmax(0, 1.3fr); gap: 24px; }
    .stage-number { font-size: 72px; }
  }
  @media (max-width: 640px) {
    .hero-composition { grid-template-columns: 1fr; gap: 28px; }
    .hero-heading { grid-column: 1; grid-row: 1; }
    h1 { max-width: 15ch; font-size: clamp(52px, 13.2vw, 78px); margin-top: 22px; }
    .hero-portrait { grid-column: 1; grid-row: 2; width: min(88%, 360px); justify-self: end; }
    .hero-opening { grid-column: 1; grid-row: 3; max-width: none; }
    .intro-detail-grid, .biography-grid, .approach-introduction, .experience-heading, .experience-story, .together-heading, .together-copy, .closing-grid { grid-template-columns: 1fr; gap: 28px; }
    h2 { font-size: clamp(46px, 11.5vw, 68px); }
    .section-number { margin-bottom: 18px; }
    .stage-list li { grid-template-columns: 52px minmax(0, 1fr); gap: 18px; padding-block: 24px; }
    .stage-number { font-size: 60px; }
    .stage-list p { grid-column: 1 / -1; }
    .stage-list h3 { font-size: 36px; }
    .approach-closing { margin-left: 0; }
    .closing h2 { font-size: clamp(52px, 12.5vw, 76px); }
    .closing-actions { flex-direction: column; align-items: stretch; }
    .closing-actions .btn { width: 100%; }
  }
</style>
